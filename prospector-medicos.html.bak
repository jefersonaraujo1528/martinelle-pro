// =============================================================
// STATE
// =============================================================
const LS_DOCS = 'martinelle_v3_doctors';
const LS_CFG = 'martinelle_v3_config';
const LS_INIT = 'martinelle_v3_initialized';

let doctors = [];
let config = {
  days: ['Terça','Quarta','Quinta'],
  limitPerDay: 15,
  lastRedistribute: null
};
let currentView = 'today';
let activeFilters = {};
let activeGroupChip = 'todos';

// Import state
let impStep = 1, impRaw = [], impHeaders = [], impMapping = {}, impParsed = [];

// =============================================================
// INIT & PERSISTENCE
// =============================================================
function loadState(){
  const saved = localStorage.getItem(LS_DOCS);
  const cfg = localStorage.getItem(LS_CFG);
  const init = localStorage.getItem(LS_INIT);
  if(cfg){ try{ config = {...config, ...JSON.parse(cfg)}; }catch(e){} }
  if(saved){
    try{ doctors = JSON.parse(saved); }catch(e){ doctors = []; }
  }
  if(!init || !doctors.length){
    doctors = JSON.parse(JSON.stringify(INITIAL_DOCTORS));
    localStorage.setItem(LS_INIT,'1');
    autoDistribute();
    save();
  }
  // Migração: campos novos
  doctors.forEach(d => {
    if(d.status === 'Recusou') d.status = 'Perdido';
    if(d.followUpDate === undefined) d.followUpDate = '';
    if(d.followUpReason === undefined) d.followUpReason = '';
    if(d.package === undefined) d.package = '';
    if(d.value === undefined) d.value = 0;
    if(d.closedAt === undefined) d.closedAt = '';
    if(d.callAttempts === undefined) d.callAttempts = 0;
    if(d.lastCallDate === undefined) d.lastCallDate = '';
    // Campos estratégicos
    if(!d.visits) d.visits = [];
    if(d.personality === undefined) d.personality = '';
    if(d.motivation === undefined) d.motivation = '';
    if(d.decisionMaker === undefined) d.decisionMaker = 'só médico';
    if(d.referredBy === undefined) d.referredBy = '';
    if(d.hasExclusivity === undefined) d.hasExclusivity = false;
    if(d.diagScore === undefined) d.diagScore = '';
    if(d.diagNotes === undefined) d.diagNotes = '';
    if(d.secretaryChannel === undefined) d.secretaryChannel = '';
    if(d.secretaryReceptivity === undefined) d.secretaryReceptivity = '';
    if(d.secretaryNotes === undefined) d.secretaryNotes = '';
    if(d.nextObjective === undefined) d.nextObjective = '';
    if(d.followUpCycle === undefined) d.followUpCycle = '';
    // Campo view fields
    if(d._called === undefined) d._called = false;
    if(d._needsSchedule === undefined) d._needsSchedule = false;
    if(d._quality === undefined) d._quality = '';
    // Migração: unifica scheduledDay legado em days[]
    if(!Array.isArray(d.days)) d.days = [];
    if(d.scheduledDay && !d.days.includes(d.scheduledDay)) d.days.push(d.scheduledDay);
  });
  // Dedupe automático na carga: nomes iguais (normalizados) → mescla mantendo o mais completo
  dedupeDoctors(true);
}

// Normaliza nome para comparação: minúsculas, sem acentos, sem títulos, sem pontuação extra
function normalizeName(name){
  if(!name) return '';
  return String(name)
    .normalize('NFD').replace(/[̀-ͯ]/g,'')
    .toLowerCase()
    .replace(/\b(dr|dra|doutor|doutora|sr|sra)\.?\s*/g,'')
    .replace(/[^a-z0-9\s]/g,' ')
    .replace(/\s+/g,' ')
    .trim();
}

// Score de completude (quantos campos preenchidos) — usado pra escolher qual registro manter
function completenessScore(d){
  let s = 0;
  ['phone1','phone2','address','clinic','specialty','secretary','arrive','window','alert','notes','positioning'].forEach(k=>{
    if(d[k] && d[k]!=='Desconhecido') s++;
  });
  s += (d.days||[]).length;
  s += (d.visits||[]).length * 2;
  if(['Visitado','Fechado','Interessado','Proposta'].includes(d.status)) s += 3;
  return s;
}

// Mescla campos vazios de "into" usando "from"
function mergeDoctor(into, from){
  ['phone1','phone2','address','clinic','specialty','secretary','arrive','window','alert','notes','instagram','site','gmn','motivation','personality'].forEach(k=>{
    if((!into[k] || into[k]==='Desconhecido') && from[k]) into[k] = from[k];
  });
  // Dias: união
  const allDays = new Set([...(into.days||[]),...(from.days||[])]);
  into.days = [...allDays];
  // Visitas: concatena
  if((from.visits||[]).length){
    into.visits = [...(into.visits||[]),...from.visits];
  }
  // Positioning: prioriza "Sem" > "Básico" > "Bom" > "Desconhecido"
  const posRank = {'Sem':3,'Básico':2,'Bom':1,'Desconhecido':0};
  if((posRank[from.positioning]||0) > (posRank[into.positioning]||0)) into.positioning = from.positioning;
  // Status: se um foi visitado/fechado, prevalece
  const statRank = {'Fechado':5,'Proposta':4,'Interessado':3,'Visitado':2,'Pendente':1,'Perdido':0};
  if((statRank[from.status]||0) > (statRank[into.status]||0)) into.status = from.status;
  return into;
}

function dedupeDoctors(silent){
  const seen = new Map(); // chave normalizada → médico mantido
  const removed = [];
  const kept = [];
  doctors.forEach(d => {
    const key = normalizeName(d.name);
    if(!key){ kept.push(d); return; }
    if(seen.has(key)){
      const existing = seen.get(key);
      // Mantém o mais completo
      if(completenessScore(d) > completenessScore(existing)){
        // Substitui: novo vira o principal, mescla campos do antigo
        mergeDoctor(d, existing);
        const idx = kept.indexOf(existing);
        if(idx>=0) kept[idx] = d;
        removed.push(existing.name);
        seen.set(key, d);
      } else {
        mergeDoctor(existing, d);
        removed.push(d.name);
      }
    } else {
      seen.set(key, d);
      kept.push(d);
    }
  });
  if(removed.length){
    doctors = kept;
    if(!silent){
      save(); render();
      toast(`✅ ${removed.length} duplicado(s) mesclado(s)`, 'ok');
    }
  } else if(!silent){
    toast('Nenhum duplicado encontrado','ok');
  }
  return removed.length;
}
const LS_BACKUP_COUNT = 'martinelle_backup_count';
const BACKUP_THRESHOLD = 20;
function save(){
  localStorage.setItem(LS_DOCS, JSON.stringify(doctors));
  localStorage.setItem(LS_CFG, JSON.stringify(config));
  // Contador de mudanças desde último backup
  const n = (parseInt(localStorage.getItem(LS_BACKUP_COUNT)||'0',10)+1);
  localStorage.setItem(LS_BACKUP_COUNT, String(n));
  showSavedIndicator();
  updateBackupBanner();
  if(typeof autoSync === 'function') autoSync();
}
function showSavedIndicator(){
  const el = document.getElementById('savedIndicator');
  if(!el) return;
  el.classList.remove('saved-fade');
  void el.offsetWidth; // restart animation
  el.classList.add('saved-fade');
}
function updateBackupBanner(){
  const banner = document.getElementById('backupBanner');
  if(!banner) return;
  const n = parseInt(localStorage.getItem(LS_BACKUP_COUNT)||'0',10);
  if(n >= BACKUP_THRESHOLD){
    banner.classList.remove('hidden');
    document.getElementById('backupBannerCount').textContent = n;
  } else {
    banner.classList.add('hidden');
  }
}
function resetBackupCount(){
  localStorage.setItem(LS_BACKUP_COUNT, '0');
  updateBackupBanner();
}
function saveConfig(){
  config.limitPerDay = parseInt(document.getElementById('limitPerDay').value) || 15;
  save();
  toast('Configuração salva','ok');
}

// =============================================================
// GRUPO DO MÉDICO (visitar / ligar / incompleto)
// =============================================================
function getDocGroup(d){
  // "Visitar" = tem dia(s) agendado(s) E horário definido
  const hasDays = !!(d.days && d.days.length);
  const hasTime = !!(d.arrive || d.window);
  if(hasDays && hasTime) return 'visitar';
  // "Ligar" = tem telefone mas falta dia ou horário
  if(!!(d.phone1 || d.phone2)) return 'ligar';
  return 'incompleto';
}

// Completude: [endereço, horário, telefone, secretária, dia agendado]
function completenessFor(d){
  return [
    { label:'📍 Endereço', ok: !!(d.address && d.address.trim()) },
    { label:'⏰ Horário',  ok: !!(d.arrive || d.window) },
    { label:'📞 Telefone', ok: !!(d.phone1 || d.phone2) },
    { label:'👤 Secretária', ok: !!(d.secretary && d.secretary.trim()) },
    { label:'🗓️ Dia agendado', ok: !!(d.days && d.days.length) },
  ];
}

function completenessDotsHTML(d){
  const fields = completenessFor(d);
  const dots = fields.map(f => `<div class="comp-dot ${f.ok?'ok':'miss'}" title="${f.label}${f.ok?' ✓':' — faltando'}"></div>`).join('');
  const score = fields.filter(f => f.ok).length;
  const cls = score >= 4 ? 'ok' : score >= 2 ? 'warn' : 'miss';
  return `<div class="comp-dots">${dots}<span class="comp-label" style="color:${score>=4?'var(--green)':score>=2?'var(--yellow)':'var(--red)'}">${score}/5</span></div>`;
}

// =============================================================
// DETECTAR BAIRRO/PRÉDIO
// =============================================================
function detectGroup(addr){
  if(!addr) return 'Outros';
  const a = addr.toLowerCase();
  if(a.includes('diamond center') || a.includes('universitária, 750') || a.includes('universitaria, 750')) return 'Diamond Center';
  if(a.includes('manhattan river') || a.includes('arêa leão') || a.includes('area leao')) return 'Manhattan River';
  if(a.includes('office tower')) return 'The Office Tower';
  if(a.includes('dirceu arcoverde') || a.includes('pires de castro')) return 'Dirceu Arcoverde';
  if(a.includes('san vitta') || a.includes('joca píres') || a.includes('joca pires') || a.includes('ininga')) return 'Ininga';
  if(a.includes('fátima') || a.includes('fatima') || a.includes('lindolfo monteiro')) return 'Fátima';
  if(a.includes('jóquei') || a.includes('joquei') || a.includes('raul lopes') || a.includes('joca vieira')) return 'Jóquei';
  if(a.includes('alecrim') || a.includes('centro norte') || a.includes('coelho rodrigues')) return 'Centro';
  if(a.includes('tersandro paz') || a.includes('olavo bilac') || a.includes('parnaíba') || a.includes('parnaiba')) return 'Centro';
  if(a.includes('homero castelo') || a.includes('elias joão tajra') || a.includes('elias joao tajra')) return 'Zona Leste';
  return 'Outros';
}

// =============================================================
// AUTO-DISTRIBUTION
// =============================================================
function scoreDoctor(d){
  let s = 0;
  if(d.positioning === 'Sem') s += 100;
  else if(d.positioning === 'Desconhecido') s += 30;
  else if(d.positioning === 'Básico') s += 20;
  if(/IR PRIMEIRO|🔴/i.test(d.alert||'')) s += 50;
  if(d.phone1) s += 10;
  if(d.secretary) s += 5;
  return s;
}

function arriveMinutes(d){
  if(!d.arrive) return 9999;
  const m = d.arrive.match(/(\d{1,2}):(\d{2})/);
  if(!m) return 9999;
  return parseInt(m[1])*60 + parseInt(m[2]);
}

function autoDistribute(){
  const days = config.days;
  const limit = config.limitPerDay;
  // Só distribui quem ainda não tem dia. Não mexe em quem já tem days[]
  const pending = doctors.filter(d => d.status === 'Pendente' && d.address && (!d.days || !d.days.length));
  pending.sort((a,b) => scoreDoctor(b) - scoreDoctor(a));

  // Conta o que já está agendado
  const counters = Object.fromEntries(days.map(d => [d,0]));
  const scheduled = Object.fromEntries(days.map(d => [d,[]]));
  doctors.forEach(d => {
    (d.days||[]).forEach(day => {
      if(counters[day] !== undefined){ counters[day]++; scheduled[day].push(d); }
    });
  });

  // Distribui pendentes nos dias com menos visitas
  pending.forEach(d => {
    const dayList = [...days].sort((a,b) => counters[a] - counters[b]);
    for(const day of dayList){
      if(counters[day] < limit){
        d.days = [day];
        d._autoDay = day;
        scheduled[day].push(d);
        counters[day]++;
        break;
      }
    }
  });

  // Reordena cada dia por GRUPO (bairro/prédio) + horário
  days.forEach(day => {
    const list = scheduled[day];
    // Agrupa por bairro
    const groups = {};
    list.forEach(d => {
      const g = detectGroup(d.address);
      if(!groups[g]) groups[g] = [];
      groups[g].push(d);
    });
    // Ordena cada grupo por horário
    for(const g in groups){
      groups[g].sort((a,b) => arriveMinutes(a) - arriveMinutes(b));
    }
    // Ordem de grupos: maior primeiro (aproveita concentração)
    const groupOrder = Object.keys(groups).sort((a,b) => groups[b].length - groups[a].length);
    let order = 1;
    groupOrder.forEach(g => {
      groups[g].forEach(d => { d.scheduledOrder = order++; });
    });
  });

  config.lastRedistribute = new Date().toISOString();
  save();
}

function redistributeSchedule(){
  if(confirm('Redistribuir automaticamente todos os pendentes entre os dias de prospecção?')){
    autoDistribute();
    render();
    toast('Agenda redistribuída','ok');
  }
}

function clearSchedule(){
  const auto = doctors.filter(d => d._autoDay && (d.days||[]).includes(d._autoDay)).length;
  const manual = doctors.filter(d => (d.days||[]).length && !d._autoDay).length;
  const choice = confirm(
    `Limpar agenda?\n\n` +
    `• ${auto} foram auto-distribuídos (serão removidos)\n` +
    `• ${manual} você marcou manualmente (serão preservados)\n\n` +
    `OK = limpar só auto-distribuídos\nCancelar = não fazer nada`
  );
  if(!choice) return;
  doctors.forEach(d => {
    if(d._autoDay && Array.isArray(d.days)){
      d.days = d.days.filter(x => x !== d._autoDay);
      d._autoDay = null;
      d.scheduledOrder = null;
    }
  });
  save(); render();
  toast(`Agenda limpa: ${auto} removidos, ${manual} preservados`,'ok');
}

// =============================================================
// RENDER TUDO
// =============================================================
const DAY_NAMES = ['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'];

function todayName(){
  return DAY_NAMES[new Date().getDay()];
}

function render(){
  updateSideBadges();
  updateSpecialtyOptions();
  updateStats();
  renderToday();
  renderTable();
  renderPipeline();
  renderFunnel();
  renderFollowUps();
  renderAgenda();
  renderAlerts();
  renderConfig();
  if(currentView === 'recusaram') renderDeclined();
}

function updateSideBadges(){
  const t = todayName();
  const today = doctors.filter(d => (d.days||[]).includes(t) && d.status === 'Pendente').length;
  document.getElementById('sideToday').textContent = today;
  document.getElementById('sideTotal').textContent = doctors.length;
  document.getElementById('sideAlerts').textContent = getAlerts().length;
  document.getElementById('sidePipeline').textContent = doctors.filter(d => ['Interessado','Proposta'].includes(d.status)).length;
  document.getElementById('sideFollow').textContent = getFollowUps().length;
  document.getElementById('sideDeclined').textContent = doctors.filter(d => d.status === 'Perdido').length;
  // Chip counts
  const grpCounts = {todos:doctors.length, visitar:0, ligar:0, incompleto:0};
  doctors.forEach(d => { grpCounts[getDocGroup(d)]++; });
  document.getElementById('chipTodos').textContent = grpCounts.todos;
  document.getElementById('chipVisitar').textContent = grpCounts.visitar;
  document.getElementById('chipLigar').textContent = grpCounts.ligar;
  document.getElementById('chipIncompleto').textContent = grpCounts.incompleto;
  document.getElementById('chipSemHorario').textContent = doctors.filter(d => (d.days||[]).length && !d.arrive).length;
}

function setGroupChip(grp){
  activeGroupChip = grp;
  document.querySelectorAll('.gchip').forEach(c => c.classList.toggle('active', c.dataset.grp === grp));
  renderTable();
}

function updateSpecialtyOptions(){
  const specs = [...new Set(doctors.map(d => d.specialty).filter(Boolean))].sort();
  const sel = document.getElementById('fSpec');
  const cur = sel.value;
  sel.innerHTML = '<option value="">Todas especialidades</option>' +
    specs.map(s => `<option value="${esc(s)}"${cur===s?' selected':''}>${esc(s)}</option>`).join('');
}

function updateStats(){
  document.getElementById('statTotal').textContent = doctors.length;
  document.getElementById('statSem').textContent = doctors.filter(d => d.positioning === 'Sem').length;
  document.getElementById('statPend').textContent = doctors.filter(d => d.status === 'Pendente').length;
  document.getElementById('statVisit').textContent = doctors.filter(d => d.status === 'Visitado').length;
}

// =============================================================
// VIEW SWITCHING
// =============================================================
function goView(v){
  currentView = v;
  document.querySelectorAll('.nav-item').forEach(n => n.classList.toggle('active', n.dataset.view === v));
  ['today','medicos','pipeline','funil','followup','agenda','campo','alertas','config','recusaram'].forEach(x => {
    document.getElementById('view-'+x).classList.toggle('hidden', x !== v);
  });
  if(v === 'campo') renderCampo(); else if(v === 'recusaram') renderDeclined(); else render();
}

// Temperatura derivada da última visita
function lastVisitTemp(d){
  if(!d.visits || !d.visits.length) return '';
  return d.visits[d.visits.length-1].temperature || '';
}
function tempHTML(t){
  const map = {frio:'❄️ Frio',morno:'🌤️ Morno',quente:'🔥 Quente'};
  const cls = {frio:'temp-frio',morno:'temp-morno',quente:'temp-quente'};
  if(!t || !map[t]) return '';
  return `<span class="temp-badge ${cls[t]}">${map[t]}</span>`;
}
const OBJ_LABELS = {mapear:'🔍 Mapear',despertar:'💡 Despertar',agendar:'📅 Agendar',fechar:'💼 Fechar',manter:'🤝 Manter'};
function objHTML(o){ return o ? `<span class="obj-badge">${OBJ_LABELS[o]||o}</span>` : ''; }

// =============================================================
// RENDER HOJE
// =============================================================
let _todayTab = 'visitar'; // 'visitar' | 'ligar'
function todaySetTab(tab){
  _todayTab = tab;
  document.getElementById('todayTabVisitar').classList.toggle('active', tab === 'visitar');
  document.getElementById('todayTabLigar').classList.toggle('active', tab === 'ligar');
  renderToday();
}

function renderToday(){
  const t = todayName();
  const dateLbl = new Date().toLocaleDateString('pt-BR',{weekday:'long',day:'numeric',month:'long'});
  document.getElementById('todayDate').textContent = dateLbl;

  const list = doctors.filter(d => (d.days||[]).includes(t) && d.status !== 'Perdido');
  const withTime = list.filter(d => d.arrive).sort((a,b) => parseTimeMin(a.arrive) - parseTimeMin(b.arrive));
  const noTime   = list.filter(d => !d.arrive).sort((a,b) => a.name.localeCompare(b.name));
  const done     = list.filter(d => ['Visitado','Fechado'].includes(d.status)).length;
  const prior    = list.filter(d => d.positioning === 'Sem').length;

  document.getElementById('todayPending').textContent = withTime.length;
  document.getElementById('todayCall').textContent    = noTime.length;
  document.getElementById('todayDone').textContent    = done;
  document.getElementById('todayPrior').textContent   = prior;
  document.getElementById('todayChipVisitar').textContent = withTime.length;
  document.getElementById('todayChipLigar').textContent   = noTime.length;

  const sub = !config.days.includes(t)
    ? `Hoje não é dia de prospecção (${config.days.join(' / ')}).`
    : list.length ? `${list.length} médicos programados para hoje` : 'Nenhum médico agendado para hoje.';
  document.getElementById('todaySub').textContent = sub;

  const container = document.getElementById('todayList');

  if(!list.length){
    container.innerHTML = `<div class="empty">
      <div class="empty-icon">${config.days.includes(t)?'📭':'🌴'}</div>
      <div>${!config.days.includes(t) ? `Hoje é ${t}. Seus dias de prospecção são: <strong>${config.days.join(', ')}</strong>.` : 'Nenhum médico programado para hoje.'}<br>
      <button class="btn btn-primary" style="margin-top:14px" onclick="goView('agenda')">📅 Ver agenda completa</button></div>
    </div>`;
    return;
  }

  // TAB: LIGAR
  if(_todayTab === 'ligar'){
    if(!noTime.length){
      container.innerHTML = `<div class="empty"><div class="empty-icon">✅</div><div>Todos os médicos de hoje já têm horário definido.<br>Nada para ligar agora.</div></div>`;
      return;
    }
    container.innerHTML = `<div class="today-section-warn">
      <div class="today-section-title">📞 LIGAR PARA CONFIRMAR HORÁRIO (${noTime.length})</div>
      <div class="today-section-sub">Esses médicos ainda não têm horário — ligue para confirmar antes de sair</div>
      ${noTime.map(d => renderMedCard(d, t)).join('')}
    </div>`;
    return;
  }

  // TAB: VISITAR
  let html = '';
  if(!withTime.length && noTime.length){
    html = `<div class="today-section-warn">
      <div class="today-section-title">⚠️ Nenhum médico com horário definido hoje</div>
      <div class="today-section-sub">Vá para a aba 📞 Para Ligar e confirme os horários</div>
    </div>`;
    container.innerHTML = html;
    return;
  }
  if(withTime.length){
    html += `<div class="today-section-ok">
      <div class="today-section-title">🏃 ROTA DE HOJE (${withTime.length}) — por horário de chegada</div>`;
    let lastGroup = '';
    withTime.forEach(d => {
      const g = detectGroup(d.address);
      if(g !== lastGroup){
        html += `<div class="group-label">📍 ${esc(g)}</div>`;
        lastGroup = g;
      }
      html += renderMedCard(d, t);
    });
    html += `</div>`;
  }
  container.innerHTML = html;
}

function renderMedCard(d, currentDay){
  const done = ['Visitado','Fechado','Perdido'].includes(d.status);
  const alertClass = /🔴|agendar|ir primeiro/i.test(d.alert||'') ? '' : /⚠️/.test(d.alert||'') ? 'warn' : 'info';
  const temp = lastVisitTemp(d);
  const visitsCount = (d.visits||[]).length;
  const lastV = visitsCount ? d.visits[d.visits.length-1] : null;
  const secRec = d.secretaryReceptivity ? `· Secretária: ${'⭐'.repeat(parseInt(d.secretaryReceptivity))}` : '';
  const isSel = selectedIds.has(d.id);
  const selCb = selectMode ? `<label class="sel-cb-wrap" onclick="event.stopPropagation()"><input type="checkbox" ${isSel?'checked':''} onchange="toggleSelect('${d.id}',event)"></label>` : '';
  const otherDays = (d.days||[]).filter(x => x !== currentDay);
  return `<div class="med-card ${done?'visited':''} ${selectMode?'sel-active':''} ${isSel?'sel-on':''}" ${selectMode?`onclick="toggleSelect('${d.id}',event)"`:''}  style="${selectMode?'padding-left:38px':''}">
    ${selCb}
    <div class="med-head">
      <div class="med-main">
        <div>
          <span class="med-name">${esc(d.name)}</span>
          ${otherDays.length?`<span class="tl-tag" style="margin-left:6px">📅 também ${esc(otherDays.join(' + '))}</span>`:''}
        </div>
        <div class="med-sub">${esc(d.specialty||'—')} · ${esc(d.clinic||'—')}</div>
        <div style="display:flex;gap:5px;flex-wrap:wrap;margin-top:5px">
          ${tempHTML(temp)}
          ${objHTML(d.nextObjective)}
          ${visitsCount?`<span class="tl-tag">📋 ${visitsCount} visita${visitsCount>1?'s':''}</span>`:''}
          ${d.diagScore?`<span class="tl-tag">🔍 Score ${d.diagScore}/10</span>`:''}
        </div>
      </div>
      ${d.arrive
        ? `<div class="med-time"><strong>${esc(d.arrive)}</strong>${d.window?`<div>${esc(d.window)}</div>`:''}</div>`
        : `<button class="ag-set-time" onclick="event.stopPropagation();quickSetTime('${d.id}')" title="Definir horário rápido">⏰ Sem horário</button>`}
    </div>
    <div class="med-info">
      ${d.address?`<div class="info-item"><span class="info-icon">📍</span><span>${esc(d.address)}</span></div>`:''}
      ${d.secretary?`<div class="info-item"><span class="info-icon">👤</span><span>Secretária: <strong>${esc(d.secretary)}</strong> ${secRec}</span></div>`:''}
      ${d.phone1?`<div class="info-item"><span class="info-icon">📞</span><span>${esc(d.phone1)}</span></div>`:''}
      ${d.motivation?`<div class="info-item"><span class="info-icon">💡</span><span style="color:var(--yellow)">Dor: ${esc(d.motivation)}</span></div>`:''}
      ${d.positioning==='Sem'?`<div class="info-item"><span class="info-icon">🎯</span><span style="color:var(--pink);font-weight:600">Sem posicionamento — PRIORIDADE</span></div>`:''}
    </div>
    ${lastV?`<div class="med-alert info" style="font-size:11px">📋 Última visita (${new Date(lastV.date+'T00:00:00').toLocaleDateString('pt-BR')}): ${esc((lastV.whatHappened||'').slice(0,90))}${(lastV.whatHappened||'').length>90?'…':''}</div>`:''}
    ${d.alert?`<div class="med-alert ${alertClass}">💡 ${esc(d.alert)}</div>`:''}
    <div class="med-actions">
      ${d.status !== 'Perdido'
        ? `<button class="btn btn-sm btn-primary" onclick="openVisitLog('${d.id}')">📝 Log</button>`
        : `<button class="btn btn-sm btn-ghost" style="color:var(--green);border-color:var(--green)" onclick="reactivateDoctor('${d.id}')">↩️ Reativar</button>`}
      ${visitsCount?`<button class="btn btn-sm btn-ghost" onclick="openHistory('${d.id}')">📋 Histórico (${visitsCount})</button>`:''}
      ${(d.phone1||d.phone2)?`<button class="btn btn-sm btn-wa" onclick="openWA('${d.phone2||d.phone1}')">💬</button>`:''}
      ${d.address?`<button class="btn btn-sm btn-ghost" onclick="quickRoute('${d.id}')">🗺️</button>`:''}
      <button class="btn btn-sm btn-ghost" onclick="openForm('${d.id}')">✏️</button>
      ${d.status !== 'Perdido'?`<button class="btn btn-sm btn-danger" onclick="markDeclined('${d.id}')" title="Marcar como Não Aceitou">🚫 Não Aceitou</button>`:''}
      <button class="btn btn-sm btn-danger" onclick="delDoctor('${d.id}')" title="Excluir médico">🗑 Excluir</button>
    </div>
  </div>`;
}

function markVisited(id){ openVisitLog(id); }
function unmarkVisited(id){
  const d = doctors.find(x => x.id === id);
  if(d){ d.status = 'Pendente'; save(); render(); }
}

// =============================================================
// RENDER MÉDICOS TABLE
// =============================================================
function setFilter(f){
  goView('medicos');
  activeGroupChip = 'todos';
  document.querySelectorAll('.gchip').forEach(c => c.classList.toggle('active', c.dataset.grp === 'todos'));
  document.getElementById('search').value = '';
  document.getElementById('fSpec').value = '';
  document.getElementById('fStatus').value = f.status || '';
  document.getElementById('fPos').value = f.positioning || '';
  renderTable();
}

function renderTable(){
  const search = document.getElementById('search').value.toLowerCase();
  const spec = document.getElementById('fSpec').value;
  const status = document.getElementById('fStatus').value;
  const pos = document.getElementById('fPos').value;

  let list = doctors.filter(d => {
    if(activeGroupChip === 'semHorario'){ if(!((d.days||[]).length && !d.arrive)) return false; }
    else if(activeGroupChip !== 'todos' && getDocGroup(d) !== activeGroupChip) return false;
    if(spec && d.specialty !== spec) return false;
    if(status && d.status !== status) return false;
    if(pos && d.positioning !== pos) return false;
    if(search){
      const s = (d.name+' '+d.clinic+' '+d.secretary+' '+d.specialty+' '+(d.phone1||'')).toLowerCase();
      if(!s.includes(search)) return false;
    }
    return true;
  });

  // Ordena: Sem posicionamento primeiro, depois por score de completude desc, depois alfabético
  list.sort((a,b) => {
    if(a.positioning === 'Sem' && b.positioning !== 'Sem') return -1;
    if(b.positioning === 'Sem' && a.positioning !== 'Sem') return 1;
    const sa = completenessFor(a).filter(f=>f.ok).length;
    const sb = completenessFor(b).filter(f=>f.ok).length;
    if(sa !== sb) return sb - sa;
    return a.name.localeCompare(b.name);
  });

  const tbody = document.getElementById('tblBody');
  const empty = document.getElementById('tblEmpty');
  if(!list.length){ tbody.innerHTML = ''; empty.classList.remove('hidden'); return; }
  empty.classList.add('hidden');

  tbody.innerHTML = list.map(d => {
    const grp = getDocGroup(d);
    const posCls = {'Sem':'b-pos-sem','Básico':'b-pos-bas','Bom':'b-pos-bom','Desconhecido':'b-pos-desc'}[d.positioning]||'b-pos-desc';
    const statCls = {'Pendente':'b-pend','Visitado':'b-visited','Interessado':'b-pos-bas','Proposta':'b-pos-bas','Fechado':'b-closed','Perdido':'b-declined'}[d.status]||'b-pend';
    const trClass = d.positioning==='Sem' ? 'sem-pos' : grp==='incompleto' ? 'warn' : '';

    // Indicador de grupo
    const grpIcon = grp==='visitar' ? '<span title="Para visitar" style="color:var(--green)">🏃</span>' :
                    grp==='ligar'   ? '<span title="Para ligar" style="color:var(--accent)">📞</span>' :
                                      '<span title="Incompleto" style="color:var(--yellow)">⚠️</span>';

    // Tentativas de ligação (só para grupo ligar)
    const callAttemptsCls = d.callAttempts >= 4 ? 'many' : d.callAttempts >= 2 ? 'hot' : '';
    const callInfo = grp === 'ligar' ? `
      <div style="margin-top:5px;display:flex;align-items:center;gap:5px;flex-wrap:wrap">
        ${d.callAttempts ? `<span class="call-badge ${callAttemptsCls}">📞 ${d.callAttempts}x${d.lastCallDate?' · '+new Date(d.lastCallDate+'T00:00:00').toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit'}):''}</span>` : ''}
        <button class="btn-call" onclick="event.stopPropagation();callAttempt('${d.id}')" title="Registrar tentativa de ligação">+1 ligação</button>
      </div>` : '';

    const isSel = selectedIds.has(d.id);
    return `<tr class="${trClass} ${isSel?'sel-on':''}">
      ${selectMode?`<td style="width:36px"><input type="checkbox" style="accent-color:var(--accent);width:15px;height:15px;cursor:pointer" ${isSel?'checked':''} onchange="toggleSelect('${d.id}',event)"></td>`:''}
      <td><div style="display:flex;align-items:center;gap:6px">${grpIcon}<strong>${esc(d.name)}</strong></div>${callInfo}</td>
      <td><span class="spec">${esc(d.specialty||'—')}</span></td>
      <td>${esc(d.clinic||'—')}<br><small style="color:var(--muted)">${esc(detectGroup(d.address))}</small></td>
      <td>${esc(d.secretary||'—')}</td>
      <td style="font-size:12px">${esc(d.phone1||d.phone2||'—')}</td>
      <td><span class="badge ${statCls}">${esc(d.status)}</span></td>
      <td><span class="badge ${posCls}">${esc(d.positioning)}</span></td>
      <td>
        ${tempHTML(lastVisitTemp(d))}
        ${objHTML(d.nextObjective)}
        <div style="font-size:10px;color:var(--muted);margin-top:3px">${(d.visits||[]).length ? `📋 ${d.visits.length}v` : 'sem visitas'}</div>
      </td>
      <td>${completenessDotsHTML(d)}</td>
      <td>
        ${d.status !== 'Perdido'
          ? `<button class="btn btn-sm btn-primary btn-icon" onclick="openVisitLog('${d.id}')" title="Log de visita">📝</button>`
          : `<button class="btn btn-sm btn-ghost btn-icon" style="color:var(--green)" onclick="reactivateDoctor('${d.id}')" title="Reativar">↩️</button>`}
        ${(d.visits||[]).length?`<button class="btn btn-sm btn-ghost btn-icon" onclick="openHistory('${d.id}')" title="Histórico">📋</button>`:''}
        ${(d.phone1||d.phone2)?`<button class="btn btn-sm btn-wa btn-icon" onclick="openWA('${d.phone2||d.phone1}')" title="WhatsApp">💬</button>`:''}
        <button class="btn btn-sm btn-ghost btn-icon" onclick="openForm('${d.id}')" title="Editar">✏️</button>
        ${d.status !== 'Perdido'?`<button class="btn btn-sm btn-danger btn-icon" onclick="markDeclined('${d.id}')" title="Não Aceitou">🚫</button>`:''}
        <button class="btn btn-sm btn-danger btn-icon" onclick="delDoctor('${d.id}')" title="Remover">🗑</button>
      </td>
    </tr>`;
  }).join('');
}

function callAttempt(id){
  const d = doctors.find(x => x.id === id);
  if(!d) return;
  d.callAttempts = (d.callAttempts||0) + 1;
  d.lastCallDate = new Date().toISOString().slice(0,10);
  save(); renderTable(); updateSideBadges();
  toast(`${d.callAttempts}ª tentativa registrada`,'ok');
}

function delDoctor(id){
  if(!confirm('Remover este médico?')) return;
  doctors = doctors.filter(d => d.id !== id);
  save(); render(); toast('Médico removido','ok');
}

// =============================================================
// RENDER AGENDA
// =============================================================
function parseTimeMin(t){
  if(!t) return 9999;
  // "8h30", "8h", "08:30", "8.30", "8:30 - 12:00" — pega o primeiro horário
  const m1 = t.match(/(\d{1,2})\s*[h:\.]\s*(\d{2})/i);
  if(m1) return parseInt(m1[1])*60+parseInt(m1[2]);
  const m2 = t.match(/(\d{1,2})\s*h/i);
  if(m2) return parseInt(m2[1])*60;
  const m3 = t.match(/^(\d{1,2})$/);
  if(m3) return parseInt(m3[1])*60;
  return 9999;
}
function fmtTimeRange(list){
  const times = list.map(d=>parseTimeMin(d.arrive)).filter(t=>t<9999).sort((a,b)=>a-b);
  if(!times.length) return '';
  const fmt = m => { const hh=Math.floor(m/60); const mm=m%60; return mm?`${hh}:${String(mm).padStart(2,'0')}`:`${hh}h`; };
  return times.length===1 ? fmt(times[0]) : `${fmt(times[0])} → ${fmt(times[times.length-1])}`;
}

function renderAgendaCard(d, i, day, hasTime){
  const isPri  = d.positioning === 'Sem';
  const isDone = ['Visitado','Fechado','Interessado','Proposta'].includes(d.status);
  const grp    = detectGroup(d.address);
  const timeFirstPart = d.arrive ? d.arrive.split(/[–\-]/)[0].trim() : '';
  const tags = [];
  if(d.secretary) tags.push(`<span class="ag-tag ag-tag-sec">👤 ${esc(d.secretary)}</span>`);
  if(d.phone1)    tags.push(`<span class="ag-tag ag-tag-phone" onclick="event.stopPropagation();window.location.href='tel:${d.phone1.replace(/\D/g,'')}'">📞 ${esc(d.phone1)}</span>`);
  if(d.alert)     tags.push(`<span class="ag-tag ag-tag-alert">⚠️ ${esc(d.alert)}</span>`);
  const multiDays = (d.days||[]).length > 1 ? `<span class="ag-tag ag-tag-multi">📅 ${esc(d.days.join(' + '))}</span>` : '';
  if(multiDays) tags.push(multiDays);
  return `<div class="agenda-card${isPri?' ag-priority':''}${isDone?' ag-visitado':''}${hasTime?'':' ag-notime'}"
    draggable="true"
    ondragstart="event.dataTransfer.setData('text/plain','${d.id}');this.classList.add('dragging')"
    ondragend="this.classList.remove('dragging')"
    onclick="openForm('${d.id}')">
    <button class="agenda-remove" onclick="event.stopPropagation();removeFromDay('${d.id}','${day}')" title="Tirar de ${day}">×</button>
    <div class="agenda-num">${i+1}</div>
    <div style="position:absolute;top:6px;right:30px;display:flex;gap:4px">
      <button class="agenda-remove" style="background:rgba(239,71,111,.18);color:#ff9bb3" onclick="event.stopPropagation();markDeclined('${d.id}')" title="Recusou">🚫</button>
      <button class="agenda-remove" style="background:rgba(239,71,111,.18);color:#ff9bb3" onclick="event.stopPropagation();delDoctor('${d.id}')" title="Excluir">🗑</button>
    </div>
    <div class="agenda-card-body">
      <div class="agenda-card-row1">
        <div class="agenda-card-name">${esc(d.name)}${isPri?' 🎯':''}</div>
        <div class="ag-time-badge">
          ${hasTime
            ? `<span class="ag-time-big">${esc(timeFirstPart)}</span>${d.window?`<div class="ag-time-win">${esc(d.window)}</div>`:''}`
            : `<button class="ag-set-time" onclick="event.stopPropagation();quickSetTime('${d.id}')" title="Definir horário rápido">⏰ Sem horário</button>`}
        </div>
      </div>
      <div class="agenda-card-spec">${esc(d.specialty||'—')} · ${esc(grp)}</div>
      ${tags.length ? `<div class="agenda-card-tags">${tags.join('')}</div>` : ''}
    </div>
  </div>`;
}

function renderAgenda(){
  const grid = document.getElementById('agendaGrid');
  grid.innerHTML = '';
  config.days.forEach(day => {
    const all = doctors.filter(d => (d.days||[]).includes(day) && d.status !== 'Perdido');
    const withTime = all.filter(d => d.arrive);
    const noTime   = all.filter(d => !d.arrive);
    // Ordena por horário de chegada
    withTime.sort((a,b) => {
      const ta = parseTimeMin(a.arrive), tb = parseTimeMin(b.arrive);
      if(ta !== tb) return ta - tb;
      return (a.scheduledOrder||999)-(b.scheduledOrder||999);
    });
    noTime.sort((a,b) => a.name.localeCompare(b.name));

    const col = document.createElement('div');
    col.className = 'agenda-col';
    col.dataset.day = day;
    col.ondragover = e => { e.preventDefault(); col.classList.add('drop-target'); };
    col.ondragleave = () => col.classList.remove('drop-target');
    col.ondrop = e => {
      e.preventDefault(); col.classList.remove('drop-target');
      const id = e.dataTransfer.getData('text/plain');
      const d = doctors.find(x => x.id === id);
      if(d){
        if(!Array.isArray(d.days)) d.days = [];
        if(!d.days.includes(day)) d.days.push(day);
        save(); render();
      }
    };

    // Só entra em rota quem tem horário + endereço
    const routable = withTime.filter(d => d.address && !['Fechado','Perdido'].includes(d.status));
    const totalMin = withTime.length * 15;
    const timeEst = totalMin >= 60
      ? `~${Math.floor(totalMin/60)}h${totalMin%60?String(totalMin%60).padStart(2,'0'):''}` : `~${totalMin}min`;
    const range = fmtTimeRange(withTime);
    const isToday = day === todayName();

    col.innerHTML = `
      <div class="agenda-col-head">
        <div>
          <div class="agenda-col-day" style="${isToday?'color:var(--accent)':''}">${esc(day)}${isToday?' ⭐':''}</div>
          <div class="agenda-col-count">
            <span style="color:var(--green)">✓ ${withTime.length} c/ horário</span>
            ${noTime.length?`· <span style="color:var(--yellow)">⚠ ${noTime.length} s/ horário</span>`:''}
            · ⏱ ${timeEst}
          </div>
          ${all.length > config.limitPerDay ? `<div class="agenda-col-overload">🚨 ${all.length}/${config.limitPerDay} médicos — acima do limite!</div>` : ''}
          ${range ? `<div class="agenda-col-range">⏰ ${range}</div>` : ''}
        </div>
        <button class="btn-day-route" onclick="openRouteForDay('${day}')" ${!routable.length?'disabled':''} title="${routable.length} médicos com horário e endereço">🗺️ Rota</button>
      </div>
      <div class="agenda-col-body">
        ${noTime.length ? `
          <div class="ag-section-warn">
            <div class="ag-section-title">⚠️ LIGAR PARA CONFIRMAR HORÁRIO (${noTime.length})</div>
            <div class="ag-section-sub">Não entram na rota até ter horário</div>
            ${noTime.map((d,i) => renderAgendaCard(d, i, day, false)).join('')}
          </div>` : ''}
        ${withTime.length ? `
          <div class="ag-section-ok">
            <div class="ag-section-title">✅ ROTA DO DIA (${withTime.length})</div>
            ${withTime.map((d,i) => renderAgendaCard(d, i, day, true)).join('')}
          </div>` : ''}
        ${!all.length ? '<div class="agenda-empty">Sem médicos agendados<br><small>Arraste ou use Auto-distribuir</small></div>' : ''}
      </div>
    `;
    grid.appendChild(col);
  });
  const unsched = doctors.filter(d => (!d.days || !d.days.length) && d.status === 'Pendente');
  document.getElementById('unschedCount').textContent = unsched.length;
}

function removeFromDay(id, day){
  const d = doctors.find(x => x.id === id);
  if(!d) return;
  if(day && Array.isArray(d.days)){
    d.days = d.days.filter(x => x !== day);
  } else {
    d.days = [];
  }
  if(d._autoDay === day) d._autoDay = null;
  save(); render();
}

function showUnscheduled(){
  const list = doctors.filter(d => (!d.days || !d.days.length) && d.status === 'Pendente');
  if(!list.length) return alert('Todos os pendentes estão distribuídos!');
  const msg = list.slice(0,20).map(d => '• '+d.name).join('\n');
  alert(`${list.length} médicos sem dia definido:\n\n${msg}${list.length>20?'\n...':''}\n\nClique em "Redistribuir" para organizá-los.`);
}

// =============================================================
// RENDER ALERTAS
// =============================================================
function getAlerts(){
  const alerts = [];
  const today = new Date().toISOString().slice(0,10);
  doctors.forEach(d => {
    if(!d.phone1 && !d.phone2) alerts.push({id:d.id, name:d.name, msg:'Sem telefone cadastrado'});
    if(!d.address) alerts.push({id:d.id, name:d.name, msg:'Sem endereço (não vai gerar rota)'});
    if(!d.specialty) alerts.push({id:d.id, name:d.name, msg:'Sem especialidade'});
    if(d.status === 'Pendente' && d.positioning === 'Sem' && (!d.days || !d.days.length)) {
      alerts.push({id:d.id, name:d.name, msg:'🎯 PRIORIDADE (Sem posicionamento) — sem dia agendado'});
    }
    if(d.followUpDate && d.followUpDate < today && !['Fechado','Perdido'].includes(d.status)){
      alerts.push({id:d.id, name:d.name, msg:`🔔 Follow-up ATRASADO desde ${new Date(d.followUpDate).toLocaleDateString('pt-BR')}`});
    }
    if(d.status === 'Visitado' && !d.followUpDate){
      alerts.push({id:d.id, name:d.name, msg:'⚠️ Visitado sem follow-up agendado'});
    }
  });
  return alerts;
}

function getFollowUps(){
  return doctors
    .filter(d => d.followUpDate && !['Fechado','Perdido'].includes(d.status))
    .sort((a,b) => a.followUpDate.localeCompare(b.followUpDate));
}

function renderAlerts(){
  const alerts = getAlerts();
  const tbody = document.getElementById('alertBody');
  const empty = document.getElementById('alertEmpty');
  if(!alerts.length){ tbody.innerHTML=''; empty.classList.remove('hidden'); return; }
  empty.classList.add('hidden');
  tbody.innerHTML = alerts.map(a => `<tr>
    <td><strong>${esc(a.name)}</strong></td>
    <td><span style="color:var(--yellow)">⚠️</span> ${esc(a.msg)}</td>
    <td><button class="btn btn-sm btn-ghost" onclick="openForm('${a.id}')">Corrigir</button></td>
  </tr>`).join('');
}

// =============================================================
// RENDER CONFIG
// =============================================================
function renderConfig(){
  const all = ['Segunda','Terça','Quarta','Quinta','Sexta','Sábado'];
  document.getElementById('dayToggles').innerHTML = all.map(d =>
    `<div class="day-toggle ${config.days.includes(d)?'on':''}" onclick="toggleDay('${d}')">${d}</div>`
  ).join('');
  document.getElementById('limitPerDay').value = config.limitPerDay;
}
function toggleDay(d){
  if(config.days.includes(d)) config.days = config.days.filter(x => x !== d);
  else config.days.push(d);
  save(); render();
  toast('Dias atualizados — clique em Redistribuir','ok');
}

function setFocusDays(){
  config.days = ['Terça','Quarta','Quinta'];
  save(); render();
  toast('🎯 Focado em Terça, Quarta e Quinta','ok');
}

function resetAll(){
  if(!confirm('⚠️ APAGAR TUDO e recomeçar com os dados iniciais?')) return;
  localStorage.removeItem(LS_DOCS);
  localStorage.removeItem(LS_CFG);
  localStorage.removeItem(LS_INIT);
  location.reload();
}

// =============================================================
// FORM MODAL
// =============================================================
let editingId = null;
function toggleExtras(btn){
  const el = document.getElementById('formExtras');
  el.classList.toggle('open');
  btn.textContent = el.classList.contains('open') ? '▼ Ocultar informações extras' : '▶ Mais informações (Instagram, GMN, etc.)';
}

function openForm(id=null){
  editingId = id;
  document.getElementById('formTitle').textContent = id ? 'Editar Médico' : 'Novo Médico';
  document.getElementById('medForm').reset();
  setDayChips([]);
  document.getElementById('formExtras').classList.remove('open');
  if(id){
    const d = doctors.find(x => x.id === id);
    if(!d) return;
    ['name','specialty','clinic','address','phone1','phone2','secretary','arrive','window','positioning','status','alert','instagram','gmn','site','crm','notes','followUpDate','followUpReason','followUpCycle','package','value','closedAt','nextObjective','personality','motivation','decisionMaker','referredBy','diagScore','diagNotes','secretaryChannel','secretaryReceptivity','secretaryNotes']
      .forEach(k => { const el = document.getElementById('f_'+k); if(el) el.value = d[k]||''; });
    const exEl = document.getElementById('f_hasExclusivity'); if(exEl) exEl.checked = !!d.hasExclusivity;
    setDayChips(d.days||[]);
    if(d.instagram||d.gmn||d.site||d.crm||d.notes||d.personality||d.motivation||d.decisionMaker||d.diagScore) toggleExtras(document.querySelector('.more-toggle'));
  }
  document.getElementById('formOverlay').classList.remove('hidden');
}
function closeForm(){ document.getElementById('formOverlay').classList.add('hidden'); editingId=null; }

document.getElementById('medForm').addEventListener('submit', e => {
  e.preventDefault();
  const getV = k => { const el=document.getElementById('f_'+k); return el?el.value.trim():''; };
  const getChk = k => { const el=document.getElementById('f_'+k); return el?el.checked:false; };
  const d = {
    id: editingId || 'd'+Date.now()+Math.random().toString(36).slice(2,5),
    name: getV('name'), specialty: getV('specialty'), clinic: getV('clinic'),
    address: getV('address'), phone1: getV('phone1'), phone2: getV('phone2'),
    secretary: getV('secretary'), arrive: getV('arrive'), window: getV('window'),
    positioning: getV('positioning'), status: getV('status'), alert: getV('alert'),
    instagram: getV('instagram'), gmn: getV('gmn'), site: getV('site'), crm: getV('crm'),
    notes: getV('notes'),
    followUpDate: getV('followUpDate'), followUpReason: getV('followUpReason'), followUpCycle: getV('followUpCycle'),
    package: getV('package'), value: parseFloat(getV('value'))||0, closedAt: getV('closedAt'),
    nextObjective: getV('nextObjective'),
    personality: getV('personality'), motivation: getV('motivation'),
    decisionMaker: getV('decisionMaker'), referredBy: getV('referredBy'),
    hasExclusivity: getChk('hasExclusivity'),
    diagScore: getV('diagScore'), diagNotes: getV('diagNotes'),
    secretaryChannel: getV('secretaryChannel'),
    secretaryReceptivity: getV('secretaryReceptivity'),
    secretaryNotes: getV('secretaryNotes'),
    days: getSelectedDays()
  };
  if(d.status === 'Fechado' && !d.closedAt) d.closedAt = new Date().toISOString().slice(0,10);
  if(editingId){
    const idx = doctors.findIndex(x => x.id === editingId);
    if(idx>=0){
      const old = doctors[idx];
      d.scheduledOrder = old.scheduledOrder;
      d._autoDay = old._autoDay;
      d.callAttempts = old.callAttempts || 0;
      d.lastCallDate = old.lastCallDate || '';
      d.visits = old.visits || [];
      doctors[idx] = d;
    }
  } else {
    d.callAttempts = 0;
    d.lastCallDate = '';
    d.visits = [];
    doctors.push(d);
  }
  save(); render(); closeForm(); toast(editingId?'Atualizado':'Médico adicionado','ok');
});

// =============================================================
// IMPORT EXCEL
// =============================================================
function openImport(){
  impStep = 1; impRaw = []; impHeaders = []; impMapping = {}; impParsed = [];
  document.getElementById('istep1').classList.remove('hidden');
  document.getElementById('istep2').classList.add('hidden');
  document.getElementById('istep3').classList.add('hidden');
  document.getElementById('impBack').classList.add('hidden');
  document.getElementById('impNext').classList.remove('hidden');
  document.getElementById('impNext').disabled = true;
  document.getElementById('impDone').classList.add('hidden');
  document.getElementById('fileInp').value = '';
  document.getElementById('dropTxt').textContent = 'Arraste sua planilha aqui';
  document.getElementById('dropZone').style.borderColor = '';
  updateSteps(1);
  document.getElementById('importOverlay').classList.remove('hidden');
}
function closeImport(){ document.getElementById('importOverlay').classList.add('hidden'); }

function updateSteps(s){
  [1,2,3].forEach(i => {
    const el = document.getElementById('st'+i);
    el.className = 'step' + (i===s?' active':i<s?' done':'');
  });
}

function dOver(e){e.preventDefault();document.getElementById('dropZone').classList.add('over')}
function dLeave(e){document.getElementById('dropZone').classList.remove('over')}
function dDrop(e){e.preventDefault();dLeave(e);const f=e.dataTransfer.files[0];if(f)procFile(f)}
function hFile(e){const f=e.target.files[0];if(f)procFile(f)}

// Detecta o dia da semana pelo nome da aba
function sheetNameToDay(sn){
  const u = sn.toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
  if(u.includes('TERCA') || u.includes('TERÇA')) return 'Terça';
  if(u.includes('QUARTA')) return 'Quarta';
  if(u.includes('QUINTA')) return 'Quinta';
  if(u.includes('SEXTA')) return 'Sexta';
  if(u.includes('SEGUNDA')) return 'Segunda';
  if(u.includes('SABADO') || u.includes('SÁBADO')) return 'Sábado';
  return '';
}

// Checa se uma linha é sub-cabeçalho (MANHÃ, TARDE, etc.)
function isSubHeader(row){
  const txt = row.map(c => String(c||'').trim()).join(' ').toLowerCase();
  if(!txt.trim()) return true;
  if(/^(manh[aã]|tarde|noite|per[ií]odo|turno|hor[aá]rio|\d+\s*$)/.test(txt.trim())) return true;
  // Linha onde 80%+ das células estão vazias e a 1ª célula não nula é texto de seção
  const nonEmpty = row.filter(c => String(c||'').trim()).length;
  if(nonEmpty <= 1 && /^(manh|tarde|noite|morn)/i.test(txt)) return true;
  return false;
}

function procFile(file){
  const reader = new FileReader();
  reader.onload = function(e){
    try{
      let rows = [];
      if(file.name.endsWith('.csv')){
        rows = e.target.result.split('\n').map(l => {
          const cells=[];let cur='';let inQ=false;
          for(const c of l){if(c==='"'){inQ=!inQ;continue}if(c===','&&!inQ){cells.push(cur.trim());cur=''}else cur+=c}
          cells.push(cur.trim());return cells;
        }).filter(r => r.some(c => c));
        if(rows.length){
          impHeaders = rows[0].map(h => String(h).trim());
          impRaw = rows.slice(1).filter(r => r.some(c => String(c).trim()));
        }
      } else {
        const data = new Uint8Array(e.target.result);
        const wb = XLSX.read(data,{type:'array'});

        // Descobre o dia para cada aba
        const sheetDays = {};
        wb.SheetNames.forEach(sn => { sheetDays[sn] = sheetNameToDay(sn); });
        const hasDays = Object.values(sheetDays).some(d => d);

        // PASSO 1: Coletar todos os nomes de coluna únicos de todas as abas
        const globalColNames = []; // ordem de aparecimento
        const sheetLocalHeaders = {}; // sn → array de nomes de coluna locais
        wb.SheetNames.forEach(sn => {
          const ws = wb.Sheets[sn];
          const sheetRows = XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
          const hIdx = sheetRows.findIndex(r => r.filter(c => String(c).trim()).length >= 3);
          if(hIdx < 0) return;
          const localH = sheetRows[hIdx].map(h => String(h).trim());
          sheetLocalHeaders[sn] = localH;
          localH.forEach(h => { if(h && h !== '#' && !globalColNames.includes(h)) globalColNames.push(h); });
        });

        if(!globalColNames.length){ alert('Planilha vazia ou formato não reconhecido.'); return; }
        const globalHeaders = hasDays ? [...globalColNames, '__dia__'] : [...globalColNames];

        // PASSO 2: Para cada aba, remapear linhas para a estrutura global
        const allRows = [];
        wb.SheetNames.forEach(sn => {
          const ws = wb.Sheets[sn];
          const sheetRows = XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
          const localH = sheetLocalHeaders[sn];
          if(!localH) return;
          const hIdx = sheetRows.findIndex(r => r.filter(c => String(c).trim()).length >= 3);
          if(hIdx < 0) return;
          const day = sheetDays[sn] || '';
          sheetRows.slice(hIdx + 1).forEach(row => {
            if(isSubHeader(row)) return;
            // Criar linha global posicionando cada valor pelo nome da coluna
            const globalRow = new Array(globalHeaders.length).fill('');
            localH.forEach((colName, localIdx) => {
              if(!colName || colName === '#') return;
              const gIdx = globalColNames.indexOf(colName);
              if(gIdx >= 0) globalRow[gIdx] = row[localIdx] !== undefined ? String(row[localIdx]).trim() : '';
            });
            if(hasDays) globalRow[globalRow.length - 1] = day;
            allRows.push(globalRow);
          });
        });

        if(!allRows.length){ alert('Nenhuma linha de médico encontrada.'); return; }
        impHeaders = globalHeaders;
        const nameIdx = globalHeaders.findIndex(h => /medico|médico|nome|doutor/i.test(h));
        impRaw = allRows.filter(r => {
          if(nameIdx >= 0 && !String(r[nameIdx]||'').trim()) return false;
          return r.some(c => String(c||'').trim());
        });
        rows = null;
      }
      if(!impRaw.length){ alert('Nenhuma linha de médico encontrada.'); return; }
      autoMap();
      document.getElementById('impNext').disabled = false;
      document.getElementById('dropTxt').textContent = `✅ ${file.name} — ${impRaw.length} médico(s) detectado(s)`;
      document.getElementById('dropZone').style.borderColor = 'var(--green)';
    } catch(err){ alert('Erro ao ler: '+err.message); console.error(err); }
  };
  if(file.name.endsWith('.csv')) reader.readAsText(file,'UTF-8');
  else reader.readAsArrayBuffer(file);
}

const FIELD_MAP = {
  name:       ['nome','médico','medico','doutor','dr','dra','profissional'],
  specialty:  ['especialidade','especializacao','area'],
  clinic:     ['clínica','clinica','consultório','consultorio','local','estabelecimento','clinica / local','clínica / local'],
  address:    ['endereço','endereco','address','rua'],
  phone1:     ['telefone','tel','fone','phone','celular','cel','contato primário','contato principal'],
  phone2:     ['whatsapp','zap','wpp','telefone 2','wapp','celular 2'],
  secretary:  ['secretária','secretaria','recepcionista','contato','contato secundário'],
  arrive:     ['horário chegada','horario chegada','horário','horario','hora','chegada'],
  window:     ['janela','atendimento','funcionamento','janela de atendimento'],
  positioning:['posicionamento','posicao','obs / posicionamento','obs/posicionamento','position','posic'],
  status:     ['status','situação','etapa'],
  alert:      ['alerta','aviso','⚠️ alerta','observacao','ação','acao'],
  notes:      ['notas','nota','observações','comentarios','obs','ação complementar'],
  instagram:  ['instagram','insta','ig'],
  days:       ['__dia__','dia','day','dias']
};

function autoMap(){
  impMapping = {};
  const usedCols = new Set();
  // Processa cada coluna; o primeiro campo que bater primeiro no FIELD_MAP ganha
  impHeaders.forEach((h,i) => {
    const n = h.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
    if(usedCols.has(i)) return;
    for(const [f,kws] of Object.entries(FIELD_MAP)){
      if(impMapping[f] === undefined && kws.some(k => n.includes(k))){
        impMapping[f] = i;
        usedCols.add(i);
        break; // uma coluna → um campo apenas
      }
    }
  });
}

function impNext(){
  if(impStep===1){
    impStep=2;updateSteps(2);
    document.getElementById('istep1').classList.add('hidden');
    document.getElementById('istep2').classList.remove('hidden');
    document.getElementById('impBack').classList.remove('hidden');
    renderMapping();
  } else if(impStep===2){
    document.querySelectorAll('.map-sel').forEach(s => {
      impMapping[s.dataset.f] = s.value===''?undefined:parseInt(s.value);
    });
    buildParsed();
    impStep=3;updateSteps(3);
    document.getElementById('istep2').classList.add('hidden');
    document.getElementById('istep3').classList.remove('hidden');
    document.getElementById('impNext').classList.add('hidden');
    document.getElementById('impDone').classList.remove('hidden');
    renderPreview();
  }
}
function impPrev(){
  if(impStep===2){
    impStep=1;updateSteps(1);
    document.getElementById('istep2').classList.add('hidden');
    document.getElementById('istep1').classList.remove('hidden');
    document.getElementById('impBack').classList.add('hidden');
  } else if(impStep===3){
    impStep=2;updateSteps(2);
    document.getElementById('istep3').classList.add('hidden');
    document.getElementById('istep2').classList.remove('hidden');
    document.getElementById('impNext').classList.remove('hidden');
    document.getElementById('impDone').classList.add('hidden');
  }
}

function renderMapping(){
  const fields = {name:'Nome*',specialty:'Especialidade*',clinic:'Clínica',address:'Endereço',phone1:'Telefone',phone2:'WhatsApp',secretary:'Secretária',arrive:'Horário chegada',window:'Janela atendimento',positioning:'Posicionamento',alert:'Alerta',status:'Status',instagram:'Instagram',notes:'Notas',days:'📅 Dia da semana'};
  const opts = '<option value="">— Ignorar —</option>' + impHeaders.map((h,i) => `<option value="${i}">${esc(h)}</option>`).join('');
  document.getElementById('mapRows').innerHTML = Object.entries(fields).map(([k,l]) => `
    <div class="map-row">
      <div class="map-lbl">${l}</div>
      <div class="map-arrow">→</div>
      <select class="map-sel" data-f="${k}">${opts}</select>
    </div>`).join('');
  document.querySelectorAll('.map-sel').forEach(s => {
    if(impMapping[s.dataset.f]!==undefined) s.value = impMapping[s.dataset.f];
  });
}

function buildParsed(){
  const norm = s => s.toLowerCase().replace(/\s+/g,' ').trim();
  impParsed = impRaw.map(row => {
    const d = {};
    for(const [f,idx] of Object.entries(impMapping)){
      if(idx !== undefined) d[f] = String(row[idx]||'').trim();
    }
    // Converter campo days de string para array
    if(d.days && typeof d.days === 'string'){
      d.days = d.days ? [d.days] : [];
    } else if(!d.days){
      d.days = [];
    }
    return d;
  }).filter(d => d.name && !/^(manh[aã]|tarde|noite|\d+)$/i.test(d.name));
  impParsed.forEach(d => {
    const existing = doctors.find(x => norm(x.name) === norm(d.name));
    d._dup = !!existing;
    d._warn = !d.phone1 && !d.phone2;
    // Se duplicado, preservar visits e campos estratégicos do médico existente
    if(existing) d._existingId = existing.id;
  });
}

function renderPreview(){
  const ok = impParsed.filter(d => !d._dup && !d._warn).length;
  const w = impParsed.filter(d => !d._dup && d._warn).length;
  const dp = impParsed.filter(d => d._dup).length;
  document.getElementById('impSum').innerHTML = `
    <div class="sum-card ok"><div class="n">${ok}</div><div class="l">Prontos</div></div>
    <div class="sum-card w"><div class="n">${w}</div><div class="l">Incompletos</div></div>
    <div class="sum-card d"><div class="n">${dp}</div><div class="l">Duplicados</div></div>`;
  const prev = impParsed.slice(0,5);
  document.getElementById('prevTbl').innerHTML = `
    <thead><tr><th>Nome</th><th>Especialidade</th><th>Telefone</th><th>Clínica</th><th>Status</th></tr></thead>
    <tbody>${prev.map(d => `<tr style="border-left:3px solid ${d._dup?'var(--red)':d._warn?'var(--yellow)':'var(--green)'}">
      <td>${esc(d.name)}</td><td>${esc(d.specialty||'—')}</td><td>${esc(d.phone1||'—')}</td><td>${esc(d.clinic||'—')}</td>
      <td>${d._dup?'Duplicado':d._warn?'Sem telefone':'OK'}</td>
    </tr>`).join('')}</tbody>`;
}

function impConfirm(){
  let added = 0, updated = 0;
  impParsed.forEach(d => {
    const clean = {...d};
    delete clean._dup; delete clean._warn; delete clean._existingId;
    if(d._dup && d._existingId){
      // Merge: atualiza dados básicos mas preserva visitas e campos estratégicos
      const existing = doctors.find(x => x.id === d._existingId);
      if(existing){
        ['name','specialty','clinic','address','phone1','phone2','secretary','arrive','window','alert','status','positioning','instagram','notes'].forEach(f => {
          if(clean[f]) existing[f] = clean[f];
        });
        // Merge de dias: adiciona sem duplicar
        (clean.days||[]).forEach(day => { if(day && !existing.days.includes(day)) existing.days.push(day); });
        updated++;
      }
    } else if(!d._dup){
      clean.id = 'd'+Date.now()+Math.random().toString(36).slice(2,5);
      clean.status = clean.status || 'Pendente';
      clean.positioning = clean.positioning || 'Desconhecido';
      clean.days = clean.days || [];
      clean.visits = [];
      doctors.push(clean); added++;
    }
  });
  autoDistribute();
  save(); render(); closeImport();
  const parts = [];
  if(added) parts.push(`${added} novo(s)`);
  if(updated) parts.push(`${updated} atualizado(s)`);
  toast(`Importação: ${parts.join(', ')} médico(s)`,'ok');
}

// =============================================================
// ROTA
// =============================================================
let routeList = [];
function openRouteForToday(){
  openRouteForDay(todayName());
}

function openRouteForDay(day){
  const list = doctors.filter(d => (d.days||[]).includes(day) && d.arrive && d.address && !['Fechado','Perdido'].includes(d.status));
  if(!list.length){ toast(`Nenhum médico com horário + endereço em ${day}`,'err'); return; }
  list.sort((a,b) => parseTimeMin(a.arrive) - parseTimeMin(b.arrive));
  routeList = list;
  showRoute(day);
}

function quickSetTime(id){
  const d = doctors.find(x => x.id === id);
  if(!d) return;
  const t = prompt(`Horário de chegada para ${d.name}\n(ex: 8:30, 14h, 9h45)`, d.arrive || '');
  if(t === null) return;
  d.arrive = t.trim();
  const w = prompt('Janela de atendimento (opcional, ex: "8:00 - 12:00"):', d.window || '');
  if(w !== null) d.window = w.trim();
  save(); render(); toast('⏰ Horário atualizado','ok');
}

function quickRoute(id){
  const d = doctors.find(x => x.id === id);
  if(!d?.address) return;
  window.open('https://www.google.com/maps/dir/?api=1&destination='+encodeURIComponent(d.address),'_blank');
}

function showRoute(label){
  // Agrupa por bairro pra visualização
  const groups = {};
  routeList.forEach(d => {
    const g = detectGroup(d.address);
    if(!groups[g]) groups[g] = [];
    groups[g].push(d);
  });
  let html = `<p style="color:var(--muted);font-size:13px;margin-bottom:12px">${routeList.length} paradas · <strong style="color:var(--text)">${esc(label)}</strong></p>`;
  html += '<div style="font-size:12px;color:var(--muted);margin-bottom:10px">Ordenado por proximidade (bairro/prédio) e horário:</div>';
  let idx = 1;
  Object.entries(groups).forEach(([g, list]) => {
    html += `<div class="group-label" style="margin:10px 0 6px">📍 ${esc(g)} (${list.length})</div>`;
    list.forEach(d => {
      html += `<div style="padding:8px 10px;background:var(--surface2);border-radius:6px;margin-bottom:5px;font-size:12px">
        <strong>${idx}. ${esc(d.name)}</strong> <span style="color:var(--muted)">· ${esc(d.arrive||'--')}</span>
        <div style="color:var(--muted);font-size:11px;margin-top:2px">📍 ${esc(d.address)}</div>
      </div>`;
      idx++;
    });
  });
  document.getElementById('routeBody').innerHTML = html;
  document.getElementById('routeOverlay').classList.remove('hidden');
}
function closeRoute(){ document.getElementById('routeOverlay').classList.add('hidden'); }
function openGMaps(){
  if(!routeList.length) return;
  const enc = routeList.map(d => encodeURIComponent(d.address));
  const url = enc.length===1
    ? `https://www.google.com/maps/dir/?api=1&destination=${enc[0]}`
    : `https://www.google.com/maps/dir/?api=1&destination=${enc.at(-1)}&waypoints=${enc.slice(0,-1).join('|')}&travelmode=driving`;
  window.open(url,'_blank');
}

// =============================================================
// UTILS
// =============================================================
function openWA(num){
  const c = (num||'').replace(/\D/g,'');
  const n = c.startsWith('55')?c:'55'+c;
  window.open(`https://wa.me/${n}`,'_blank');
}
function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function toast(msg, type=''){
  const t = document.createElement('div');
  t.className = 'toast '+type;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 2800);
}

function exportCSV(){
  if(!doctors.length) return toast('Nenhum médico para exportar','err');
  const h = ['Nome','Especialidade','Clínica','Endereço','Bairro','Telefone 1','Telefone 2','Secretária','Horário Chegada','Janela','Posicionamento','Status','Pacote','Valor','Follow-up','Motivo Follow-up','Fechamento','Dias Agendados','Ordem','Alerta','Notas'];
  const rows = doctors.map(d => [d.name,d.specialty,d.clinic,d.address,detectGroup(d.address),d.phone1,d.phone2,d.secretary,d.arrive,d.window,d.positioning,d.status,d.package,d.value,d.followUpDate,d.followUpReason,d.closedAt,(d.days||[]).join(' + '),d.scheduledOrder,d.alert,d.notes].map(v => `"${String(v||'').replace(/"/g,'""')}"`));
  const csv = [h.join(','), ...rows.map(r => r.join(','))].join('\n');
  const blob = new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `martinelle_${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
  toast('Exportado!','ok');
}
// =============================================================
// DAY CHIPS SELECTOR
// =============================================================
function toggleDayChip(lbl){
  // Deixa o checkbox nativo mudar primeiro
  setTimeout(() => {
    lbl.classList.toggle('checked', lbl.querySelector('input').checked);
  }, 0);
}
function setDayChips(days){
  document.querySelectorAll('#dayChipsSel .day-chip-lbl').forEach(lbl => {
    const cb = lbl.querySelector('input');
    const isChecked = days.includes(cb.value);
    cb.checked = isChecked;
    lbl.classList.toggle('checked', isChecked);
  });
}
function getSelectedDays(){
  return Array.from(document.querySelectorAll('#dayChipsSel input[type=checkbox]:checked')).map(cb => cb.value);
}

// =============================================================
// IMPORTAR / EXPORTAR
// =============================================================
function importFromJSON(){
  const input = document.createElement('input');
  input.type = 'file';
  input.accept = '.json';
  input.onchange = e => {
    const file = e.target.files[0];
    if(!file) return;
    const reader = new FileReader();
    reader.onload = ev => {
      try {
        const data = JSON.parse(ev.target.result);
        if(data.doctors && Array.isArray(data.doctors)){
          if(!confirm(`Importar ${data.doctors.length} médico(s)? Isso substituirá os dados atuais.`)) return;
          doctors = data.doctors;
          if(data.config) config = {...config, ...data.config};
          // Migração
          doctors.forEach(d => {
            if(d._called === undefined) d._called = false;
            if(d._needsSchedule === undefined) d._needsSchedule = false;
            if(d._quality === undefined) d._quality = '';
            if(!Array.isArray(d.days)) d.days = [];
            if(!d.visits) d.visits = [];
            if(d.followUpCycle === undefined) d.followUpCycle = '';
            if(d.secretaryChannel === undefined) d.secretaryChannel = '';
            if(d.secretaryReceptivity === undefined) d.secretaryReceptivity = '';
            if(d.secretaryNotes === undefined) d.secretaryNotes = '';
          });
          save(); render();
          toast(`✅ ${doctors.length} médico(s) importados`,'ok');
        } else {
          toast('Arquivo inválido — formato não reconhecido','err');
        }
      } catch(err){
        toast('Erro ao ler arquivo JSON','err');
      }
    };
    reader.readAsText(file);
  };
  input.click();
}

async function exportHTMLWithData(){
  try {
    const resp = await fetch(window.location.href);
    let html = await resp.text();
    const dataStr = 'const INITIAL_DOCTORS = ' + JSON.stringify(doctors) + ';';
    // Substituir a declaração INITIAL_DOCTORS
    html = html.replace(/const INITIAL_DOCTORS\s*=\s*\[[\s\S]*?\]\s*;/, dataStr);
    const blob = new Blob([html], {type:'text/html;charset=utf-8'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'prospector-medicos.html';
    a.click();
    resetBackupCount();
    toast('✅ HTML com dados salvo — envie para o celular!','ok');
  } catch(err){
    toast('Não foi possível — use Backup JSON','err');
    console.error(err);
  }
}

function exportJSON(){
  const blob = new Blob([JSON.stringify({doctors,config},null,2)],{type:'application/json'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `martinelle_backup_${new Date().toISOString().slice(0,10)}.json`;
  a.click();
  resetBackupCount();
  toast('Backup JSON gerado','ok');
}

// =============================================================
// PIPELINE (KANBAN)
// =============================================================
const PIPELINE_STAGES = ['Pendente','Visitado','Interessado','Proposta','Fechado','Perdido'];
const STAGE_LABELS = {Pendente:'📍 Pendente',Visitado:'👋 Visitado',Interessado:'🔥 Interessado',Proposta:'📄 Proposta',Fechado:'✅ Fechado',Perdido:'❌ Perdido'};

function renderPipeline(){
  const board = document.getElementById('kanbanBoard');
  if(!board) return;

  // Financeiro
  const fmt = v => 'R$ '+v.toLocaleString('pt-BR',{minimumFractionDigits:0,maximumFractionDigits:0});
  const propostas = doctors.filter(d => d.status === 'Proposta');
  const fechados = doctors.filter(d => d.status === 'Fechado');
  const visited = doctors.filter(d => ['Visitado','Interessado','Proposta','Fechado','Perdido'].includes(d.status));
  const pipelineVal = propostas.reduce((s,d) => s+(d.value||0),0);
  const closedVal = fechados.reduce((s,d) => s+(d.value||0),0);
  const conv = visited.length ? Math.round((fechados.length/visited.length)*100) : 0;
  document.getElementById('finPipeline').textContent = fmt(pipelineVal);
  document.getElementById('finPipelineSub').textContent = `${propostas.length} propostas em aberto`;
  document.getElementById('finClosed').textContent = fmt(closedVal);
  document.getElementById('finClosedSub').textContent = `${fechados.length} contratos`;
  document.getElementById('finConv').textContent = conv+'%';

  board.innerHTML = PIPELINE_STAGES.map(stage => {
    const list = doctors.filter(d => d.status === stage);
    const stageVal = list.reduce((s,d) => s+(d.value||0),0);
    const cards = list.length ? list.map(d => {
      const isSel = selectedIds.has(d.id);
      return `<div class="kan-card ${isSel?'sel-on':''}" draggable="${!selectMode}" style="position:relative"
        ondragstart="if(!selectMode){event.dataTransfer.setData('text/plain','${d.id}');this.classList.add('dragging')}"
        ondragend="this.classList.remove('dragging')"
        onclick="${selectMode?`toggleSelect('${d.id}',event)`:`openForm('${d.id}')`}">
        ${selectMode?`<label class="kan-sel-cb" onclick="event.stopPropagation()"><input type="checkbox" ${isSel?'checked':''} onchange="toggleSelect('${d.id}',event)"></label>`:''}
        <div class="kan-card-name">${esc(d.name)}</div>
        <div class="kan-card-spec">${esc(d.specialty||'—')}</div>
        ${d.package?`<div class="kan-card-pkg">💼 ${esc(d.package)}</div>`:''}
        ${d.value?`<div class="kan-card-val">${fmt(d.value)}/mês</div>`:''}
      </div>`;
    }).join('') : '<div class="kan-empty">— vazio —</div>';
    return `<div class="kan-col" data-stage="${stage}"
      ondragover="event.preventDefault();this.classList.add('drop-target')"
      ondragleave="this.classList.remove('drop-target')"
      ondrop="dropToStage(event,'${stage}')">
      <div class="kan-head">
        <div class="kan-title">${STAGE_LABELS[stage]}</div>
        <div class="kan-count">${list.length}</div>
      </div>
      ${stageVal?`<div class="kan-value">${fmt(stageVal)}/mês</div>`:''}
      ${cards}
    </div>`;
  }).join('');
}

function dropToStage(e, stage){
  e.preventDefault();
  document.querySelectorAll('.kan-col').forEach(c => c.classList.remove('drop-target'));
  const id = e.dataTransfer.getData('text/plain');
  const d = doctors.find(x => x.id === id);
  if(!d || d.status === stage) return;
  d.status = stage;
  if(stage === 'Fechado' && !d.closedAt) d.closedAt = new Date().toISOString().slice(0,10);
  if(stage === 'Visitado' && !d.followUpDate){
    const cycle = parseInt(d.followUpCycle) || 7;
    const dt = new Date(); dt.setDate(dt.getDate() + cycle);
    d.followUpDate = dt.toISOString().slice(0,10);
    d.followUpReason = d.followUpReason || 'Retornar após visita';
  }
  save(); render();
  toast(`Movido para ${STAGE_LABELS[stage]}`,'ok');
}

// =============================================================
// FOLLOW-UPS
// =============================================================
function renderFollowUps(){
  const c = document.getElementById('fuList');
  if(!c) return;
  const list = getFollowUps();
  if(!list.length){
    c.innerHTML = `<div class="empty"><div class="empty-icon">🎉</div><div>Nenhum follow-up pendente.<br><small>Marque um médico como visitado para gerar follow-up automático.</small></div></div>`;
    return;
  }
  const today = new Date().toISOString().slice(0,10);
  c.innerHTML = list.map(d => {
    const overdue = d.followUpDate < today;
    const isToday = d.followUpDate === today;
    const cls = overdue ? 'overdue' : isToday ? 'today' : '';
    const dateLbl = new Date(d.followUpDate+'T00:00:00').toLocaleDateString('pt-BR',{day:'2-digit',month:'short',weekday:'short'});
    const diff = Math.round((new Date(d.followUpDate)-new Date(today))/86400000);
    const rel = overdue ? `${Math.abs(diff)}d atrasado` : isToday ? 'HOJE' : `em ${diff}d`;
    const isSel = selectedIds.has(d.id);
    return `<div class="fu-card ${cls} ${isSel?'sel-on':''}" style="display:flex;align-items:center;gap:10px">
      ${selectMode?`<div class="fu-sel-cb"><input type="checkbox" ${isSel?'checked':''} onchange="toggleSelect('${d.id}',event)"></div>`:''}
      <div class="fu-info" style="flex:1">
        <div class="fu-name">${esc(d.name)} <span style="color:var(--muted);font-weight:400">· ${esc(d.specialty||'—')}</span></div>
        <div class="fu-meta">📋 ${esc(d.followUpReason||'(sem motivo)')} · Status: <strong>${STAGE_LABELS[d.status]||d.status}</strong>${d.followUpCycle?` · 🔁 ciclo ${d.followUpCycle}d`:''}</div>
      </div>
      <div class="fu-date ${cls||'future'}">${dateLbl}<br><small>${rel}</small></div>
      <div style="display:flex;gap:5px;flex-shrink:0">
        ${(d.phone1||d.phone2)?`<button class="btn btn-sm btn-wa" onclick="openWA('${d.phone2||d.phone1}')">💬</button>`:''}
        <button class="btn btn-sm btn-green" onclick="completeFollowUp('${d.id}')">✓ Feito</button>
        <button class="btn btn-sm btn-ghost" onclick="snoozeFollowUp('${d.id}',7)">+7d</button>
        <button class="btn btn-sm btn-ghost" onclick="openForm('${d.id}')">✏️</button>
      </div>
    </div>`;
  }).join('');
}

function completeFollowUp(id){
  const d = doctors.find(x => x.id === id);
  if(!d) return;
  const cycle = parseInt(d.followUpCycle) || 0;
  if(cycle > 0){
    const dt = new Date(); dt.setDate(dt.getDate() + cycle);
    d.followUpDate = dt.toISOString().slice(0,10);
    toast(`✅ Feito! Próximo follow-up em ${cycle} dias (${dt.toLocaleDateString('pt-BR')})`,'ok');
  } else {
    d.followUpDate = ''; d.followUpReason = '';
    toast('Follow-up concluído','ok');
  }
  save(); render();
}
function snoozeFollowUp(id, days){
  const d = doctors.find(x => x.id === id);
  if(!d) return;
  const dt = new Date(); dt.setDate(dt.getDate()+days);
  d.followUpDate = dt.toISOString().slice(0,10);
  save(); render(); toast(`Adiado +${days} dias`,'ok');
}

// =============================================================
// NOTION EXPORT
// =============================================================
let notionFmt = 'md';
function openNotionExport(){ notionFmt='md'; renderNotionContent(); document.getElementById('notionOverlay').classList.remove('hidden'); }
function closeNotion(){ document.getElementById('notionOverlay').classList.add('hidden'); }
function switchNotionFmt(f){
  notionFmt = f;
  document.querySelectorAll('.notion-tab').forEach(t => t.classList.toggle('active', t.dataset.fmt === f));
  renderNotionContent();
}

function getNotionDocs(){
  const filter = document.getElementById('notionFilter').value;
  return filter === 'all' ? doctors : doctors.filter(d => d.status === filter);
}

function renderNotionContent(){
  const list = getNotionDocs();
  let out = '';
  if(notionFmt === 'md'){
    out = list.map(d => {
      const lines = [`## ${d.name}`];
      lines.push(`- **Especialidade:** ${d.specialty||'—'}`);
      if(d.clinic) lines.push(`- **Clínica:** ${d.clinic}`);
      if(d.address) lines.push(`- **Endereço:** ${d.address}`);
      if(d.phone1) lines.push(`- **Telefone:** ${d.phone1}${d.phone2?' / '+d.phone2:''}`);
      if(d.secretary) lines.push(`- **Secretária:** ${d.secretary}`);
      lines.push(`- **Status:** ${STAGE_LABELS[d.status]||d.status}`);
      if(d.package) lines.push(`- **Pacote:** ${d.package}`);
      if(d.value) lines.push(`- **Valor:** R$ ${d.value.toLocaleString('pt-BR')}/mês`);
      if(d.followUpDate) lines.push(`- **Follow-up:** ${new Date(d.followUpDate+'T00:00:00').toLocaleDateString('pt-BR')} — ${d.followUpReason||''}`);
      if(d.notes) lines.push(`- **Notas:** ${d.notes}`);
      return lines.join('\n');
    }).join('\n\n---\n\n');
  } else if(notionFmt === 'table'){
    out = '| Médico | Especialidade | Clínica | Telefone | Status | Pacote | Valor | Follow-up |\n';
    out += '|---|---|---|---|---|---|---|---|\n';
    out += list.map(d => `| ${d.name} | ${d.specialty||'—'} | ${d.clinic||'—'} | ${d.phone1||'—'} | ${STAGE_LABELS[d.status]||d.status} | ${d.package||'—'} | ${d.value?'R$ '+d.value:'—'} | ${d.followUpDate?new Date(d.followUpDate+'T00:00:00').toLocaleDateString('pt-BR'):'—'} |`).join('\n');
  } else {
    out = 'Nome,Especialidade,Clínica,Endereço,Telefone,Secretária,Status,Pacote,Valor,Follow-up,Notas\n';
    out += list.map(d => [d.name,d.specialty,d.clinic,d.address,d.phone1,d.secretary,d.status,d.package,d.value,d.followUpDate,d.notes].map(v => `"${String(v||'').replace(/"/g,'""')}"`).join(',')).join('\n');
  }
  document.getElementById('notionContent').textContent = out;
}

function copyNotion(){
  const txt = document.getElementById('notionContent').textContent;
  navigator.clipboard.writeText(txt).then(() => toast('Copiado! Cole no Notion (Ctrl+V)','ok'),
    () => toast('Erro ao copiar','err'));
}

// =============================================================
// GOOGLE MAPS — SEARCH + PASTE PARSER
// =============================================================
function openMapsSearch(){ document.getElementById('mapsSearchOverlay').classList.remove('hidden'); }
function closeMapsSearch(){ document.getElementById('mapsSearchOverlay').classList.add('hidden'); }
function doMapsSearch(){
  const spec = document.getElementById('mapsSpec').value.trim();
  const city = document.getElementById('mapsCity').value.trim();
  const extra = document.getElementById('mapsExtra').value.trim();
  if(!spec || !city){ toast('Informe especialidade e cidade','err'); return; }
  const q = encodeURIComponent(`${spec} ${city} ${extra}`.trim());
  window.open(`https://www.google.com/maps/search/${q}`,'_blank');
  closeMapsSearch();
  toast('Abrindo Maps em nova aba','ok');
}

let mapsParsed = null;
function openMapsPaste(){
  document.getElementById('mapsPasteText').value = '';
  document.getElementById('mapsParseResult').innerHTML = '';
  document.getElementById('mapsAddBtn').classList.add('hidden');
  mapsParsed = null;
  document.getElementById('mapsPasteOverlay').classList.remove('hidden');
}
function closeMapsPaste(){ document.getElementById('mapsPasteOverlay').classList.add('hidden'); }

function parseMapsPaste(){
  const txt = document.getElementById('mapsPasteText').value.trim();
  if(!txt){ toast('Cole o texto primeiro','err'); return; }
  const lines = txt.split('\n').map(l => l.trim()).filter(Boolean);

  // Nome: primeira linha com Dr/Dra OU primeira linha não-vazia
  let name = lines.find(l => /\b(dr\.?|dra\.?)\b/i.test(l)) || lines[0] || '';

  // Telefone: regex BR
  const phoneRe = /\(?\d{2}\)?\s?\d{4,5}[-\s]?\d{4}/;
  const phoneLine = lines.find(l => phoneRe.test(l));
  const phone = phoneLine ? (phoneLine.match(phoneRe)||[''])[0] : '';

  // Endereço: linha com indicador de logradouro
  const addrRe = /\b(rua|r\.|av|avenida|alameda|al\.|travessa|praça|estrada|rod|rodovia)\b/i;
  let address = lines.find(l => addrRe.test(l)) || '';

  // Especialidade: linha com palavra-chave médica
  const specRe = /(cardiolog|dermatolog|gastroenterolog|geriatr|ginecolog|neurolog|oftalmolog|ortoped|otorrinolaringo|pediatr|psiquiatr|pneumolog|reumatolog|urolog|endocrinolog|cirurgi[ãa]o|mastolog|dermato)/i;
  const specLine = lines.find(l => specRe.test(l));
  const specialty = specLine ? specLine.replace(/[·•|].*/,'').trim() : '';

  // Site / Instagram
  const site = (lines.find(l => /\.com\.br|\.com\b|http/i.test(l)) || '').replace(/^https?:\/\//,'');
  const insta = (lines.find(l => /@\w+/.test(l)) || '').match(/@\w+/)?.[0] || '';

  mapsParsed = {name, specialty, address, phone1:phone, site, instagram:insta};

  document.getElementById('mapsParseResult').innerHTML = `
    <div class="maps-result">
      <div style="font-size:12px;color:var(--green);font-weight:700;margin-bottom:8px">✅ Detectado:</div>
      <div class="row"><div class="lbl">Nome</div><div>${esc(name)||'<span style="color:var(--red)">não encontrado</span>'}</div></div>
      <div class="row"><div class="lbl">Especialidade</div><div>${esc(specialty)||'<span style="color:var(--muted)">—</span>'}</div></div>
      <div class="row"><div class="lbl">Endereço</div><div>${esc(address)||'<span style="color:var(--muted)">—</span>'}</div></div>
      <div class="row"><div class="lbl">Telefone</div><div>${esc(phone)||'<span style="color:var(--muted)">—</span>'}</div></div>
      ${site?`<div class="row"><div class="lbl">Site</div><div>${esc(site)}</div></div>`:''}
      ${insta?`<div class="row"><div class="lbl">Instagram</div><div>${esc(insta)}</div></div>`:''}
      <div style="margin-top:10px;font-size:11px;color:var(--muted)">Você poderá editar tudo depois clicando no card.</div>
    </div>`;
  if(name) document.getElementById('mapsAddBtn').classList.remove('hidden');
}

function addMapsParsed(){
  if(!mapsParsed || !mapsParsed.name) return;
  const dup = doctors.find(x => x.name.toLowerCase() === mapsParsed.name.toLowerCase());
  if(dup && !confirm(`Já existe um médico com esse nome (${dup.name}). Adicionar mesmo assim?`)) return;
  const d = {
    id: 'd'+Date.now()+Math.random().toString(36).slice(2,5),
    name: mapsParsed.name, specialty: mapsParsed.specialty||'',
    clinic:'', address: mapsParsed.address||'',
    phone1: mapsParsed.phone1||'', phone2:'', secretary:'',
    arrive:'', window:'', alert:'',
    instagram: mapsParsed.instagram||'', gmn:'', site: mapsParsed.site||'', crm:'',
    notes:'Importado do Google Maps',
    days:[], status:'Pendente', positioning:'Desconhecido',
    followUpDate:'', followUpReason:'', followUpCycle:'', package:'', value:0, closedAt:''
  };
  doctors.push(d);
  save(); render(); closeMapsPaste();
  toast(`${d.name} adicionado!`,'ok');
  setTimeout(() => openForm(d.id), 400);
}

// Overlay click
// =============================================================
// RADIO BUTTONS HELPER
// =============================================================
function selectRadio(groupId, el){
  document.querySelectorAll(`#${groupId} .radio-btn`).forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
}
function getRadioVal(groupId){
  const sel = document.querySelector(`#${groupId} .radio-btn.selected`);
  return sel ? sel.dataset.val : '';
}

// =============================================================
// VISIT LOG
// =============================================================
let visitLogDoctorId = null;
function openVisitLog(id){
  visitLogDoctorId = id;
  const d = doctors.find(x => x.id === id);
  if(!d) return;
  // Preencher info do médico
  const temp = lastVisitTemp(d);
  document.getElementById('visitLogTitle').textContent = `📝 Registrar Visita — ${d.name}`;
  document.getElementById('visitLogDoctorInfo').innerHTML = `
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
      <strong>${esc(d.name)}</strong>
      <span class="spec">${esc(d.specialty||'—')}</span>
      ${tempHTML(temp)||'<span style="color:var(--muted);font-size:11px">sem visitas anteriores</span>'}
      ${objHTML(d.nextObjective)}
      ${(d.visits||[]).length?`<span class="tl-tag">📋 ${d.visits.length} visita(s) anterior(es)</span>`:''}
    </div>
    ${d.diagNotes?`<div style="margin-top:6px;font-size:11px;color:var(--muted)">🔍 Diagnóstico: ${esc(d.diagNotes.split('\n')[0])}</div>`:''}
    ${d.motivation?`<div style="font-size:11px;color:var(--yellow);margin-top:2px">💡 Dor identificada: ${esc(d.motivation)}</div>`:''}`;
  // Data padrão = hoje
  document.getElementById('vl_date').value = new Date().toISOString().slice(0,10);
  // Reset radios
  ['vl_duration_group','vl_temp_group','vl_obj_group'].forEach(g => {
    const btns = document.querySelectorAll(`#${g} .radio-btn`);
    btns.forEach((b,i) => b.classList.toggle('selected', i===0));
  });
  // Pré-selecionar objetivo atual do médico
  if(d.nextObjective){
    document.querySelectorAll('#vl_obj_group .radio-btn').forEach(b => {
      b.classList.toggle('selected', b.dataset.val === d.nextObjective);
    });
  }
  // Selecionar temp morno como padrão
  document.querySelectorAll('#vl_temp_group .radio-btn').forEach(b => {
    b.classList.toggle('selected', b.dataset.val === 'morno');
  });
  document.getElementById('vl_channel').value = 'presencial';
  document.getElementById('vl_achieved').checked = false;
  document.getElementById('vl_what').value = '';
  document.getElementById('vl_objection').value = '';
  document.getElementById('vl_agreed').value = '';
  document.getElementById('vl_nextObj').value = d.nextObjective || 'agendar';
  // Sugerir próximo contato em 7 dias
  const next = new Date(); next.setDate(next.getDate()+7);
  document.getElementById('vl_nextDate').value = next.toISOString().slice(0,10);
  document.getElementById('visitLogOverlay').classList.remove('hidden');
}
function closeVisitLog(){ document.getElementById('visitLogOverlay').classList.add('hidden'); visitLogDoctorId = null; }

function saveVisitLog(){
  if(!visitLogDoctorId) return;
  const d = doctors.find(x => x.id === visitLogDoctorId);
  if(!d) return;
  const temp = getRadioVal('vl_temp_group');
  const dur  = getRadioVal('vl_duration_group');
  const obj  = getRadioVal('vl_obj_group');
  const nextObj = document.getElementById('vl_nextObj').value;
  const nextDate = document.getElementById('vl_nextDate').value;
  const entry = {
    id: 'v'+Date.now(),
    date: document.getElementById('vl_date').value || new Date().toISOString().slice(0,10),
    channel: document.getElementById('vl_channel').value,
    duration: dur,
    temperature: temp,
    objective: obj,
    objectiveAchieved: document.getElementById('vl_achieved').checked,
    whatHappened: document.getElementById('vl_what').value.trim(),
    objection: document.getElementById('vl_objection').value.trim(),
    agreed: document.getElementById('vl_agreed').value.trim(),
    nextObjective: nextObj,
    nextDate
  };
  if(!d.visits) d.visits = [];
  d.visits.push(entry);
  // Atualizar campos do médico
  d.nextObjective = nextObj;
  const cycle = parseInt(d.followUpCycle) || 0;
  if(cycle > 0){
    const dt = new Date(); dt.setDate(dt.getDate() + cycle);
    d.followUpDate = dt.toISOString().slice(0,10);
    d.followUpReason = d.followUpReason || 'Follow-up pós-visita';
  } else if(nextDate){
    d.followUpDate = nextDate; d.followUpReason = d.followUpReason || 'Follow-up pós-visita';
  }
  // Se primeira visita ou progredir status
  if(d.status === 'Pendente') d.status = 'Visitado';
  save(); render(); closeVisitLog();
  toast('Visita registrada!','ok');
}

// =============================================================
// VISIT HISTORY
// =============================================================
function openHistory(id){
  const d = doctors.find(x => x.id === id);
  if(!d) return;
  document.getElementById('historyTitle').textContent = `📋 Histórico — ${d.name}`;
  document.getElementById('historyDoctorInfo').innerHTML = `
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
      <strong>${esc(d.name)}</strong>
      <span class="spec">${esc(d.specialty||'—')}</span>
      ${tempHTML(lastVisitTemp(d))}
      ${objHTML(d.nextObjective)}
      <span style="font-size:11px;color:var(--muted)">${(d.visits||[]).length} visita(s) registrada(s)</span>
    </div>`;
  document.getElementById('historyLogBtn').onclick = () => { closeHistory(); openVisitLog(id); };
  const visits = (d.visits||[]).slice().reverse();
  if(!visits.length){
    document.getElementById('historyBody').innerHTML = '<div class="empty" style="padding:24px"><div class="empty-icon">📋</div><div>Nenhuma visita registrada ainda.</div></div>';
  } else {
    const tempEmoji = {frio:'❄️',morno:'🌤️',quente:'🔥'};
    const chanIcon = {presencial:'🚶',ligação:'📞',whatsapp:'💬'};
    const durLabel = {relâmpago:'⚡ Relâmpago',curta:'🕐 Curta',longa:'🕐 Longa'};
    document.getElementById('historyBody').innerHTML = visits.map(v => `
      <div class="tl-entry">
        <div class="tl-dot ${v.temperature||''}">
          ${tempEmoji[v.temperature]||'📋'}
        </div>
        <div class="tl-body">
          <div class="tl-head">
            <div class="tl-date">${new Date(v.date+'T00:00:00').toLocaleDateString('pt-BR',{weekday:'short',day:'2-digit',month:'short',year:'numeric'})}</div>
            <div class="tl-tags">
              <span class="tl-tag">${chanIcon[v.channel]||'📋'} ${v.channel||'—'}</span>
              <span class="tl-tag">${durLabel[v.duration]||v.duration||'—'}</span>
              ${v.objectiveAchieved?'<span class="tl-tag" style="color:var(--green)">✅ Obj. alcançado</span>':''}
            </div>
          </div>
          ${v.whatHappened?`<div class="tl-text">${esc(v.whatHappened)}</div>`:''}
          ${v.objection?`<div class="tl-text" style="color:var(--yellow);margin-top:4px">🧱 Objeção: ${esc(v.objection)}</div>`:''}
          ${v.agreed?`<div class="tl-agreed">🤝 Acordado: ${esc(v.agreed)}</div>`:''}
          ${v.nextObjective?`<div class="tl-obj">→ Próximo: ${OBJ_LABELS[v.nextObjective]||v.nextObjective}</div>`:''}
        </div>
      </div>`).join('');
  }
  document.getElementById('historyOverlay').classList.remove('hidden');
}
function closeHistory(){ document.getElementById('historyOverlay').classList.add('hidden'); }

// =============================================================
// FUNIL DASHBOARD
// =============================================================
function renderFunnel(){
  const el = document.getElementById('view-funil');
  if(!el || el.classList.contains('hidden')) return;
  const today = new Date();
  const weekAgo = new Date(today); weekAgo.setDate(weekAgo.getDate()-7);
  const weekAgoStr = weekAgo.toISOString().slice(0,10);
  // Visitas da semana (de todos os doctors.visits)
  let visitasW = 0;
  const allVisits = [];
  doctors.forEach(d => (d.visits||[]).forEach(v => { allVisits.push({...v, doctorName:d.name, doctorId:d.id}); if(v.date >= weekAgoStr) visitasW++; }));
  allVisits.sort((a,b) => b.date.localeCompare(a.date));
  document.getElementById('funnelVisitasW').textContent = visitasW;
  // Conversão Visitado→Interessado
  const visited = doctors.filter(d => ['Visitado','Interessado','Proposta','Fechado'].includes(d.status)).length;
  const interested = doctors.filter(d => ['Interessado','Proposta','Fechado'].includes(d.status)).length;
  document.getElementById('funnelConvI').textContent = visited ? Math.round(interested/visited*100)+'%' : '—';
  // Conversão Proposta→Fechado
  const proposed = doctors.filter(d => ['Proposta','Fechado'].includes(d.status)).length;
  const closed = doctors.filter(d => d.status === 'Fechado').length;
  document.getElementById('funnelConvF').textContent = proposed ? Math.round(closed/proposed*100)+'%' : '—';
  // Estágios
  const stageColors = {Pendente:'#7a7c96',Visitado:'#6c63ff',Interessado:'#ffd166',Proposta:'#ffaf6c',Fechado:'#43d9ad',Perdido:'#ef476f'};
  const total = doctors.length || 1;
  document.getElementById('funnelStages').innerHTML = PIPELINE_STAGES.map(s => {
    const cnt = doctors.filter(d => d.status === s).length;
    const pct = Math.round(cnt/total*100);
    return `<div class="funnel-stage">
      <div class="funnel-label" style="color:${stageColors[s]}">${STAGE_LABELS[s]}</div>
      <div class="funnel-bar-wrap"><div class="funnel-bar" style="width:${pct}%;background:${stageColors[s]}"></div></div>
      <div class="funnel-count" style="color:${stageColors[s]}">${cnt}</div>
      <div class="funnel-conv">${pct}%</div>
    </div>`;
  }).join('');
  // Últimas visitas
  const lastVisits = allVisits.slice(0,6);
  const tempEmoji = {frio:'❄️',morno:'🌤️',quente:'🔥'};
  document.getElementById('funnelLastVisits').innerHTML = lastVisits.length ? lastVisits.map(v => `
    <div style="display:flex;align-items:center;gap:8px;padding:7px 10px;background:var(--surface);border:1px solid var(--border);border-radius:6px;margin-bottom:5px;font-size:12px">
      <span>${tempEmoji[v.temperature]||'📋'}</span>
      <div style="flex:1">
        <strong>${esc(v.doctorName)}</strong>
        <div style="color:var(--muted);font-size:10px">${new Date(v.date+'T00:00:00').toLocaleDateString('pt-BR')} · ${v.channel||'—'}</div>
      </div>
      <button class="btn btn-sm btn-ghost" style="font-size:10px" onclick="openHistory('${v.doctorId}')">ver</button>
    </div>`).join('') : '<div style="color:var(--muted);font-size:12px;padding:10px">Nenhuma visita registrada ainda. Comece a logar suas visitas!</div>';
  // Objeções mais comuns
  const objCount = {};
  allVisits.forEach(v => { if(v.objection && v.objection.trim()){ const key = v.objection.toLowerCase().slice(0,40); objCount[key] = (objCount[key]||0)+1; }});
  const topObj = Object.entries(objCount).sort((a,b)=>b[1]-a[1]).slice(0,5);
  document.getElementById('funnelObjections').innerHTML = topObj.length ? topObj.map(([obj,cnt]) =>
    `<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 10px;background:var(--surface);border:1px solid var(--border);border-radius:6px;margin-bottom:5px;font-size:12px">
      <span>🧱 ${esc(obj)}</span><span style="color:var(--yellow);font-weight:700">${cnt}x</span>
    </div>`).join('') : '<div style="color:var(--muted);font-size:12px;padding:6px">Nenhuma objeção registrada ainda.</div>';
}

// =============================================================
// BULK SELECT
// =============================================================
let selectMode = false;
let selectedIds = new Set();

function toggleSelectMode(){
  selectMode = !selectMode;
  if(!selectMode){ selectedIds.clear(); updateBulkBar(); }
  // Atualiza todos os botões de seleção
  document.querySelectorAll('.btn-sel').forEach(b => {
    b.classList.toggle('active', selectMode);
    b.textContent = selectMode ? '✕ Sair' : '☑️ Selecionar';
  });
  // Mostra/oculta coluna de checkbox na tabela
  const thSel = document.getElementById('thSel');
  if(thSel) thSel.style.display = selectMode ? '' : 'none';
  render();
}

function toggleSelect(id, event){
  if(event){ event.stopPropagation(); event.preventDefault(); }
  if(selectedIds.has(id)) selectedIds.delete(id);
  else selectedIds.add(id);
  updateBulkBar();
  render();
}

function toggleSelectAll(checked){
  // Seleciona/deseleciona todos os visíveis na tabela
  const rows = document.querySelectorAll('#tblBody tr');
  rows.forEach(tr => {
    const cb = tr.querySelector('input[type=checkbox]');
    if(cb){
      const id = cb.getAttribute('onchange').match(/'([^']+)'/)[1];
      if(checked) selectedIds.add(id);
      else selectedIds.delete(id);
    }
  });
  // Também cards do today/pipeline/followup
  document.querySelectorAll('.kan-card input[type=checkbox], .fu-card input[type=checkbox], .med-card input[type=checkbox]').forEach(cb => {
    const m = cb.getAttribute('onchange') && cb.getAttribute('onchange').match(/'([^']+)'/);
    if(m){ if(checked) selectedIds.add(m[1]); else selectedIds.delete(m[1]); }
  });
  updateBulkBar();
  render();
}

function clearSelection(){
  selectedIds.clear();
  updateBulkBar();
  render();
}

function updateBulkBar(){
  const bar = document.getElementById('bulkBar');
  const cnt = document.getElementById('bulkCount');
  if(!bar) return;
  if(selectedIds.size > 0){
    bar.classList.remove('bulk-hidden');
    cnt.textContent = `${selectedIds.size} selecionado${selectedIds.size > 1 ? 's' : ''}`;
  } else {
    bar.classList.add('bulk-hidden');
  }
}

function bulkDelete(){
  if(!selectedIds.size) return;
  const names = doctors.filter(d => selectedIds.has(d.id)).map(d => d.name.split(' ').slice(0,2).join(' '));
  if(!confirm(`⚠️ Apagar ${selectedIds.size} médico(s)?\n\n${names.slice(0,5).join('\n')}${names.length>5?`\n... e mais ${names.length-5}`:''}\n\nEssa ação não pode ser desfeita.`)) return;
  const count = selectedIds.size;
  doctors = doctors.filter(d => !selectedIds.has(d.id));
  selectedIds.clear();
  save(); updateBulkBar(); render();
  toast(`${count} médico(s) apagado(s)`,'ok');
}

function bulkMove(){
  const stage = document.getElementById('bulkMoveSelect').value;
  if(!stage){ toast('Selecione um estágio primeiro','warn'); return; }
  if(!selectedIds.size) return;
  let count = 0;
  doctors.forEach(d => {
    if(selectedIds.has(d.id)){
      d.status = stage;
      if(stage === 'Fechado' && !d.closedAt) d.closedAt = new Date().toISOString().slice(0,10);
      count++;
    }
  });
  document.getElementById('bulkMoveSelect').value = '';
  save(); render();
  toast(`${count} médico(s) movidos para ${STAGE_LABELS[stage]||stage}`,'ok');
}

// =============================================================
// CAMPO VIEW
// =============================================================
let cmCurrentTab = 'visitar';
let cmActiveDay  = 'todos';
let cmMovingId   = null;

const CM_DAYS_ORDER = ['Segunda','Terça','Quarta','Quinta','Sexta','Sábado','Domingo'];
const CM_DAY_SHORT  = {Segunda:'Seg',Terça:'Ter',Quarta:'Qua',Quinta:'Qui',Sexta:'Sex',Sábado:'Sáb',Domingo:'Dom'};
const CM_QUAL_LABEL = {ruim:'😕 Ruim',medio:'😐 Médio',bom:'🙂 Bom',otimo:'🤩 Ótimo'};
const CM_QUAL_CHIP  = {ruim:'cm-chip-ruim',medio:'cm-chip-medio',bom:'cm-chip-bom',otimo:'cm-chip-otimo'};

function cmTodayName(){ return ['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'][new Date().getDay()]; }

function cmVisitDayStr(d){ return Array.isArray(d.days) && d.days.length ? d.days.join(' e ') : ''; }
function cmVisitTimeStr(d){ return d.arrive || d.window || ''; }
function cmQual(d){
  if(d._quality) return d._quality;
  const s = parseInt(d.diagScore)||0;
  if(s >= 5) return 'otimo';
  if(s >= 4) return 'bom';
  if(s >= 3) return 'medio';
  if(s >= 1) return 'ruim';
  return 'bom';
}
function cmCanVisit(d){ return !!(cmVisitDayStr(d) && cmVisitTimeStr(d) && !d._needsSchedule && d.status !== 'Perdido'); }
function cmNeedsCall(d){ return !cmCanVisit(d) && d.status !== 'Perdido'; }

function cmSearchFilter(d){
  const q = (document.getElementById('cmSearchInput')?.value||'').toLowerCase().trim();
  if(!q) return true;
  return [d.name,d.specialty,d.clinic,d.address,d.secretary,cmVisitDayStr(d)].some(f=>String(f||'').toLowerCase().includes(q));
}

function renderCampo(){
  // Badge sidebar
  const campo = document.getElementById('sideCampo');
  if(campo) campo.textContent = doctors.filter(cmCanVisit).length;

  // Header date
  const opts = {weekday:'long',day:'numeric',month:'long'};
  const ds = new Date().toLocaleDateString('pt-BR',opts).replace(/^\w/,c=>c.toUpperCase());
  const hd = document.getElementById('cmHeaderDate');
  if(hd) hd.textContent = ds;

  cmUpdateStats();
  cmCurrentTab === 'visitar' ? cmRenderVisitar() : cmRenderLigar();
}

function cmUpdateStats(){
  const today = cmTodayName();
  const visitList = doctors.filter(cmCanVisit);
  const callList  = doctors.filter(cmNeedsCall);
  const todayList = visitList.filter(d => cmVisitDayStr(d).toLowerCase().includes(today.toLowerCase()));
  const calledN   = doctors.filter(d=>d._called).length;
  const bar = document.getElementById('cmStatsBar');
  if(!bar) return;
  bar.innerHTML = [
    {n:todayList.length, l:'Hoje ⭐'},
    {n:visitList.length, l:'Visitar'},
    {n:callList.length,  l:'Ligar'},
    {n:calledN,          l:'Ligou ✅'},
    {n:doctors.length,   l:'Total'},
  ].map(s=>`<div class="cm-stat-chip"><div class="cm-stat-chip-n">${s.n}</div><div class="cm-stat-chip-l">${s.l}</div></div>`).join('');
}

function cmRenderVisitar(){
  const today = cmTodayName();
  const df = document.getElementById('cmDayFilter');
  if(df) df.classList.remove('hidden');

  const visitDocs = doctors.filter(cmCanVisit);
  const daysPresent = ['todos'];
  CM_DAYS_ORDER.forEach(d => {
    if(visitDocs.some(doc=>cmVisitDayStr(doc).toLowerCase().includes(d.toLowerCase()))) daysPresent.push(d);
  });
  if(df) df.innerHTML = daysPresent.map(d => {
    const isToday = d === today;
    const isActive = cmActiveDay === d;
    return `<div class="cm-day-chip${isActive?' active':''}${isToday&&!isActive?' is-today':''}" onclick="cmSetDay('${d}')">
      ${d==='todos'?'📋 Todos':(CM_DAY_SHORT[d]||d)}${isToday?' ⭐':''}
    </div>`;
  }).join('');

  let list = visitDocs.filter(cmSearchFilter);
  if(cmActiveDay !== 'todos') list = list.filter(d=>cmVisitDayStr(d).toLowerCase().includes(cmActiveDay.toLowerCase()));
  list.sort((a,b)=>(cmVisitTimeStr(a)||'').localeCompare(cmVisitTimeStr(b)||''));

  const content = document.getElementById('cmContent');
  if(!content) return;
  if(!list.length){
    content.innerHTML = `<div class="cm-empty"><div class="cm-empty-ico">🏃</div>
      <div class="cm-empty-title">${cmActiveDay!=='todos'?'Nenhum em '+cmActiveDay:'Nenhum médico para visitar'}</div>
      <div class="cm-empty-sub">Adicione médicos com dia e horário definidos<br>ou mude o filtro de dia</div></div>`;
    return;
  }

  let html = '';
  if(cmActiveDay === 'todos'){
    const groups = {};
    list.forEach(d=>{ const k=cmVisitDayStr(d)||'Sem dia'; if(!groups[k]) groups[k]=[]; groups[k].push(d); });
    const sorted = Object.entries(groups).sort(([a],[b])=>{
      const ai=CM_DAYS_ORDER.findIndex(x=>a.includes(x));
      const bi=CM_DAYS_ORDER.findIndex(x=>b.includes(x));
      const aT=a.toLowerCase().includes(today.toLowerCase());
      const bT=b.toLowerCase().includes(today.toLowerCase());
      if(aT&&!bT) return -1; if(bT&&!aT) return 1;
      return (ai<0?99:ai)-(bi<0?99:bi);
    });
    sorted.forEach(([day,docs])=>{
      const isT = day.toLowerCase().includes(today.toLowerCase());
      html += `<div class="cm-section-label">${isT?'⭐ Hoje — ':''}${day} <span style="color:var(--accent);font-size:12px">(${docs.length})</span></div>`;
      html += docs.map(d=>cmCardHTML(d)).join('');
    });
  } else {
    html = list.map(d=>cmCardHTML(d)).join('');
  }
  content.innerHTML = html;
}

function cmRenderLigar(){
  const df = document.getElementById('cmDayFilter');
  if(df) df.classList.add('hidden');
  const list = doctors.filter(cmNeedsCall).filter(cmSearchFilter);
  const notCalled = list.filter(d=>!d._called);
  const called    = list.filter(d=>d._called);
  const content   = document.getElementById('cmContent');
  if(!content) return;
  if(!list.length){
    content.innerHTML = `<div class="cm-empty"><div class="cm-empty-ico">📞</div>
      <div class="cm-empty-title">Nenhum médico para ligar</div>
      <div class="cm-empty-sub">Todos têm horário de visita definido. Bom trabalho! 🎉</div></div>`;
    return;
  }
  let html = '';
  if(notCalled.length){
    html += `<div class="cm-section-label">📞 Ligar agora <span style="color:var(--accent)">(${notCalled.length})</span></div>`;
    html += notCalled.map(d=>cmCardHTML(d,true)).join('');
  }
  if(called.length){
    html += `<div class="cm-section-label" style="margin-top:12px">✅ Já ligou <span style="color:var(--green)">(${called.length})</span></div>`;
    html += called.map(d=>cmCardHTML(d,true)).join('');
  }
  content.innerHTML = html;
}

function cmCardHTML(d, isCallTab=false){
  const today    = cmTodayName();
  const dayStr   = cmVisitDayStr(d);
  const timeStr  = cmVisitTimeStr(d);
  const qual     = cmQual(d);
  const isToday  = !isCallTab && dayStr && dayStr.toLowerCase().includes(today.toLowerCase());

  const chips = [];
  if(timeStr)   chips.push(`<span class="cm-chip cm-chip-time">⏰ ${esc(timeStr)}</span>`);
  if(dayStr && cmCurrentTab==='visitar' && cmActiveDay==='todos') chips.push(`<span class="cm-chip cm-chip-day">📅 ${esc(dayStr)}</span>`);
  if(d._called)        chips.push(`<span class="cm-chip cm-chip-called">✅ Ligou</span>`);
  if(d._needsSchedule) chips.push(`<span class="cm-chip cm-chip-sched">📅 Agendar</span>`);
  chips.push(`<span class="cm-chip ${CM_QUAL_CHIP[qual]||'cm-chip-bom'}">${CM_QUAL_LABEL[qual]||''}</span>`);

  const timeBlock = timeStr
    ? `<div class="cm-time-block"><strong>${esc(timeStr.split(/[–\-]/)[0].trim())}</strong><small>${dayStr?esc(dayStr.split(/[eE,]/)[0].trim()):'—'}</small></div>`
    : '';

  const actions = [];
  if(d.phone1) actions.push(`<button class="cm-abtn cm-abtn-primary" onclick="cmCallPhone('${esc(d.phone1)}')">📞 Ligar</button>`);
  if(isCallTab){
    actions.push(`<button class="cm-abtn ${d._called?'cm-abtn-ghost':'cm-abtn-success'}" onclick="cmToggleCalled('${d.id}');event.stopPropagation()">${d._called?'↩ Desmarcar':'✅ Já liguei'}</button>`);
    if(!cmCanVisit(d)) actions.push(`<button class="cm-abtn cm-abtn-warn" onclick="cmOpenMoveOverlay('${d.id}');event.stopPropagation()">📅 Agendou!</button>`);
  }
  if(!isCallTab) actions.push(`<button class="cm-abtn cm-abtn-danger" onclick="cmMoveToLigar('${d.id}');event.stopPropagation()">↩ Sem horário</button>`);
  actions.push(`<button class="cm-abtn cm-abtn-ghost" onclick="openForm('${d.id}');event.stopPropagation()">✏️ Editar</button>`);
  actions.push(`<button class="cm-abtn cm-abtn-danger" onclick="markDeclined('${d.id}');event.stopPropagation()" title="Recusou">🚫 Recusou</button>`);
  actions.push(`<button class="cm-abtn cm-abtn-danger" onclick="delDoctor('${d.id}');event.stopPropagation()" title="Excluir">🗑 Excluir</button>`);

  return `<div class="cm-doc-card cm-qual-${qual}${isToday?' cm-card-today':''}">
    <div class="cm-doc-card-top" onclick="cmToggleExpand('${d.id}')">
      <div class="cm-qual-bar"></div>
      <div class="cm-doc-body">
        <div class="cm-doc-name">${esc(d.name)}</div>
        <div class="cm-doc-spec">${esc(d.specialty||'—')}${d.secretary?' · 👤 '+esc(d.secretary):''}</div>
        <div class="cm-chips">${chips.join('')}</div>
      </div>
      ${timeBlock}
    </div>
    <div class="cm-doc-expand" id="cmExp_${d.id}">
      <div class="cm-detail-grid">
        <div><div class="cm-dl">📍 Clínica / Local</div><div class="cm-dv ${d.clinic?'':'empty'}">${esc(d.clinic||'Não informado')}</div></div>
        <div><div class="cm-dl">📍 Endereço</div><div class="cm-dv ${d.address?'':'empty'}">${esc(d.address||'Não informado')}</div></div>
        <div><div class="cm-dl">📞 Telefone 1</div><div class="cm-dv ${d.phone1?'':'empty'}">${esc(d.phone1||'Não informado')}</div></div>
        <div><div class="cm-dl">📞 Telefone 2</div><div class="cm-dv ${d.phone2?'':'empty'}">${esc(d.phone2||'—')}</div></div>
        <div><div class="cm-dl">👤 Secretária</div><div class="cm-dv ${d.secretary?'':'empty'}">${esc(d.secretary||'Não informado')}</div></div>
        <div><div class="cm-dl">📅 Dia / Horário</div><div class="cm-dv">${esc((dayStr&&timeStr)?(dayStr+' · '+timeStr):dayStr||timeStr||'Não definido')}</div></div>
      </div>
      ${d.alert?`<div class="cm-notes-box">⚠️ ${esc(d.alert)}</div>`:''}
      ${d.notes?`<div class="cm-notes-box" style="margin-top:6px">💡 ${esc(d.notes)}</div>`:''}
      <div class="cm-action-row">${actions.join('')}</div>
    </div>
  </div>`;
}

function cmToggleExpand(id){
  const el = document.getElementById('cmExp_'+id);
  if(el) el.classList.toggle('open');
}
function cmCallPhone(p){ window.location.href='tel:'+p.replace(/\D/g,''); }
function cmSetDay(d){ cmActiveDay=d; renderCampo(); }
function cmSwitchTab(tab){
  cmCurrentTab = tab;
  document.getElementById('cmTabVisitar').classList.toggle('active', tab==='visitar');
  document.getElementById('cmTabLigar').classList.toggle('active', tab==='ligar');
  renderCampo();
}
function cmToggleCalled(id){
  const d = doctors.find(x=>x.id===id); if(!d) return;
  d._called = !d._called; save(); renderCampo();
  toast(d._called?'✅ Marcado: já ligou!':'↩ Desmarcado','ok');
}
function cmMoveToLigar(id){
  const d = doctors.find(x=>x.id===id); if(!d) return;
  d.days=[]; d._needsSchedule=true;
  save(); renderCampo(); toast('Movido para lista de ligações','ok');
}
function cmOpenMoveOverlay(id){
  cmMovingId = id;
  document.getElementById('cmMvDay').value='';
  document.getElementById('cmMvTime').value='';
  document.getElementById('cmMoveOverlay').classList.remove('hidden');
}
function cmCloseMoveOverlay(){ cmMovingId=null; document.getElementById('cmMoveOverlay').classList.add('hidden'); }
function cmConfirmMove(){
  if(!cmMovingId) return;
  const d = doctors.find(x=>x.id===cmMovingId); if(!d) return;
  const day  = document.getElementById('cmMvDay').value.trim();
  const time = document.getElementById('cmMvTime').value.trim();
  if(!day){ toast('⚠️ Informe o dia!','err'); return; }
  d.days = day.split(/[,eE]+/).map(s=>s.trim()).filter(Boolean);
  if(time) d.arrive = time;
  d._needsSchedule = false;
  save(); cmCloseMoveOverlay(); renderCampo();
  toast('✅ Movido para Visitar!','ok');
}

const CLOSERS = {formOverlay:closeForm,importOverlay:closeImport,routeOverlay:closeRoute,notionOverlay:closeNotion,mapsSearchOverlay:closeMapsSearch,mapsPasteOverlay:closeMapsPaste,visitLogOverlay:closeVisitLog,historyOverlay:closeHistory,cmMoveOverlay:cmCloseMoveOverlay};
Object.keys(CLOSERS).forEach(id => {
  document.getElementById(id).addEventListener('click', e => {
    if(e.target === e.currentTarget) CLOSERS[id]();
  });
});
document.addEventListener('keydown', e => { if(e.key==='Escape'){ Object.values(CLOSERS).forEach(fn => fn()); } });

// =============================================================
// SYNC COM BOT TELEGRAM (POST real para Netlify Function)
// =============================================================
const SYNC_ENDPOINT = 'https://martinelle-pro.netlify.app/api/sync';

async function syncToBot(){
  const status = document.getElementById('syncStatus');
  if(status){ status.textContent = '🔄 Sincronizando...'; status.style.color = 'var(--accent)'; }
  try {
    const res = await fetch(SYNC_ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ doctors })
    });
    const data = await res.json();
    if(data.ok){
      if(status){
        status.textContent = `✅ ${data.count} médicos sincronizados com o bot!`;
        status.style.color = 'var(--green)';
        setTimeout(() => { status.textContent = ''; }, 6000);
      }
      toast(`Bot sincronizado: ${data.count} médicos`, 'ok');
    } else {
      throw new Error(data.error || 'erro desconhecido');
    }
  } catch(e) {
    if(status){
      status.textContent = '❌ Falha — ' + e.message;
      status.style.color = 'var(--red)';
    }
    toast('Erro ao sincronizar: ' + e.message, 'err');
  }
}

// Auto-sync a cada save (debounced)
let _syncTimer = null;
function autoSync(){
  if(_syncTimer) clearTimeout(_syncTimer);
  _syncTimer = setTimeout(() => { syncToBot().catch(()=>{}); }, 30000);
}

// =============================================================
// RECUSARAM — Não Aceitaram
// =============================================================
function markDeclined(id){
  const d = doctors.find(x => x.id === id);
  if(!d) return;
  if(!confirm(`Confirmar: ${d.name} NÃO aceitou?\n\nEle será removido da agenda e de todos os roteiros.`)) return;
  d.status = 'Perdido';
  d.days = [];
  d.declinedAt = new Date().toISOString().slice(0,10);
  save(); render(); updateSideBadges();
  toast(`${d.name} marcado como Não Aceitou`, 'err');
}

function reactivateDoctor(id){
  const d = doctors.find(x => x.id === id);
  if(!d) return;
  d.status = 'Pendente';
  d.declinedAt = '';
  save(); render(); updateSideBadges();
  toast(`${d.name} reativado — status: Pendente`, 'ok');
}

function renderDeclined(){
  const list = doctors.filter(d => d.status === 'Perdido');
  const container = document.getElementById('declinedList');
  if(!list.length){
    container.innerHTML = `<div class="empty"><div class="empty-icon">🎉</div><div>Nenhum médico recusou ainda.<br><small>Quando alguém falar não, use o botão <strong>🚫 Não Aceitou</strong> no card do médico.</small></div></div>`;
    return;
  }
  const sorted = [...list].sort((a,b) => (b.declinedAt||'').localeCompare(a.declinedAt||'') || a.name.localeCompare(b.name));
  container.innerHTML = `
    <div style="background:rgba(239,71,111,.08);border:1px solid rgba(239,71,111,.2);border-radius:10px;padding:14px 18px;margin-bottom:18px;font-size:13px;color:var(--red)">
      🚫 <strong>${list.length} médico${list.length>1?'s':''}</strong> não aceitaram — arquivados aqui para referência.
      Eles não aparecem mais na agenda, no Hoje nem no Campo.
      Use <strong>↩️ Reativar</strong> se mudar de abordagem.
    </div>
    ${sorted.map(d => `
    <div class="med-card" style="border-left:3px solid var(--red);opacity:.85">
      <div class="med-head">
        <div class="med-main">
          <div><span class="med-name">${esc(d.name)}</span></div>
          <div class="med-sub">${esc(d.specialty||'—')} · ${esc(d.clinic||'—')}</div>
          ${d.declinedAt?`<div style="font-size:11px;color:var(--muted);margin-top:3px">Recusou em ${new Date(d.declinedAt+'T00:00:00').toLocaleDateString('pt-BR')}</div>`:''}
        </div>
      </div>
      <div class="med-info">
        ${d.address?`<div class="info-item"><span class="info-icon">📍</span><span>${esc(d.address)}</span></div>`:''}
        ${d.phone1?`<div class="info-item"><span class="info-icon">📞</span><span>${esc(d.phone1)}</span></div>`:''}
        ${d.specialty?`<div class="info-item"><span class="info-icon">🩺</span><span>${esc(d.specialty)}</span></div>`:''}
      </div>
      ${d.notes?`<div class="med-alert warn">📝 ${esc(d.notes)}</div>`:''}
      <div class="med-actions">
        <button class="btn btn-sm btn-ghost" style="color:var(--green);border-color:var(--green)" onclick="reactivateDoctor('${d.id}')">↩️ Reativar</button>
        ${(d.phone1||d.phone2)?`<button class="btn btn-sm btn-wa" onclick="openWA('${d.phone2||d.phone1}')">💬</button>`:''}
        <button class="btn btn-sm btn-ghost" onclick="openForm('${d.id}')">✏️ Editar</button>
        ${(d.visits||[]).length?`<button class="btn btn-sm btn-ghost" onclick="openHistory('${d.id}')">📋 Histórico (${d.visits.length})</button>`:''}
        <button class="btn btn-sm btn-danger" onclick="delDoctor('${d.id}')" title="Excluir definitivamente">🗑 Excluir</button>
      </div>
    </div>`).join('')}`;
}

// =============================================================
// INIT
// =============================================================
loadState();
render();
updateBackupBanner();

</script>
</body>
</html>
