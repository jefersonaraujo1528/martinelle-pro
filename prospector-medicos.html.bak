<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Martinelle — Prospecção Médica</title>
<meta name="theme-color" content="#6c63ff">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Martinelle">
<script>
(function(){
  var ICON="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'><rect width='512' height='512' rx='80' fill='%236c63ff'/><text x='256' y='370' font-family='Arial' font-weight='900' font-size='320' text-anchor='middle' fill='white'>M</text></svg>";
  var h=document.head;
  var fi=document.createElement('link');fi.rel='icon';fi.href=ICON;h.appendChild(fi);
  var ai=document.createElement('link');ai.rel='apple-touch-icon';ai.href=ICON;h.appendChild(ai);
  var mf=JSON.stringify({name:'Martinelle Pro — Prospecção Médica',short_name:'Martinelle',start_url:'./',display:'standalone',background_color:'#0e0f14',theme_color:'#6c63ff',orientation:'any',lang:'pt-BR',icons:[{src:ICON,sizes:'any',type:'image/svg+xml',purpose:'any maskable'}]});
  var mb=new Blob([mf],{type:'application/manifest+json'});
  var ml=document.createElement('link');ml.rel='manifest';ml.href=URL.createObjectURL(mb);h.appendChild(ml);
})();
</script>
<script src="https://cdn.sheetjs.com/xlsx-0.20.1/package/dist/xlsx.full.min.js"></script>
<style>
:root{
  --bg:#0e0f14;--surface:#171820;--surface2:#21222d;--border:#2a2c3a;
  --accent:#6c63ff;--green:#43d9ad;--yellow:#ffd166;--red:#ef476f;--pink:#ff6584;
  --text:#e8e8f0;--muted:#7a7c96;--radius:10px;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:'Segoe UI',-apple-system,system-ui,sans-serif;font-size:14px;line-height:1.5}
button{font-family:inherit}

.app{display:flex;min-height:100vh}
/* SIDEBAR */
.sidebar{width:220px;background:var(--surface);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0;position:sticky;top:0;height:100vh;overflow-y:auto}
.brand{padding:18px 20px;font-weight:800;font-size:16px;letter-spacing:.3px;color:var(--accent);border-bottom:1px solid var(--border)}
.brand span{color:var(--text);font-weight:600}
.nav{padding:10px 0;flex:1}
.nav-item{display:flex;align-items:center;gap:10px;padding:11px 20px;cursor:pointer;color:var(--muted);font-size:13px;font-weight:600;border-left:3px solid transparent;transition:all .12s}
.nav-item:hover{background:var(--surface2);color:var(--text)}
.nav-item.active{border-left-color:var(--accent);color:var(--text);background:var(--surface2)}
.nav-icon{font-size:16px;width:18px;text-align:center}
.badge-side{margin-left:auto;background:var(--surface);padding:1px 7px;border-radius:10px;font-size:11px;color:var(--muted)}
.nav-item.active .badge-side{background:var(--accent);color:#fff}
.sidebar-foot{padding:12px;border-top:1px solid var(--border)}
.btn-import-side{width:100%;padding:10px;border-radius:8px;background:var(--surface2);color:var(--text);border:1px dashed var(--border);cursor:pointer;font-size:12px;font-weight:600;transition:all .12s}
.btn-import-side:hover{border-color:var(--accent);color:var(--accent)}

/* MAIN */
.main{flex:1;padding:24px 28px;max-width:100%;overflow-x:hidden}
.page-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px;gap:14px;flex-wrap:wrap}
.page-title{font-size:22px;font-weight:800}
.page-title .accent{color:var(--accent)}
.page-sub{color:var(--muted);font-size:13px;margin-top:2px}
.head-actions{display:flex;gap:8px;flex-wrap:wrap}

/* BUTTONS */
.btn{padding:8px 15px;border-radius:8px;border:none;cursor:pointer;font-size:13px;font-weight:600;white-space:nowrap;transition:all .12s;display:inline-flex;align-items:center;gap:6px}
.btn-primary{background:var(--accent);color:#fff}
.btn-primary:hover{background:#7c73ff}
.btn-green{background:var(--green);color:#0f0f13}
.btn-green:hover{background:#53e9bd}
.btn-ghost{background:var(--surface2);color:var(--text);border:1px solid var(--border)}
.btn-ghost:hover{border-color:var(--accent);color:var(--accent)}
.btn-danger{background:var(--red);color:#fff}
.btn-sm{padding:5px 11px;font-size:12px}
.btn-icon{padding:6px 9px}
.btn-wa{background:#25d366;color:#fff}
.btn-wa:hover{background:#2ee574}

/* STATS CARDS */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
.stat{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px 18px;cursor:pointer;transition:border .12s}
.stat:hover{border-color:var(--accent)}
.stat-label{font-size:10px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:4px;font-weight:700}
.stat-value{font-size:26px;font-weight:800}
.stat-value.accent{color:var(--accent)}
.stat-value.green{color:var(--green)}
.stat-value.yellow{color:var(--yellow)}
.stat-value.red{color:var(--red)}

/* CARDS GENERIC */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px}

/* HOJE - MEDICO CARD */
.today-banner{background:linear-gradient(135deg,#6c63ff 0%,#ff6584 100%);border-radius:14px;padding:20px;margin-bottom:18px;color:#fff;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px}
.today-date{font-size:24px;font-weight:800;text-transform:capitalize}
.today-stats{display:flex;gap:18px;flex-wrap:wrap}
.today-stat{text-align:center}
.today-stat-num{font-size:22px;font-weight:800;display:block}
.today-stat-lbl{font-size:11px;opacity:.8;text-transform:uppercase;letter-spacing:.8px}

.group-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--accent);margin:18px 0 8px;display:flex;align-items:center;gap:8px}
.group-label::before{content:'';width:20px;height:2px;background:var(--accent)}
.group-label::after{content:'';flex:1;height:1px;background:var(--border)}

.med-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:10px;position:relative;transition:border .12s}
.med-card:hover{border-color:var(--accent)}
.med-card.visited{opacity:.55}
.med-card.visited::after{content:'✅ VISITADO';position:absolute;top:12px;right:14px;font-size:10px;color:var(--green);font-weight:700;letter-spacing:.8px}

.med-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:10px;flex-wrap:wrap}
.med-main{flex:1;min-width:200px}
.med-order{display:inline-flex;width:26px;height:26px;background:var(--accent);color:#fff;border-radius:50%;font-size:12px;font-weight:800;align-items:center;justify-content:center;margin-right:8px;vertical-align:middle}
.med-name{font-size:15px;font-weight:700;display:inline}
.med-sub{color:var(--muted);font-size:12px;margin-top:3px;margin-left:34px}
.med-time{text-align:right;font-size:13px;color:var(--muted)}
.med-time strong{color:var(--yellow);font-size:16px;display:block;font-weight:800}

.med-info{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin:8px 0;font-size:12px;margin-left:34px}
.info-item{display:flex;align-items:flex-start;gap:6px;color:var(--muted)}
.info-item span{color:var(--text)}
.info-icon{opacity:.7;flex-shrink:0}

.med-alert{background:rgba(239,71,111,.1);border-left:3px solid var(--red);padding:7px 11px;border-radius:6px;margin-top:10px;margin-left:34px;font-size:12px;color:#ff8fa7}
.med-alert.warn{background:rgba(255,209,102,.1);border-left-color:var(--yellow);color:#ffd166}
.med-alert.info{background:rgba(108,99,255,.1);border-left-color:var(--accent);color:#a9a2ff}

.med-actions{display:flex;gap:6px;margin-top:12px;flex-wrap:wrap;margin-left:34px}

/* TABLE */
.filters{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;align-items:center}
.search{position:relative;flex:1;min-width:180px;max-width:300px}
.search input{width:100%;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:9px 12px 9px 34px;color:var(--text);font-size:13px}
.search input:focus{outline:none;border-color:var(--accent)}
.search::before{content:'🔍';position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:13px;opacity:.6}
select.filter{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:9px 10px;color:var(--text);font-size:13px;cursor:pointer}
select.filter:focus{outline:none;border-color:var(--accent)}

.tbl-wrap{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:auto}
table{width:100%;border-collapse:collapse}
thead th{padding:11px 14px;text-align:left;font-size:10px;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);border-bottom:1px solid var(--border);background:var(--surface2);white-space:nowrap;font-weight:700}
tbody tr{border-bottom:1px solid var(--border);transition:background .1s}
tbody tr:hover{background:var(--surface2)}
tbody tr.warn{border-left:3px solid var(--yellow)}
tbody tr.sem-pos{border-left:3px solid var(--pink)}
td{padding:11px 14px;vertical-align:middle;font-size:13px}

.badge{display:inline-block;padding:2px 9px;border-radius:20px;font-size:11px;font-weight:600}
.b-pend{background:rgba(108,99,255,.2);color:var(--accent)}
.b-visited{background:rgba(67,217,173,.2);color:var(--green)}
.b-closed{background:rgba(67,217,173,.3);color:var(--green);border:1px solid rgba(67,217,173,.4)}
.b-declined{background:rgba(239,71,111,.15);color:var(--red)}
.b-pos-sem{background:rgba(255,101,132,.2);color:var(--pink)}
.b-pos-bom{background:rgba(67,217,173,.2);color:var(--green)}
.b-pos-bas{background:rgba(255,209,102,.2);color:var(--yellow)}
.b-pos-desc{background:rgba(120,120,160,.15);color:var(--muted)}
.spec{background:var(--surface2);border:1px solid var(--border);padding:2px 7px;border-radius:4px;font-size:11px;color:var(--muted)}

/* GROUP CHIPS */
.group-chips{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.gchip{padding:6px 13px;border-radius:20px;border:1px solid var(--border);background:var(--surface2);font-size:12px;font-weight:700;cursor:pointer;transition:all .12s;white-space:nowrap;display:inline-flex;align-items:center;gap:5px}
.gchip:hover{border-color:var(--accent);color:var(--accent)}
.gchip.active{background:var(--accent);border-color:var(--accent);color:#fff}
.gchip .chip-count{background:rgba(255,255,255,.2);padding:1px 6px;border-radius:10px;font-size:10px}
.gchip:not(.active) .chip-count{background:var(--surface);color:var(--muted)}
.group-section-title{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--muted);padding:10px 14px 6px;border-top:1px solid var(--border);margin-top:4px}
.group-section-title:first-child{border-top:none;margin-top:0;padding-top:6px}

/* COMPLETENESS DOTS */
.comp-dots{display:flex;gap:3px;align-items:center;margin-top:3px}
.comp-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
.comp-dot.ok{background:var(--green)}
.comp-dot.warn{background:var(--yellow)}
.comp-dot.miss{background:rgba(120,120,160,.25)}
.comp-label{font-size:10px;color:var(--muted);margin-left:4px}

/* CALL ATTEMPTS */
.call-badge{display:inline-flex;align-items:center;gap:5px;padding:3px 8px;border-radius:10px;background:rgba(108,99,255,.12);border:1px solid rgba(108,99,255,.2);font-size:11px;color:var(--accent);font-weight:600}
.call-badge.hot{background:rgba(255,209,102,.1);border-color:rgba(255,209,102,.3);color:var(--yellow)}
.call-badge.many{background:rgba(239,71,111,.1);border-color:rgba(239,71,111,.2);color:var(--red)}
.btn-call{background:rgba(67,217,173,.12);border:1px solid rgba(67,217,173,.25);color:var(--green);border-radius:6px;padding:3px 9px;font-size:11px;font-weight:700;cursor:pointer;font-family:inherit;transition:all .12s}
.btn-call:hover{background:rgba(67,217,173,.2)}

/* AGENDA */
.agenda-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.agenda-col{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:10px;min-height:300px;min-width:0;overflow:hidden}
.agenda-col-head{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:10px;margin-bottom:10px;border-bottom:1px solid var(--border);gap:8px}
.agenda-col-day{font-weight:800;text-transform:uppercase;font-size:13px;letter-spacing:.5px}
.agenda-col-count{color:var(--muted);font-size:11px}
.agenda-col-time{font-size:10px;color:var(--accent);font-weight:700;margin-top:2px}
.btn-day-route{background:var(--accent);color:#fff;border:none;border-radius:6px;padding:4px 9px;font-size:11px;font-weight:700;cursor:pointer;font-family:inherit;white-space:nowrap;flex-shrink:0;margin-top:2px;transition:background .12s}
.btn-day-route:hover{background:#7c73ff}
.btn-day-route:disabled{background:var(--surface2);color:var(--muted);cursor:default}
.agenda-card{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:9px 28px 8px 8px;margin-bottom:8px;cursor:move;font-size:12px;position:relative;transition:border .12s;display:flex;gap:8px;align-items:flex-start;width:100%;box-sizing:border-box;overflow:hidden}
.agenda-card:hover{border-color:var(--accent)}
.agenda-card.dragging{opacity:.4}
.agenda-card.ag-priority{border-left:3px solid var(--red)}
.agenda-card.ag-visitado{border-left:3px solid var(--green);opacity:.7}
.agenda-num{width:18px;height:18px;border-radius:50%;background:var(--surface);border:1px solid var(--border);font-size:9px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--muted);margin-top:2px}
.agenda-card-body{flex:1;min-width:0}
.agenda-card-row1{display:flex;justify-content:space-between;align-items:flex-start;gap:6px}
.agenda-card-name{font-weight:700;font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0}
.ag-time-badge{flex-shrink:0;text-align:right}
.ag-time-big{font-size:15px;font-weight:800;color:var(--yellow);line-height:1;display:block}
.ag-time-win{font-size:10px;color:var(--muted);white-space:nowrap}
.ag-no-time{font-size:10px;color:var(--muted);font-style:italic}
.agenda-card-spec{color:var(--muted);font-size:10px;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.agenda-card-tags{display:flex;flex-wrap:wrap;gap:3px;margin-top:5px}
.ag-tag{display:inline-flex;align-items:center;gap:2px;padding:2px 6px;border-radius:5px;font-size:10px;font-weight:600}
.ag-tag-sec{background:rgba(108,99,255,.12);color:var(--accent)}
.ag-tag-alert{background:rgba(239,71,111,.12);color:var(--red)}
.ag-tag-phone{background:rgba(67,217,173,.12);color:var(--green);cursor:pointer}
.agenda-col-range{font-size:11px;color:var(--accent);font-weight:700;margin-top:3px}
.agenda-remove{position:absolute;top:8px;right:8px;background:none;border:none;color:var(--muted);cursor:pointer;font-size:14px;padding:0}
.agenda-remove:hover{color:var(--red)}
.agenda-empty{text-align:center;color:var(--muted);font-size:12px;font-style:italic;padding:30px 10px}
.agenda-col.drop-target{border-color:var(--accent);background:rgba(108,99,255,.05)}
.agenda-card.ag-notime{background:rgba(252,191,73,.06);border-color:rgba(252,191,73,.3);border-left:3px solid var(--yellow);opacity:.85}
.ag-set-time{background:var(--yellow);color:#1a1a1a;border:none;border-radius:5px;padding:4px 7px;font-size:10px;font-weight:800;cursor:pointer;font-family:inherit;white-space:nowrap}
.ag-set-time:hover{filter:brightness(1.1)}
.ag-tag-multi{background:rgba(108,99,255,.12);color:var(--accent)}
.ag-section-warn{background:rgba(252,191,73,.05);border:1px dashed rgba(252,191,73,.4);border-radius:8px;padding:8px;margin-bottom:10px}
.ag-section-ok{}
.ag-section-title{font-size:10px;font-weight:800;color:var(--yellow);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
.ag-section-ok .ag-section-title{color:var(--green)}
.ag-section-sub{font-size:10px;color:var(--muted);font-style:italic;margin-bottom:6px}
.agenda-col-overload{background:rgba(239,71,111,.12);color:var(--red);font-size:11px;font-weight:800;padding:4px 7px;border-radius:5px;margin-top:5px}
.today-section-warn{background:rgba(252,191,73,.05);border:1px dashed rgba(252,191,73,.4);border-radius:10px;padding:10px;margin-bottom:14px}
.today-section-ok{margin-bottom:8px}
.today-section-title{font-size:11px;font-weight:800;color:var(--yellow);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px}
.today-section-ok .today-section-title{color:var(--green)}
.today-section-sub{font-size:11px;color:var(--muted);font-style:italic;margin-bottom:8px}

.unsched-bar{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin-top:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;font-size:13px}

/* CONFIG */
.config-section{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px;margin-bottom:14px}
.config-section h3{font-size:14px;margin-bottom:12px}
.config-section .desc{font-size:12px;color:var(--muted);margin-bottom:14px}
.day-toggles{display:flex;gap:8px;flex-wrap:wrap}
.day-toggle{background:var(--surface2);border:1px solid var(--border);padding:8px 16px;border-radius:8px;cursor:pointer;font-size:13px;user-select:none;transition:all .12s}
.day-toggle.on{background:var(--accent);border-color:var(--accent);color:#fff}
.day-chips-sel{display:flex;gap:8px;flex-wrap:wrap;margin-top:4px}
.day-chip-lbl{display:inline-flex;align-items:center;padding:8px 16px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);cursor:pointer;font-size:13px;font-weight:700;color:var(--muted);transition:all .12s;user-select:none}
.day-chip-lbl:hover{border-color:var(--accent);color:var(--accent)}
.day-chip-lbl input[type=checkbox]{display:none}
.day-chip-lbl.checked{background:var(--accent);border-color:var(--accent);color:#fff}
.limit-input{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:8px 12px;color:var(--text);font-size:13px;width:120px}

/* MODAL */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.78);z-index:100;display:flex;align-items:center;justify-content:center;padding:16px;overflow-y:auto}
.modal{background:var(--surface);border:1px solid var(--border);border-radius:14px;width:100%;max-width:680px;max-height:92vh;overflow-y:auto;padding:24px}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.modal-title{font-size:17px;font-weight:700}
.modal-close{background:none;border:none;color:var(--muted);font-size:22px;cursor:pointer;line-height:1}
.modal-close:hover{color:var(--text)}
.modal-foot{display:flex;justify-content:flex-end;gap:8px;margin-top:20px;padding-top:16px;border-top:1px solid var(--border)}

/* FORM */
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fgrid .full{grid-column:1/-1}
.field{display:flex;flex-direction:column;gap:5px}
.field label{font-size:10px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.6px}
.field input,.field select,.field textarea{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:8px 11px;color:var(--text);font-size:13px;width:100%;font-family:inherit}
.field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--accent)}
.field textarea{resize:vertical;min-height:60px}
.more-toggle{background:none;border:none;color:var(--accent);cursor:pointer;font-size:13px;font-weight:700;padding:6px 0;text-align:left}
.extras{display:none}
.extras.open{display:block;margin-top:10px}

/* IMPORT */
.steps{display:flex;gap:6px;margin-bottom:18px}
.step{flex:1;text-align:center;padding:8px;border-radius:8px;font-size:11px;font-weight:700;background:var(--surface2);color:var(--muted);letter-spacing:.5px}
.step.active{background:var(--accent);color:#fff}
.step.done{background:rgba(67,217,173,.2);color:var(--green)}
.drop{border:2px dashed var(--border);border-radius:10px;padding:36px 20px;text-align:center;cursor:pointer;transition:all .15s}
.drop:hover,.drop.over{border-color:var(--accent);background:rgba(108,99,255,.05)}
.drop input{display:none}
.map-row{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;margin-bottom:8px}
.map-lbl{font-size:13px;background:var(--surface2);padding:6px 10px;border-radius:6px}
.map-arrow{color:var(--muted)}
.map-sel{background:var(--surface2);border:1px solid var(--border);border-radius:6px;padding:6px 10px;color:var(--text);font-size:13px}
.preview{overflow-x:auto;margin-top:10px}
.preview table{font-size:12px}
.preview th{font-size:10px}
.sum{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:12px 0}
.sum-card{background:var(--surface2);border-radius:8px;padding:12px;text-align:center}
.sum-card .n{font-size:22px;font-weight:800}
.sum-card .l{font-size:11px;color:var(--muted)}
.sum-card.ok .n{color:var(--green)}
.sum-card.w .n{color:var(--yellow)}
.sum-card.d .n{color:var(--red)}

/* PIPELINE KANBAN */
.kanban{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin-top:10px}
.kan-col{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:10px;min-height:340px;display:flex;flex-direction:column}
.kan-col.drop-target{border-color:var(--accent);background:rgba(108,99,255,.05)}
.kan-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:8px;margin-bottom:8px;border-bottom:1px solid var(--border)}
.kan-title{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.6px}
.kan-count{font-size:11px;color:var(--muted);background:var(--surface2);padding:2px 7px;border-radius:10px}
.kan-value{font-size:10px;color:var(--green);font-weight:700;margin-bottom:8px;text-align:center}
.kan-card{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:9px;margin-bottom:6px;cursor:move;font-size:12px;transition:border .12s}
.kan-card:hover{border-color:var(--accent)}
.kan-card.dragging{opacity:.4}
.kan-card-name{font-weight:700;font-size:12px;margin-bottom:2px;line-height:1.3}
.kan-card-spec{color:var(--muted);font-size:10px}
.kan-card-pkg{color:var(--accent);font-size:10px;margin-top:4px;font-weight:700}
.kan-card-val{color:var(--green);font-size:11px;font-weight:800;margin-top:2px}
.kan-empty{color:var(--muted);font-size:11px;text-align:center;padding:20px 6px;font-style:italic}

.kan-col[data-stage="Pendente"] .kan-title{color:var(--muted)}
.kan-col[data-stage="Visitado"] .kan-title{color:var(--accent)}
.kan-col[data-stage="Interessado"] .kan-title{color:var(--yellow)}
.kan-col[data-stage="Proposta"] .kan-title{color:#ffaf6c}
.kan-col[data-stage="Fechado"] .kan-title{color:var(--green)}
.kan-col[data-stage="Perdido"] .kan-title{color:var(--red)}

/* FOLLOW-UP */
.fu-card{background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:8px;padding:12px 14px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.fu-card.overdue{border-left-color:var(--red);background:rgba(239,71,111,.05)}
.fu-card.today{border-left-color:var(--yellow);background:rgba(255,209,102,.05)}
.fu-info{flex:1;min-width:200px}
.fu-name{font-weight:700;font-size:13px}
.fu-meta{font-size:11px;color:var(--muted);margin-top:3px}
.fu-date{font-size:12px;font-weight:700;text-align:right}
.fu-date.overdue{color:var(--red)}
.fu-date.today{color:var(--yellow)}
.fu-date.future{color:var(--accent)}

/* FINANCIAL */
.fin-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:14px}
.fin-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:14px}
.fin-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);font-weight:700;margin-bottom:4px}
.fin-val{font-size:22px;font-weight:800}
.fin-val.green{color:var(--green)}
.fin-val.yellow{color:var(--yellow)}
.fin-val.accent{color:var(--accent)}
.fin-sub{font-size:11px;color:var(--muted);margin-top:2px}

/* COPY BOX */
.copy-box{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:12px;font-family:'SF Mono','Monaco',monospace;font-size:11px;max-height:280px;overflow-y:auto;white-space:pre-wrap;color:var(--text);line-height:1.55}
.notion-tabs{display:flex;gap:6px;margin-bottom:10px}
.notion-tab{padding:6px 12px;border-radius:6px;background:var(--surface2);border:1px solid var(--border);cursor:pointer;font-size:12px;color:var(--muted)}
.notion-tab.active{background:var(--accent);color:#fff;border-color:var(--accent)}

/* TEMPERATURE */
.temp-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;border:1px solid transparent}
.temp-frio{background:rgba(108,180,255,.1);border-color:rgba(108,180,255,.25);color:#70b8ff}
.temp-morno{background:rgba(255,209,102,.1);border-color:rgba(255,209,102,.25);color:var(--yellow)}
.temp-quente{background:rgba(239,71,111,.1);border-color:rgba(239,71,111,.25);color:var(--red)}

/* OBJECTIVE BADGE */
.obj-badge{display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:8px;font-size:10px;font-weight:700;background:rgba(108,99,255,.12);border:1px solid rgba(108,99,255,.2);color:var(--accent)}

/* VISIT HISTORY TIMELINE */
.timeline{padding:4px 0}
.tl-entry{display:flex;gap:12px;margin-bottom:14px;position:relative}
.tl-entry::before{content:'';position:absolute;left:17px;top:28px;bottom:-14px;width:1px;background:var(--border)}
.tl-entry:last-child::before{display:none}
.tl-dot{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;border:2px solid var(--border)}
.tl-dot.frio{background:rgba(108,180,255,.15);border-color:rgba(108,180,255,.3)}
.tl-dot.morno{background:rgba(255,209,102,.15);border-color:rgba(255,209,102,.3)}
.tl-dot.quente{background:rgba(239,71,111,.15);border-color:rgba(239,71,111,.3)}
.tl-body{flex:1;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:10px 12px}
.tl-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;flex-wrap:wrap;margin-bottom:6px}
.tl-date{font-size:11px;color:var(--muted)}
.tl-tags{display:flex;gap:4px;flex-wrap:wrap}
.tl-tag{font-size:10px;padding:2px 6px;border-radius:4px;background:var(--surface);border:1px solid var(--border);color:var(--muted)}
.tl-text{font-size:12px;color:var(--text);line-height:1.55}
.tl-agreed{font-size:11px;color:var(--accent);margin-top:5px;font-style:italic}
.tl-obj{font-size:10px;color:var(--green);margin-top:4px;font-weight:700}

/* LOG FORM */
.log-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.log-grid .full{grid-column:1/-1}
/* BULK SELECT */
.med-card.sel-active{cursor:pointer}
.med-card.sel-on{border-color:var(--accent);background:rgba(108,99,255,.08)}
.kan-card.sel-on{border-color:var(--accent);background:rgba(108,99,255,.1)!important}
.fu-card.sel-on{border-color:var(--accent);background:rgba(108,99,255,.08)}
tr.sel-on td{background:rgba(108,99,255,.07)}
.sel-cb-wrap{position:absolute;top:10px;left:10px;z-index:3}
.sel-cb-wrap input[type=checkbox]{width:17px;height:17px;accent-color:var(--accent);cursor:pointer}
.kan-sel-cb{position:absolute;top:6px;right:6px;z-index:3}
.kan-sel-cb input[type=checkbox]{width:15px;height:15px;accent-color:var(--accent);cursor:pointer}
.fu-sel-cb{flex-shrink:0}
.fu-sel-cb input[type=checkbox]{width:17px;height:17px;accent-color:var(--accent);cursor:pointer}
.bulk-bar{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--surface2);border:1.5px solid var(--accent);border-radius:14px;padding:11px 18px;display:flex;align-items:center;gap:10px;z-index:500;box-shadow:0 8px 32px rgba(0,0,0,.55);white-space:nowrap;flex-wrap:wrap;animation:slideUp .18s ease}
@keyframes slideUp{from{transform:translateX(-50%) translateY(16px);opacity:0}to{transform:translateX(-50%) translateY(0);opacity:1}}
.bulk-bar.bulk-hidden{display:none}
.bulk-count{font-weight:800;color:var(--accent);font-size:13px}
.btn-sel{background:var(--surface2);color:var(--muted);border:1px solid var(--border)}
.btn-sel.active{background:rgba(108,99,255,.2);color:var(--accent);border-color:var(--accent)}
.radio-group{display:flex;gap:6px;flex-wrap:wrap}
.radio-btn{padding:6px 12px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);cursor:pointer;font-size:12px;font-weight:600;color:var(--muted);transition:all .12s;user-select:none}
.radio-btn:hover{border-color:var(--accent)}
.radio-btn input{display:none}
.radio-btn.selected{background:var(--accent);border-color:var(--accent);color:#fff}
.radio-btn.frio.selected{background:rgba(108,180,255,.25);border-color:#70b8ff;color:#70b8ff}
.radio-btn.morno.selected{background:rgba(255,209,102,.2);border-color:var(--yellow);color:var(--yellow)}
.radio-btn.quente.selected{background:rgba(239,71,111,.2);border-color:var(--red);color:var(--red)}

/* FUNNEL DASHBOARD */
.funnel-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px}
.funnel-row{display:flex;flex-direction:column;gap:6px;margin-bottom:14px}
.funnel-stage{display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--surface);border:1px solid var(--border);border-radius:8px}
.funnel-bar-wrap{flex:1;background:var(--surface2);border-radius:4px;height:8px;overflow:hidden}
.funnel-bar{height:100%;border-radius:4px;transition:width .4s ease}
.funnel-count{font-size:13px;font-weight:800;width:30px;text-align:right;flex-shrink:0}
.funnel-label{font-size:12px;font-weight:600;width:130px;flex-shrink:0}
.funnel-conv{font-size:10px;color:var(--muted);width:50px;text-align:right;flex-shrink:0}

.profile-section{background:rgba(108,99,255,.05);border:1px solid rgba(108,99,255,.15);border-radius:8px;padding:12px;margin-top:10px}
.profile-section-title{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--accent);margin-bottom:10px}

/* MAPS PASTE */
.maps-textarea{width:100%;background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:10px;color:var(--text);font-size:13px;min-height:140px;font-family:inherit;resize:vertical}
.maps-textarea:focus{outline:none;border-color:var(--accent)}
.maps-result{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:12px;margin-top:10px;font-size:12px}
.maps-result .row{display:flex;gap:8px;margin-bottom:5px}
.maps-result .lbl{color:var(--muted);font-weight:700;width:90px;flex-shrink:0;font-size:11px;text-transform:uppercase}

@media(max-width:1100px){
  .kanban{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:700px){
  .kanban{grid-template-columns:repeat(2,1fr)}
  .fin-grid{grid-template-columns:1fr}
}

/* HELPERS */
.empty{text-align:center;padding:48px 20px;color:var(--muted)}
.empty-icon{font-size:40px;margin-bottom:10px}
.hidden{display:none!important}
.toast{position:fixed;bottom:20px;right:20px;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px 16px;font-size:13px;box-shadow:0 6px 24px rgba(0,0,0,.3);z-index:200;animation:slide .25s ease}
#savedIndicator{position:fixed;bottom:14px;left:14px;background:rgba(67,217,173,.15);color:var(--green);border:1px solid rgba(67,217,173,.4);border-radius:20px;padding:5px 11px;font-size:11px;font-weight:700;z-index:150;opacity:0;pointer-events:none;transition:opacity .3s}
#savedIndicator.saved-fade{animation:savedFade 1.4s ease}
@keyframes savedFade{0%{opacity:0;transform:translateY(4px)}15%{opacity:1;transform:translateY(0)}70%{opacity:1}100%{opacity:0}}
#backupBanner{position:fixed;top:0;left:0;right:0;background:linear-gradient(90deg,#3a2a05,#4d3505);color:#ffd166;border-bottom:1px solid rgba(252,191,73,.4);padding:10px 18px;font-size:13px;z-index:180;display:flex;align-items:center;gap:10px;flex-wrap:wrap;justify-content:center}
#backupBanner button{background:var(--yellow);color:#1a1a1a;border:none;border-radius:5px;padding:5px 10px;font-size:12px;font-weight:700;cursor:pointer;font-family:inherit}
#backupBanner button:hover{filter:brightness(1.1)}
#backupBanner .bb-close{background:transparent;color:#ffd166;font-size:18px;padding:0 6px;margin-left:6px}
.toast.ok{border-color:var(--green);color:var(--green)}
.toast.err{border-color:var(--red);color:var(--red)}
@keyframes slide{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}

@media(max-width:900px){
  .stats{grid-template-columns:repeat(2,1fr)}
  .agenda-grid{grid-template-columns:1fr}
  .fgrid{grid-template-columns:1fr}
  .fgrid .full{grid-column:1}
  .sidebar{width:190px}
  .main{padding:16px}
}
/* ===== CAMPO VIEW ===== */
.cm-stats-bar{display:flex;gap:10px;margin-bottom:14px;flex-wrap:wrap}
.cm-stat-chip{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px 18px;text-align:center;cursor:default;min-width:72px}
.cm-stat-chip-n{font-size:22px;font-weight:800;color:var(--accent);line-height:1}
.cm-stat-chip-l{font-size:10px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
.cm-tabs{display:flex;gap:0;margin-bottom:14px;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:4px;width:fit-content}
.cm-tab{padding:9px 22px;background:none;border:none;color:var(--muted);font-size:13px;font-weight:700;cursor:pointer;border-radius:8px;transition:all .15s;font-family:inherit}
.cm-tab.active{background:var(--accent);color:#fff}
.cm-search-bar{position:relative;margin-bottom:10px}
.cm-search-bar input{width:100%;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:9px 12px 9px 36px;color:var(--text);font-size:13px;font-family:inherit}
.cm-search-bar input:focus{outline:none;border-color:var(--accent)}
.cm-search-ico{position:absolute;left:11px;top:50%;transform:translateY(-50%);font-size:14px;opacity:.5;pointer-events:none}
.cm-day-filter{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.cm-day-chip{padding:6px 14px;border-radius:20px;border:1.5px solid var(--border);background:var(--surface2);font-size:12px;font-weight:700;color:var(--muted);cursor:pointer;transition:all .15s;white-space:nowrap}
.cm-day-chip.is-today{border-color:var(--accent);color:var(--accent)}
.cm-day-chip.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.cm-section-label{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--muted);margin:14px 0 7px;display:flex;align-items:center;gap:8px}
.cm-section-label::after{content:'';flex:1;height:1px;background:var(--border)}
.cm-doc-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;margin-bottom:10px;overflow:hidden;transition:border .12s;position:relative}
.cm-doc-card:hover{border-color:var(--accent)}
.cm-card-today{border-color:var(--accent)!important;box-shadow:0 0 0 1px rgba(108,99,255,.3)}
.cm-doc-card-top{padding:14px 14px 12px;cursor:pointer;display:flex;gap:10px;align-items:flex-start}
.cm-qual-bar{width:5px;flex-shrink:0;border-radius:3px;align-self:stretch;min-height:44px}
.cm-qual-ruim .cm-qual-bar{background:var(--red)}
.cm-qual-medio .cm-qual-bar{background:var(--yellow)}
.cm-qual-bom .cm-qual-bar{background:var(--accent)}
.cm-qual-otimo .cm-qual-bar{background:var(--green)}
.cm-doc-body{flex:1;min-width:0}
.cm-doc-name{font-size:15px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cm-doc-spec{font-size:12px;color:var(--muted);margin-top:2px}
.cm-chips{display:flex;flex-wrap:wrap;gap:4px;margin-top:8px}
.cm-chip{display:inline-flex;align-items:center;gap:3px;padding:3px 9px;border-radius:8px;font-size:11px;font-weight:700;white-space:nowrap}
.cm-chip-time{background:rgba(108,99,255,.15);color:var(--accent)}
.cm-chip-day{background:var(--surface2);color:var(--muted);border:1px solid var(--border)}
.cm-chip-called{background:rgba(67,217,173,.15);color:var(--green)}
.cm-chip-sched{background:rgba(255,209,102,.15);color:var(--yellow)}
.cm-chip-ruim{background:rgba(239,71,111,.15);color:var(--red)}
.cm-chip-medio{background:rgba(255,209,102,.15);color:var(--yellow)}
.cm-chip-bom{background:rgba(108,99,255,.15);color:var(--accent)}
.cm-chip-otimo{background:rgba(67,217,173,.15);color:var(--green)}
.cm-time-block{text-align:right;flex-shrink:0}
.cm-time-block strong{font-size:17px;font-weight:800;color:var(--yellow);display:block;line-height:1}
.cm-time-block small{font-size:11px;color:var(--muted)}
.cm-doc-expand{display:none;padding:0 14px 14px;border-top:1px solid var(--border)}
.cm-doc-expand.open{display:block}
.cm-detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}
.cm-dl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:var(--muted)}
.cm-dv{font-size:13px;font-weight:600;margin-top:2px;color:var(--text)}
.cm-dv.empty{color:var(--muted);font-style:italic;font-weight:400}
.cm-notes-box{background:rgba(108,99,255,.08);border-radius:8px;padding:9px 11px;font-size:12px;color:var(--text);margin-top:10px;border-left:3px solid var(--accent)}
.cm-action-row{display:flex;gap:7px;margin-top:12px;flex-wrap:wrap}
.cm-abtn{padding:9px 13px;border-radius:9px;border:none;font-size:12px;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .12s;font-family:inherit}
.cm-abtn-primary{background:var(--accent);color:#fff}
.cm-abtn-success{background:var(--green);color:#0f0f13}
.cm-abtn-warn{background:var(--yellow);color:#0f0f13}
.cm-abtn-ghost{background:var(--surface2);color:var(--text);border:1px solid var(--border)}
.cm-abtn-danger{background:rgba(239,71,111,.15);color:var(--red);border:1px solid rgba(239,71,111,.2)}
.cm-empty{text-align:center;padding:48px 20px;color:var(--muted)}
.cm-empty-ico{font-size:42px;margin-bottom:12px}
.cm-empty-title{font-size:16px;font-weight:700}
.cm-empty-sub{font-size:12px;margin-top:6px;line-height:1.5}

@media(max-width:640px){
  .app{flex-direction:column}
  .sidebar{width:100%;height:auto;position:relative;flex-direction:row;overflow-x:auto}
  .brand{border-bottom:none;border-right:1px solid var(--border);flex-shrink:0}
  .nav{display:flex;flex-direction:row;flex:1}
  .nav-item{border-left:none;border-bottom:3px solid transparent;padding:12px 14px;flex-shrink:0}
  .nav-item.active{border-bottom-color:var(--accent);border-left-color:transparent}
  .sidebar-foot{display:none}
  .main{padding:12px}
  .today-banner{flex-direction:column;text-align:center}
  .today-date{font-size:20px}
}
</style>
</head>
<body>
<div id="savedIndicator">💾 Salvo</div>
<div id="backupBanner" class="hidden">
  ⚠️ <strong><span id="backupBannerCount">0</span> alterações</strong> sem backup. <button onclick="exportHTMLWithData()">📱 Salvar HTML</button> ou <button onclick="exportJSON()">⬇ Backup JSON</button>
  <button class="bb-close" onclick="document.getElementById('backupBanner').classList.add('hidden')" title="Lembrar depois">×</button>
</div>
<div class="app">

<!-- SIDEBAR -->
<aside class="sidebar">
  <div class="brand">Martinelle <span>Pro</span></div>
  <nav class="nav">
    <div class="nav-item active" data-view="today" onclick="goView('today')"><span class="nav-icon">🌅</span> Hoje <span class="badge-side" id="sideToday">0</span></div>
    <div class="nav-item" data-view="medicos" onclick="goView('medicos')"><span class="nav-icon">🏥</span> Médicos <span class="badge-side" id="sideTotal">0</span></div>
    <div class="nav-item" data-view="pipeline" onclick="goView('pipeline')"><span class="nav-icon">💼</span> Pipeline <span class="badge-side" id="sidePipeline">0</span></div>
    <div class="nav-item" data-view="funil" onclick="goView('funil')"><span class="nav-icon">📊</span> Funil</div>
    <div class="nav-item" data-view="followup" onclick="goView('followup')"><span class="nav-icon">🔔</span> Follow-ups <span class="badge-side" id="sideFollow">0</span></div>
    <div class="nav-item" data-view="agenda" onclick="goView('agenda')"><span class="nav-icon">📅</span> Agenda</div>
    <div class="nav-item" data-view="campo" onclick="goView('campo')"><span class="nav-icon">🏃</span> Campo <span class="badge-side" id="sideCampo">0</span></div>
    <div class="nav-item" data-view="recusaram" onclick="goView('recusaram')"><span class="nav-icon">🚫</span> Recusaram <span class="badge-side" id="sideDeclined">0</span></div>
    <div class="nav-item" data-view="alertas" onclick="goView('alertas')"><span class="nav-icon">⚠️</span> Alertas <span class="badge-side" id="sideAlerts">0</span></div>
    <div class="nav-item" data-view="config" onclick="goView('config')"><span class="nav-icon">⚙️</span> Configurações</div>
  </nav>
  <div class="sidebar-foot">
    <button class="btn-import-side" onclick="openImport()">⬆ Importar Excel</button>
  </div>
</aside>

<!-- MAIN -->
<main class="main">

<!-- ========== HOJE ========== -->
<section id="view-today">
  <div class="today-banner">
    <div>
      <div class="today-date" id="todayDate">—</div>
      <div style="opacity:.9;font-size:13px;margin-top:2px" id="todaySub">Carregando...</div>
    </div>
    <div class="today-stats">
      <div class="today-stat"><span class="today-stat-num" id="todayPending">0</span><span class="today-stat-lbl">Visitar</span></div>
      <div class="today-stat"><span class="today-stat-num" id="todayCall">0</span><span class="today-stat-lbl">Ligar</span></div>
      <div class="today-stat"><span class="today-stat-num" id="todayDone">0</span><span class="today-stat-lbl">Feito ✅</span></div>
      <div class="today-stat"><span class="today-stat-num" id="todayPrior">0</span><span class="today-stat-lbl">Prioridade 🎯</span></div>
    </div>
  </div>
  <!-- chips de tab -->
  <div style="display:flex;gap:8px;margin:14px 0 6px;flex-wrap:wrap;align-items:center">
    <button id="todayTabVisitar" class="gchip active" onclick="todaySetTab('visitar')">🏃 Para Visitar <span id="todayChipVisitar" style="background:rgba(255,255,255,.2);padding:1px 6px;border-radius:10px;font-size:10px">0</span></button>
    <button id="todayTabLigar" class="gchip" onclick="todaySetTab('ligar')">📞 Para Ligar <span id="todayChipLigar" style="background:rgba(255,255,255,.2);padding:1px 6px;border-radius:10px;font-size:10px">0</span></button>
    <div style="flex:1"></div>
    <button class="btn btn-ghost btn-sm" onclick="redistributeSchedule()">🔄 Redistribuir</button>
    <button class="btn btn-green btn-sm" onclick="openRouteForToday()">🗺️ Rota do dia</button>
  </div>
  <div id="todayList"></div>
</section>

<!-- ========== MÉDICOS ========== -->
<section id="view-medicos" class="hidden">
  <div class="page-head">
    <div>
      <div class="page-title">🏥 Todos os <span class="accent">Médicos</span></div>
      <div class="page-sub">Cadastro, organização e prospecção</div>
    </div>
    <div class="head-actions">
      <button class="btn btn-ghost" onclick="openMapsSearch()">🔍 Buscar no Maps</button>
      <button class="btn btn-ghost" onclick="openMapsPaste()">📋 Colar do Maps</button>
      <button class="btn btn-ghost" onclick="exportCSV()">⬇ CSV</button>
      <button class="btn btn-ghost" onclick="openImport()">⬆ Excel</button>
      <button class="btn btn-ghost btn-sel" id="btnSelMedicos" onclick="toggleSelectMode()">☑️ Selecionar</button>
      <button class="btn btn-primary" onclick="openForm()">+ Novo Médico</button>
    </div>
  </div>
  <div class="stats">
    <div class="stat" onclick="setFilter({})"><div class="stat-label">Total</div><div class="stat-value accent" id="statTotal">0</div></div>
    <div class="stat" onclick="setFilter({positioning:'Sem'})"><div class="stat-label">Sem Posicionamento 🎯</div><div class="stat-value red" id="statSem">0</div></div>
    <div class="stat" onclick="setFilter({status:'Pendente'})"><div class="stat-label">Pendentes</div><div class="stat-value yellow" id="statPend">0</div></div>
    <div class="stat" onclick="setFilter({status:'Visitado'})"><div class="stat-label">Visitados</div><div class="stat-value green" id="statVisit">0</div></div>
  </div>
  <div class="group-chips" id="groupChips">
    <div class="gchip active" data-grp="todos" onclick="setGroupChip('todos')">🏥 Todos <span class="chip-count" id="chipTodos">0</span></div>
    <div class="gchip" data-grp="visitar" onclick="setGroupChip('visitar')">🏃 Para Visitar <span class="chip-count" id="chipVisitar">0</span></div>
    <div class="gchip" data-grp="ligar" onclick="setGroupChip('ligar')">📞 Para Ligar <span class="chip-count" id="chipLigar">0</span></div>
    <div class="gchip" data-grp="incompleto" onclick="setGroupChip('incompleto')">⚠️ Incompletos <span class="chip-count" id="chipIncompleto">0</span></div>
    <div class="gchip" data-grp="semHorario" onclick="setGroupChip('semHorario')">⏰ Sem Horário <span class="chip-count" id="chipSemHorario">0</span></div>
  </div>
  <div class="filters">
    <div class="search"><input type="text" id="search" placeholder="Buscar médico, clínica, secretária..." oninput="renderTable()"></div>
    <select class="filter" id="fSpec" onchange="renderTable()"><option value="">Todas especialidades</option></select>
    <select class="filter" id="fStatus" onchange="renderTable()">
      <option value="">Todos status</option>
      <option value="Pendente">Pendente</option>
      <option value="Visitado">Visitado</option>
      <option value="Interessado">Interessado</option>
      <option value="Proposta">Proposta Enviada</option>
      <option value="Fechado">Fechado</option>
      <option value="Perdido">Perdido</option>
    </select>
    <select class="filter" id="fPos" onchange="renderTable()">
      <option value="">Posicionamento</option>
      <option value="Sem">Sem — Prioridade 🎯</option>
      <option value="Básico">Básico</option>
      <option value="Bom">Bom</option>
      <option value="Desconhecido">Desconhecido</option>
    </select>
  </div>
  <div class="tbl-wrap">
    <table>
      <thead><tr id="tblHeadRow">
        <th id="thSel" style="width:36px;display:none"><input type="checkbox" id="chkSelAll" style="accent-color:var(--accent);width:15px;height:15px;cursor:pointer" onchange="toggleSelectAll(this.checked)" title="Selecionar todos"></th>
        <th>Médico</th><th>Especialidade</th><th>Clínica / Bairro</th>
        <th>Secretária</th><th>Telefone</th><th>Status</th><th>Posicionamento</th><th>Temp / Obj.</th><th>Completude</th><th>Ações</th>
      </tr></thead>
      <tbody id="tblBody"></tbody>
    </table>
    <div class="empty hidden" id="tblEmpty">
      <div class="empty-icon">🏥</div>
      <div>Nenhum médico encontrado.<br><small>Use <strong>+Novo</strong> ou <strong>Importar Excel</strong> para começar.</small></div>
    </div>
  </div>
</section>

<!-- ========== PIPELINE ========== -->
<section id="view-pipeline" class="hidden">
  <div class="page-head">
    <div>
      <div class="page-title">💼 <span class="accent">Pipeline</span> de Vendas</div>
      <div class="page-sub">Arraste os cards para mover entre estágios · Clique para editar</div>
    </div>
    <div class="head-actions">
      <button class="btn btn-ghost btn-sel" id="btnSelPipeline" onclick="toggleSelectMode()">☑️ Selecionar</button>
      <button class="btn btn-ghost" onclick="openNotionExport()">📋 Exportar p/ Notion</button>
    </div>
  </div>
  <div class="fin-grid">
    <div class="fin-card"><div class="fin-lbl">💰 Pipeline (Proposta)</div><div class="fin-val yellow" id="finPipeline">R$ 0</div><div class="fin-sub" id="finPipelineSub">0 propostas em aberto</div></div>
    <div class="fin-card"><div class="fin-lbl">✅ Receita Fechada</div><div class="fin-val green" id="finClosed">R$ 0</div><div class="fin-sub" id="finClosedSub">0 contratos</div></div>
    <div class="fin-card"><div class="fin-lbl">📊 Taxa de Conversão</div><div class="fin-val accent" id="finConv">0%</div><div class="fin-sub">Visitados → Fechados</div></div>
  </div>
  <div class="kanban" id="kanbanBoard"></div>
</section>

<!-- ========== FUNIL ========== -->
<section id="view-funil" class="hidden">
  <div class="page-head">
    <div>
      <div class="page-title">📊 <span class="accent">Funil</span> de Conversão</div>
      <div class="page-sub">Visão geral do processo — da prospecção ao fechamento</div>
    </div>
  </div>
  <div class="funnel-grid">
    <div class="stat"><div class="stat-label">📅 Visitas esta semana</div><div class="stat-value accent" id="funnelVisitasW">0</div></div>
    <div class="stat"><div class="stat-label">🔥 Taxa visit→Interessado</div><div class="stat-value yellow" id="funnelConvI">0%</div></div>
    <div class="stat"><div class="stat-label">✅ Taxa Proposta→Fechado</div><div class="stat-value green" id="funnelConvF">0%</div></div>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px">
    <div>
      <div class="group-label">Estágios do pipeline</div>
      <div class="funnel-row" id="funnelStages"></div>
    </div>
    <div>
      <div class="group-label">Últimas visitas registradas</div>
      <div id="funnelLastVisits"></div>
      <div style="margin-top:12px">
        <div class="group-label">Objeções mais comuns</div>
        <div id="funnelObjections"></div>
      </div>
    </div>
  </div>
</section>

<!-- ========== FOLLOW-UPS ========== -->
<section id="view-followup" class="hidden">
  <div class="page-head">
    <div>
      <div class="page-title">🔔 <span class="accent">Follow-ups</span></div>
      <div class="page-sub">Retornos agendados · O app sugere automaticamente após cada visita</div>
    </div>
    <div class="head-actions">
      <button class="btn btn-ghost btn-sel" id="btnSelFollowup" onclick="toggleSelectMode()">☑️ Selecionar</button>
    </div>
  </div>
  <div id="fuList"></div>
</section>

<!-- ========== AGENDA ========== -->
<section id="view-agenda" class="hidden">
  <div class="page-head">
    <div>
      <div class="page-title">📅 <span class="accent">Agenda</span> da Semana</div>
      <div class="page-sub">Arraste para reorganizar · O app prioriza quem não tem posicionamento online</div>
    </div>
    <div class="head-actions">
      <button class="btn btn-ghost" onclick="clearSchedule()">🗑 Limpar agenda</button>
      <button class="btn btn-primary" onclick="redistributeSchedule()">🔄 Auto-distribuir</button>
    </div>
  </div>
  <div class="agenda-grid" id="agendaGrid"></div>
  <div class="unsched-bar">
    <div><strong id="unschedCount">0</strong> médicos sem dia definido</div>
    <button class="btn btn-sm btn-ghost" onclick="showUnscheduled()">Ver lista</button>
  </div>
</section>

<!-- ========== ALERTAS ========== -->
<section id="view-alertas" class="hidden">
  <div class="page-head">
    <div>
      <div class="page-title">⚠️ <span class="accent">Alertas</span></div>
      <div class="page-sub">Cadastros com problemas ou ações pendentes</div>
    </div>
  </div>
  <div class="tbl-wrap">
    <table>
      <thead><tr><th>Médico</th><th>Problema</th><th>Ação</th></tr></thead>
      <tbody id="alertBody"></tbody>
    </table>
    <div class="empty hidden" id="alertEmpty">
      <div class="empty-icon">✅</div>
      <div>Nenhum alerta. Tudo em ordem!</div>
    </div>
  </div>
</section>

<!-- ========== CAMPO ========== -->
<section id="view-campo" class="hidden">
  <div class="page-head">
    <div>
      <div class="page-title">🏃 <span class="accent">Campo</span> — Prospecção</div>
      <div class="page-sub" id="cmHeaderDate">Hoje</div>
    </div>
    <div class="head-actions">
      <button class="btn btn-primary" onclick="openForm()">+ Novo Médico</button>
    </div>
  </div>

  <!-- Stats bar -->
  <div class="cm-stats-bar" id="cmStatsBar"></div>

  <!-- Tabs -->
  <div class="cm-tabs">
    <button class="cm-tab active" id="cmTabVisitar" onclick="cmSwitchTab('visitar')">🏃 Para Visitar</button>
    <button class="cm-tab" id="cmTabLigar" onclick="cmSwitchTab('ligar')">📞 Para Ligar</button>
  </div>

  <!-- Search -->
  <div class="cm-search-bar">
    <span class="cm-search-ico">🔍</span>
    <input id="cmSearchInput" placeholder="Buscar médico, especialidade, local..." oninput="renderCampo()">
  </div>

  <!-- Day Filter -->
  <div class="cm-day-filter hidden" id="cmDayFilter"></div>

  <!-- Content -->
  <div id="cmContent"></div>
</section>

<!-- ========== CONFIG ========== -->
<section id="view-config" class="hidden">
  <div class="page-head">
    <div>
      <div class="page-title">⚙️ <span class="accent">Configurações</span></div>
      <div class="page-sub">Ajuste seus dias de prospecção e regras automáticas</div>
    </div>
  </div>

  <div class="config-section">
    <h3>📅 Dias de prospecção</h3>
    <div class="desc">Em quais dias você sai pra visitar médicos? <strong>Foco recomendado: Terça, Quarta e Quinta.</strong></div>
    <div class="day-toggles" id="dayToggles"></div>
    <button class="btn btn-ghost" style="margin-top:10px" onclick="setFocusDays()">🎯 Focar só em Terça/Quarta/Quinta</button>
  </div>

  <div class="config-section">
    <h3>🧹 Limpar duplicados</h3>
    <div class="desc">Procura médicos com o mesmo nome cadastrados mais de uma vez e mescla os dados (mantém o registro mais completo, junta dias e visitas).</div>
    <button class="btn btn-primary" onclick="dedupeDoctors(false)">🔍 Verificar e mesclar duplicados</button>
  </div>

  <div class="config-section">
    <h3>🎯 Limite de visitas por dia</h3>
    <div class="desc">Quantos médicos no máximo por dia? (recomendado entre 10 e 20)</div>
    <input type="number" class="limit-input" id="limitPerDay" min="5" max="30" onchange="saveConfig()">
  </div>

  <div class="config-section">
    <h3>🎯 Prioridade automática</h3>
    <div class="desc">O app prioriza médicos <strong>sem posicionamento online</strong> — eles são seus melhores leads. Também respeita horários preferidos e agrupa por proximidade (mesmo prédio/bairro).</div>
    <button class="btn btn-primary" onclick="redistributeSchedule()">🔄 Redistribuir agenda agora</button>
  </div>

  <div class="config-section">
    <h3>💾 Dados &amp; Sincronização</h3>
    <div class="desc">Use o <strong>HTML com dados</strong> para abrir no celular ou outro computador com todos os seus médicos já carregados. Basta enviar o arquivo pelo WhatsApp ou e-mail e abrir no outro dispositivo.</div>
    <div style="background:linear-gradient(135deg,#6c63ff22,#43d9ad11);border:1px solid var(--accent);border-radius:10px;padding:14px;margin-bottom:14px">
      <div style="font-weight:800;font-size:13px;margin-bottom:6px">🤖 Sincronizar com o Bot do Telegram</div>
      <div style="font-size:12px;color:var(--muted);margin-bottom:10px">Exporta seus médicos atuais para o bot poder responder perguntas com dados reais.</div>
      <button class="btn btn-primary" onclick="syncToBot()" style="background:linear-gradient(135deg,#6c63ff,#43d9ad)">🔄 Sincronizar com Bot</button>
      <span id="syncStatus" style="margin-left:10px;font-size:12px;color:var(--muted)"></span>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
      <button class="btn btn-primary" onclick="exportHTMLWithData()" title="Baixa o HTML com todos os dados embutidos — abra em qualquer dispositivo">📱 Salvar HTML com dados</button>
      <button class="btn btn-ghost" onclick="exportJSON()" title="Backup JSON para segurança">⬇ Backup JSON</button>
      <button class="btn btn-ghost" onclick="importFromJSON()" title="Restaurar de um backup JSON">⬆ Importar JSON</button>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn btn-ghost" onclick="exportCSV()">⬇ Exportar CSV</button>
      <button class="btn btn-ghost" onclick="openImport()">⬆ Importar Excel</button>
      <button class="btn btn-danger" onclick="resetAll()">🗑 Limpar tudo</button>
    </div>
    <div style="margin-top:10px;padding:10px;background:var(--surface2);border-radius:8px;font-size:12px;color:var(--muted);line-height:1.6">
      <strong style="color:var(--text)">Como usar em celular + computador:</strong><br>
      1. No PC: clique em <strong>📱 Salvar HTML com dados</strong><br>
      2. Envie o arquivo baixado para o celular (WhatsApp, e-mail, etc.)<br>
      3. Abra o arquivo no celular — todos os dados já estarão lá<br>
      4. Quando atualizar dados no celular, repita o processo para sincronizar de volta ao PC
    </div>
  </div>
</section>

<!-- ========== RECUSARAM ========== -->
<section id="view-recusaram" class="hidden">
  <div class="page-head">
    <div>
      <div class="page-title">🚫 <span class="accent">Recusaram</span></div>
      <div class="page-sub">Médicos que não aceitaram a proposta — por nome, não por número</div>
    </div>
  </div>
  <div id="declinedList"></div>
</section>

</main>
</div>

<!-- ========== CAMPO: MOVER PARA VISITAR ========== -->
<div class="overlay hidden" id="cmMoveOverlay">
  <div class="modal" style="max-width:400px">
    <div class="modal-head">
      <div class="modal-title">📅 Conseguiu agendar?</div>
      <button class="modal-close" onclick="cmCloseMoveOverlay()">×</button>
    </div>
    <div class="field" style="margin-bottom:12px"><label>Dia(s) que atende rep.</label>
      <input id="cmMvDay" placeholder="Ex: Terça e Quinta">
    </div>
    <div class="field" style="margin-bottom:12px"><label>Horário de atendimento</label>
      <input id="cmMvTime" placeholder="Ex: 8h–12h">
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="cmCloseMoveOverlay()">Cancelar</button>
      <button class="btn btn-green" onclick="cmConfirmMove()">✅ Mover para Visitar</button>
    </div>
  </div>
</div>

<!-- ========== MODAL FORM ========== -->
<div class="overlay hidden" id="formOverlay">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-title" id="formTitle">Novo Médico</div>
      <button class="modal-close" onclick="closeForm()">×</button>
    </div>
    <form id="medForm">
      <!-- ── BLOCO 1: IDENTIFICAÇÃO ── -->
      <div style="background:var(--surface2);border-radius:8px;padding:12px;margin-bottom:10px">
        <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--accent);margin-bottom:10px">👨‍⚕️ Médico</div>
        <div class="fgrid">
          <div class="field full"><label>Nome completo *</label><input type="text" id="f_name" required placeholder="Dr. João da Silva"></div>
          <div class="field"><label>Especialidade *</label><input type="text" id="f_specialty" required list="specList" placeholder="Ex: Ginecologista">
            <datalist id="specList">
              <option>Cardiologista</option><option>Dermatologista</option><option>Gastroenterologista</option>
              <option>Geriatra</option><option>Ginecologista</option><option>Neurologista</option>
              <option>Neurologista Pediátrica</option><option>Oftalmologista</option><option>Ortopedista</option>
              <option>Otorrinolaringologista</option><option>Pediatra</option><option>Psiquiatra</option>
              <option>Pneumologista</option><option>Reumatologista</option><option>Urologista</option>
              <option>Endocrinologista</option><option>Cirurgião</option><option>Cirurgião Vascular</option>
            </datalist>
          </div>
          <div class="field"><label>Clínica / Local</label><input type="text" id="f_clinic" placeholder="Ex: Diamond Center"></div>
          <div class="field full"><label>Endereço (para rota)</label><input type="text" id="f_address" placeholder="Rua, nº, sala — Bairro"></div>
        </div>
      </div>

      <!-- ── BLOCO 2: CONTATO ── -->
      <div style="background:var(--surface2);border-radius:8px;padding:12px;margin-bottom:10px">
        <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--accent);margin-bottom:10px">📞 Contato</div>
        <div class="fgrid">
          <div class="field"><label>Telefone / WhatsApp</label><input type="text" id="f_phone1" placeholder="(86) 99999-9999"></div>
          <div class="field"><label>Telefone 2</label><input type="text" id="f_phone2" placeholder="(86) 99999-9999"></div>
          <div class="field" style="border:1px solid rgba(108,99,255,.3);border-radius:8px;padding:8px;background:rgba(108,99,255,.05)">
            <label style="color:var(--accent)">👤 Secretária — nome *</label>
            <input type="text" id="f_secretary" placeholder="Nome de quem abre a porta">
          </div>
          <div class="field"><label>Observação da secretária</label>
            <input type="text" id="f_secretaryNotes" placeholder="Ex: Melhor ligar antes das 9h">
          </div>
        </div>
      </div>

      <!-- ── BLOCO 3: VISITA ── -->
      <div style="background:var(--surface2);border-radius:8px;padding:12px;margin-bottom:10px">
        <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--accent);margin-bottom:10px">🗓️ Visita</div>
        <div class="fgrid">
          <div class="field"><label>Horário de chegada</label><input type="text" id="f_arrive" placeholder="Ex: 8:00"></div>
          <div class="field"><label>Janela de atendimento</label><input type="text" id="f_window" placeholder="Ex: 7:30–12:00"></div>
          <div class="field full">
            <label>Dias que atende representantes</label>
            <div class="day-chips-sel" id="dayChipsSel">
              <label class="day-chip-lbl" onclick="toggleDayChip(this)"><input type="checkbox" value="Segunda">Seg</label>
              <label class="day-chip-lbl" onclick="toggleDayChip(this)"><input type="checkbox" value="Terça">Ter</label>
              <label class="day-chip-lbl" onclick="toggleDayChip(this)"><input type="checkbox" value="Quarta">Qua</label>
              <label class="day-chip-lbl" onclick="toggleDayChip(this)"><input type="checkbox" value="Quinta">Qui</label>
              <label class="day-chip-lbl" onclick="toggleDayChip(this)"><input type="checkbox" value="Sexta">Sex</label>
              <label class="day-chip-lbl" onclick="toggleDayChip(this)"><input type="checkbox" value="Sábado">Sáb</label>
            </div>
          </div>
          <div class="field full"><label>⚠️ Alerta / Dica de campo</label><input type="text" id="f_alert" placeholder="Ex: Chegar 20 min antes · Só 3 representantes"></div>
        </div>
      </div>

      <!-- ── BLOCO 4: STATUS + FOLLOW-UP ── -->
      <div style="background:var(--surface2);border-radius:8px;padding:12px;margin-bottom:10px">
        <div style="font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--accent);margin-bottom:10px">📊 Status</div>
        <div class="fgrid">
          <div class="field"><label>Situação atual</label>
            <select id="f_status">
              <option value="Pendente" selected>📍 Não visitado ainda</option>
              <option value="Visitado">👋 Visitado</option>
              <option value="Interessado">🔥 Demonstrou interesse</option>
              <option value="Proposta">📄 Proposta enviada</option>
              <option value="Fechado">✅ Fechou — cliente</option>
              <option value="Perdido">❌ Não aceitou</option>
            </select>
          </div>
          <div class="field"><label>🔔 Follow-up — quando ligar</label><input type="date" id="f_followUpDate"></div>
          <div class="field full"><label>Motivo do follow-up</label>
            <input type="text" id="f_followUpReason" placeholder="Ex: Retornar com proposta · Perguntar se pensou">
          </div>
          <div class="field full"><label>📝 Notas (livre)</label>
            <textarea id="f_notes" placeholder="O que aconteceu, o que ficou combinado..." style="min-height:60px"></textarea>
          </div>
        </div>
      </div>

      <!-- ── AVANÇADO (colapsável) ── -->
      <div class="full"><button type="button" class="more-toggle" onclick="toggleExtras(this)">▶ Informações avançadas (pacote, diagnóstico digital, perfil estratégico...)</button></div>
      <div class="extras full" id="formExtras">
        <div class="fgrid" style="margin-top:10px">

          <div style="grid-column:1/-1;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin-bottom:4px">💼 Proposta Comercial</div>
          <div class="field"><label>Pacote proposto</label>
            <select id="f_package">
              <option value="">— Nenhum —</option>
              <option value="Google Ads Pro">Google Ads Pro (R$ 1.200)</option>
              <option value="Meta Ads Pro">Meta Ads Pro (R$ 1.200)</option>
              <option value="YouTube Ads Pro">YouTube Ads Pro (R$ 2.500)</option>
              <option value="Combo Google+Meta">Combo Google+Meta (R$ 2.400)</option>
              <option value="Combo Completo">Combo Completo (R$ 4.900)</option>
              <option value="Personalizado">Personalizado</option>
            </select>
          </div>
          <div class="field"><label>Valor mensal (R$)</label><input type="number" id="f_value" step="100" min="0" placeholder="1200"></div>
          <div class="field"><label>Data de fechamento</label><input type="date" id="f_closedAt"></div>
          <div class="field"><label>Próximo objetivo de visita</label>
            <select id="f_nextObjective">
              <option value="">— Não definido —</option>
              <option value="mapear">🔍 Mapear (primeiro contato)</option>
              <option value="despertar">💡 Despertar (criar consciência)</option>
              <option value="agendar">📅 Agendar consultoria</option>
              <option value="fechar">💼 Apresentar / Fechar</option>
              <option value="manter">🤝 Manter (cliente ativo)</option>
            </select>
          </div>
          <div class="field"><label>Ciclo de follow-up</label>
            <select id="f_followUpCycle">
              <option value="">— Sem ciclo fixo —</option>
              <option value="7">A cada 7 dias</option>
              <option value="15">A cada 15 dias</option>
              <option value="30">A cada 30 dias</option>
              <option value="60">A cada 60 dias</option>
            </select>
          </div>

          <div style="grid-column:1/-1;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin:10px 0 4px">🌐 Digital</div>
          <div class="field"><label>Posicionamento online</label>
            <select id="f_positioning">
              <option value="Sem">🎯 Sem — PRIORIDADE</option>
              <option value="Básico">Básico</option>
              <option value="Bom">Bom</option>
              <option value="Desconhecido" selected>Desconhecido</option>
            </select>
          </div>
          <div class="field"><label>Instagram</label><input type="text" id="f_instagram" placeholder="@drjoao"></div>
          <div class="field"><label>Tem Google Meu Negócio?</label>
            <select id="f_gmn"><option value="">Não informado</option><option value="Sim">Sim</option><option value="Não">Não</option></select>
          </div>
          <div class="field"><label>Site</label><input type="text" id="f_site" placeholder="drjoao.com.br"></div>
          <div class="field"><label>CRM Médico</label><input type="text" id="f_crm" placeholder="CRM-PI 12345"></div>
          <div class="field"><label>Score digital (1–10)</label><input type="number" id="f_diagScore" min="1" max="10" placeholder="Ex: 3"></div>
          <div class="field full"><label>Pontos críticos de diagnóstico</label>
            <textarea id="f_diagNotes" placeholder="Ex: Não aparece no Google · GMN sem avaliações · Instagram parado" style="min-height:60px"></textarea>
          </div>

          <div style="grid-column:1/-1;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;color:var(--muted);margin:10px 0 4px">🧠 Perfil Estratégico</div>
          <div class="field"><label>Secretária — canal preferido</label>
            <select id="f_secretaryChannel">
              <option value="">— Não informado —</option>
              <option value="presencial">🚶 Presencial</option>
              <option value="whatsapp">💬 WhatsApp</option>
              <option value="ligação">📞 Ligação</option>
            </select>
          </div>
          <div class="field"><label>Receptividade da secretária</label>
            <select id="f_secretaryReceptivity">
              <option value="">—</option>
              <option value="1">1 — Muito fria / bloqueia</option>
              <option value="2">2 — Fria / indiferente</option>
              <option value="3">3 — Neutra</option>
              <option value="4">4 — Receptiva</option>
              <option value="5">5 — Aliada / já me ajuda</option>
            </select>
          </div>
          <div class="field"><label>Personalidade do médico</label>
            <select id="f_personality">
              <option value="">— Não avaliado —</option>
              <option value="direto">⚡ Direto — quer resultado rápido</option>
              <option value="detalhista">🔬 Detalhista — precisa de dados</option>
              <option value="cético">🧱 Cético — precisa de prova social</option>
              <option value="aberto">😊 Aberto — receptivo</option>
            </select>
          </div>
          <div class="field"><label>Principal dor</label>
            <select id="f_motivation">
              <option value="">— Não identificado —</option>
              <option value="mais pacientes">🏥 Mais pacientes particulares</option>
              <option value="menos plano">💳 Menos dependência de plano</option>
              <option value="autoridade">🏆 Autoridade online</option>
              <option value="diferenciação">🌟 Diferenciação</option>
            </select>
          </div>
          <div class="field"><label>Quem decide</label>
            <select id="f_decisionMaker">
              <option value="só médico">👨‍⚕️ Só o médico</option>
              <option value="cônjuge">💑 Médico + cônjuge</option>
              <option value="sócio">🤝 Médico + sócio</option>
            </select>
          </div>
          <div class="field"><label>Indicado por</label>
            <input type="text" id="f_referredBy" placeholder="Ex: Dr. Marconi">
          </div>
          <div class="field full"><label style="display:flex;align-items:center;gap:8px">
            <input type="checkbox" id="f_hasExclusivity" style="width:auto">
            <span>✅ Exclusividade concedida nesta especialidade/região</span>
          </label></div>
        </div>
      </div>

      <div class="modal-foot">
        <button type="button" class="btn btn-ghost" onclick="closeForm()">Cancelar</button>
        <button type="submit" class="btn btn-primary">Salvar</button>
      </div>
    </form>
  </div>
</div>

<!-- ========== IMPORT MODAL ========== -->
<div class="overlay hidden" id="importOverlay">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-title">⬆ Importar Planilha</div>
      <button class="modal-close" onclick="closeImport()">×</button>
    </div>
    <div class="steps">
      <div class="step active" id="st1">1. Arquivo</div>
      <div class="step" id="st2">2. Colunas</div>
      <div class="step" id="st3">3. Revisar</div>
    </div>
    <div id="istep1">
      <div class="drop" id="dropZone" onclick="document.getElementById('fileInp').click()" ondragover="dOver(event)" ondragleave="dLeave(event)" ondrop="dDrop(event)">
        <div style="font-size:40px">📊</div>
        <div style="font-size:15px;font-weight:700;margin:8px 0 4px" id="dropTxt">Arraste sua planilha aqui</div>
        <div style="font-size:12px;color:var(--muted)">Suporte: .xlsx, .xls, .csv — clique para selecionar</div>
        <input type="file" id="fileInp" accept=".xlsx,.xls,.csv" onchange="hFile(event)">
      </div>
      <div style="margin-top:14px;padding:11px 14px;background:var(--surface2);border-radius:8px;font-size:12px;color:var(--muted);line-height:1.6">
        <strong style="color:var(--text)">Colunas reconhecidas automaticamente:</strong> nome, médico, especialidade, telefone, contato (secretária), endereço, clínica, horário, dia, status, posicionamento, instagram, etc.
      </div>
    </div>
    <div id="istep2" class="hidden">
      <div style="font-size:13px;color:var(--muted);margin-bottom:12px">Confirme o mapeamento de cada coluna:</div>
      <div id="mapRows"></div>
    </div>
    <div id="istep3" class="hidden">
      <div class="sum" id="impSum"></div>
      <div class="preview"><table id="prevTbl"></table></div>
      <div style="margin-top:10px;font-size:11px;color:var(--muted)">
        <span style="color:var(--green)">■</span> Pronto · <span style="color:var(--yellow)">■</span> Incompleto (importa) · <span style="color:var(--red)">■</span> Duplicado (ignora)
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeImport()">Cancelar</button>
      <button class="btn btn-ghost hidden" id="impBack" onclick="impPrev()">← Voltar</button>
      <button class="btn btn-primary" id="impNext" onclick="impNext()" disabled>Próximo →</button>
      <button class="btn btn-primary hidden" id="impDone" onclick="impConfirm()">✅ Importar</button>
    </div>
  </div>
</div>

<!-- ========== VISIT LOG MODAL ========== -->
<div class="overlay hidden" id="visitLogOverlay">
  <div class="modal" style="max-width:620px">
    <div class="modal-head">
      <div class="modal-title" id="visitLogTitle">📝 Registrar Visita</div>
      <button class="modal-close" onclick="closeVisitLog()">×</button>
    </div>
    <div id="visitLogDoctorInfo" style="background:var(--surface2);border-radius:8px;padding:10px 12px;margin-bottom:14px;font-size:13px"></div>
    <div class="log-grid">
      <div class="field"><label>📅 Data</label><input type="date" id="vl_date"></div>
      <div class="field"><label>📡 Canal</label>
        <select id="vl_channel">
          <option value="presencial">🚶 Presencial</option>
          <option value="ligação">📞 Ligação</option>
          <option value="whatsapp">💬 WhatsApp</option>
        </select>
      </div>
      <div class="field full"><label>⏱ Duração do contato</label>
        <div class="radio-group" id="vl_duration_group">
          <label class="radio-btn selected" data-val="relâmpago" onclick="selectRadio('vl_duration_group',this)"><input type="radio" name="vl_dur" value="relâmpago">⚡ Relâmpago (até 3 min)</label>
          <label class="radio-btn" data-val="curta" onclick="selectRadio('vl_duration_group',this)"><input type="radio" name="vl_dur" value="curta">🕐 Curta (até 10 min)</label>
          <label class="radio-btn" data-val="longa" onclick="selectRadio('vl_duration_group',this)"><input type="radio" name="vl_dur" value="longa">🕐 Longa (acima de 10 min)</label>
        </div>
      </div>
      <div class="field full"><label>🌡️ Temperatura — como foi a receptividade?</label>
        <div class="radio-group" id="vl_temp_group">
          <label class="radio-btn frio" data-val="frio" onclick="selectRadio('vl_temp_group',this)"><input type="radio" name="vl_temp" value="frio">❄️ Frio — fechado</label>
          <label class="radio-btn morno selected" data-val="morno" onclick="selectRadio('vl_temp_group',this)"><input type="radio" name="vl_temp" value="morno">🌤️ Morno — neutro</label>
          <label class="radio-btn quente" data-val="quente" onclick="selectRadio('vl_temp_group',this)"><input type="radio" name="vl_temp" value="quente">🔥 Quente — aberto</label>
        </div>
      </div>
      <div class="field full"><label>🎯 Objetivo desta visita</label>
        <div class="radio-group" id="vl_obj_group">
          <label class="radio-btn" data-val="mapear" onclick="selectRadio('vl_obj_group',this)">🔍 Mapear</label>
          <label class="radio-btn selected" data-val="despertar" onclick="selectRadio('vl_obj_group',this)">💡 Despertar</label>
          <label class="radio-btn" data-val="agendar" onclick="selectRadio('vl_obj_group',this)">📅 Agendar</label>
          <label class="radio-btn" data-val="fechar" onclick="selectRadio('vl_obj_group',this)">💼 Fechar</label>
          <label class="radio-btn" data-val="manter" onclick="selectRadio('vl_obj_group',this)">🤝 Manter</label>
        </div>
      </div>
      <div class="field full"><label style="display:flex;align-items:center;gap:8px">
        <input type="checkbox" id="vl_achieved" style="width:auto;accent-color:var(--green)">
        <span>Objetivo desta visita foi alcançado</span>
      </label></div>
      <div class="field full"><label>📋 O que aconteceu (como foi recebido, o que foi dito)</label>
        <textarea id="vl_what" placeholder="Ex: Médica recebeu bem, teve 5 min de conversa. Mostrei o diagnóstico digital. Demonstrou interesse no Google, mas disse que estava ocupada esta semana..." style="min-height:80px"></textarea>
      </div>
      <div class="field"><label>🧱 Objeção levantada</label>
        <input type="text" id="vl_objection" placeholder="Ex: 'Já tentei marketing antes e não funcionou'">
      </div>
      <div class="field"><label>🤝 O que foi acordado / prometido</label>
        <input type="text" id="vl_agreed" placeholder="Ex: Vou mandar vídeo de 8 min por WhatsApp">
      </div>
      <div class="field full"><label>🎯 Próximo objetivo (para a próxima visita/contato)</label>
        <select id="vl_nextObj">
          <option value="mapear">🔍 Mapear</option>
          <option value="despertar">💡 Despertar</option>
          <option value="agendar" selected>📅 Agendar consultoria</option>
          <option value="fechar">💼 Fechar proposta</option>
          <option value="manter">🤝 Manter presença</option>
        </select>
      </div>
      <div class="field full"><label>📆 Data sugerida para próximo contato</label>
        <input type="date" id="vl_nextDate">
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeVisitLog()">Cancelar</button>
      <button class="btn btn-primary" onclick="saveVisitLog()">💾 Salvar Registro</button>
    </div>
  </div>
</div>

<!-- ========== VISIT HISTORY MODAL ========== -->
<div class="overlay hidden" id="historyOverlay">
  <div class="modal" style="max-width:640px">
    <div class="modal-head">
      <div class="modal-title" id="historyTitle">📋 Histórico de Visitas</div>
      <button class="modal-close" onclick="closeHistory()">×</button>
    </div>
    <div id="historyDoctorInfo" style="background:var(--surface2);border-radius:8px;padding:10px 12px;margin-bottom:14px;font-size:13px"></div>
    <div id="historyBody" class="timeline"></div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeHistory()">Fechar</button>
      <button class="btn btn-primary" id="historyLogBtn" onclick="">📝 Nova Visita</button>
    </div>
  </div>
</div>

<!-- ========== BULK ACTION BAR ========== -->
<div class="bulk-bar bulk-hidden" id="bulkBar">
  <span class="bulk-count" id="bulkCount">0 selecionados</span>
  <select id="bulkMoveSelect" style="padding:5px 10px;font-size:12px;border-radius:7px;background:var(--surface);color:var(--text);border:1px solid var(--border);cursor:pointer">
    <option value="">↪ Mover para...</option>
    <option value="Pendente">📍 Pendente</option>
    <option value="Visitado">👋 Visitado</option>
    <option value="Interessado">🔥 Interessado</option>
    <option value="Proposta">📄 Proposta</option>
    <option value="Fechado">✅ Fechado</option>
    <option value="Perdido">❌ Perdido</option>
  </select>
  <button class="btn btn-sm btn-primary" onclick="bulkMove()">Mover</button>
  <button class="btn btn-sm btn-danger" onclick="bulkDelete()">🗑️ Apagar</button>
  <button class="btn btn-sm btn-ghost" onclick="clearSelection()">✕ Limpar</button>
</div>

<!-- ========== NOTION EXPORT MODAL ========== -->
<div class="overlay hidden" id="notionOverlay">
  <div class="modal" style="max-width:760px">
    <div class="modal-head">
      <div class="modal-title">📋 Exportar para Notion</div>
      <button class="modal-close" onclick="closeNotion()">×</button>
    </div>
    <div style="font-size:13px;color:var(--muted);margin-bottom:12px">
      Copie o conteúdo abaixo e cole direto no Notion. Funciona como tabela ou lista.
    </div>
    <div class="notion-tabs">
      <div class="notion-tab active" data-fmt="md" onclick="switchNotionFmt('md')">📝 Markdown (lista)</div>
      <div class="notion-tab" data-fmt="table" onclick="switchNotionFmt('table')">📊 Markdown (tabela)</div>
      <div class="notion-tab" data-fmt="csv" onclick="switchNotionFmt('csv')">📄 CSV (importar)</div>
    </div>
    <div style="display:flex;gap:8px;margin-bottom:10px;align-items:center;flex-wrap:wrap">
      <select class="filter" id="notionFilter" onchange="renderNotionContent()">
        <option value="all">Todos os médicos</option>
        <option value="Pendente">Apenas Pendentes</option>
        <option value="Interessado">Apenas Interessados</option>
        <option value="Proposta">Apenas com Proposta</option>
        <option value="Fechado">Apenas Fechados</option>
      </select>
      <button class="btn btn-sm btn-green" onclick="copyNotion()">📋 Copiar tudo</button>
      <a class="btn btn-sm btn-ghost" href="https://www.notion.so/" target="_blank">↗ Abrir Notion</a>
    </div>
    <div class="copy-box" id="notionContent"></div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeNotion()">Fechar</button>
    </div>
  </div>
</div>

<!-- ========== MAPS SEARCH MODAL ========== -->
<div class="overlay hidden" id="mapsSearchOverlay">
  <div class="modal" style="max-width:520px">
    <div class="modal-head">
      <div class="modal-title">🔍 Buscar Médicos no Google Maps</div>
      <button class="modal-close" onclick="closeMapsSearch()">×</button>
    </div>
    <div style="font-size:13px;color:var(--muted);margin-bottom:14px">
      Monte uma busca no Maps com especialidade + cidade. Vai abrir em nova aba — depois copie os resultados e use "Colar do Maps".
    </div>
    <div class="fgrid">
      <div class="field"><label>Especialidade</label>
        <input type="text" id="mapsSpec" list="specList" placeholder="Ex: Ginecologista" value="Ginecologista">
      </div>
      <div class="field"><label>Cidade</label>
        <input type="text" id="mapsCity" placeholder="Ex: Teresina PI" value="Teresina PI">
      </div>
      <div class="field full"><label>Bairro / Filtro extra (opcional)</label>
        <input type="text" id="mapsExtra" placeholder="Ex: Fátima OR Jóquei">
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeMapsSearch()">Cancelar</button>
      <button class="btn btn-primary" onclick="doMapsSearch()">🔍 Abrir no Maps</button>
    </div>
  </div>
</div>

<!-- ========== MAPS PASTE MODAL ========== -->
<div class="overlay hidden" id="mapsPasteOverlay">
  <div class="modal" style="max-width:680px">
    <div class="modal-head">
      <div class="modal-title">📋 Colar do Google Maps</div>
      <button class="modal-close" onclick="closeMapsPaste()">×</button>
    </div>
    <div style="font-size:13px;color:var(--muted);margin-bottom:10px">
      No Maps, clique em um estabelecimento, copie o painel lateral (nome, endereço, telefone) e cole abaixo. O app extrai automaticamente.
    </div>
    <textarea class="maps-textarea" id="mapsPasteText" placeholder="Cole aqui o texto copiado do Google Maps...&#10;&#10;Ex:&#10;Dra. Maria Silva&#10;Ginecologista&#10;Av. Brasil, 1234 - Centro&#10;(86) 99999-9999"></textarea>
    <button class="btn btn-sm btn-primary" style="margin-top:10px" onclick="parseMapsPaste()">🪄 Analisar texto</button>
    <div id="mapsParseResult"></div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeMapsPaste()">Cancelar</button>
      <button class="btn btn-green hidden" id="mapsAddBtn" onclick="addMapsParsed()">+ Adicionar Médico</button>
    </div>
  </div>
</div>

<!-- ========== ROUTE MODAL ========== -->
<div class="overlay hidden" id="routeOverlay">
  <div class="modal" style="max-width:520px">
    <div class="modal-head">
      <div class="modal-title">🗺️ Rota Otimizada</div>
      <button class="modal-close" onclick="closeRoute()">×</button>
    </div>
    <div id="routeBody"></div>
    <div class="modal-foot">
      <button class="btn btn-ghost" onclick="closeRoute()">Fechar</button>
      <button class="btn btn-green" onclick="openGMaps()">📍 Abrir no Google Maps</button>
    </div>
  </div>
</div>

<script>
// =============================================================
